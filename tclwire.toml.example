# TclWire configuration draft
#
# Proposed precedence, from highest to lowest:
#   1. command-line options
#   2. values in this file
#   3. runtime defaults
#
# A protocol is enabled when its table exists, unless enabled is false.
# A missing protocol table disables that protocol.  The CLI --startservers
# option overrides protocol selection, while the protocol-specific CLI port
# option overrides the port below.
#
# Configuration paths are resolved relative to the directory containing this
# file. Relative application "file" and application "chore" values are searched
# for under the run directory, the application's docroot, its effective libdir,
# and the TclWire installation.

[tclwire]
# Local address used by service listeners. Legacy "host" is still accepted.
bind_address = "127.0.0.1"

# Host header aliases served by the default application unless overridden by
# [http.default].hosts or [https.default].hosts.
default_hosts = "localhost 127.0.0.1"
quiet = false
debug = false
debug_connection = false
encoding = "utf-8"
docroot = "/tmp/tclwire"
ftproot = "/tmp/tclwire"
ftp_user_check = true
logfile = "/tmp/tclwire.log"
logerr = "/tmp/tclwire-err.log"
log_level = "info"
unix_socket = "/tmp/tclwire.sock"
conn_max_wait = 1000
conn_max_workers = 100
max_request_bytes = 16777216
max_header_bytes = 65536
request_memory_threshold = 1048576

# Optional global URL path aliases inherited by applications. Each nonblank
# line is either "URL-path local-path" or "Alias URL-path local-path".
# Relative local paths are resolved under the selected application's docroot.
# aliases = '''
# Alias /shared/ shared-files
# /downloads/ /srv/downloads
# '''

# When true, closed connection records remain in the shared accounting store
# and CONN includes close diagnostics.
# debug_connection = true

# Optional directory containing application class files. An application's
# libdir overrides this value. The application docroot still has precedence.
# libdir = "/opt/tclwire-apps"

# Optional server chore registered once for the TclWire runtime. Relative
# paths are searched under the run directory, configuration directory, global
# libdir when set, and the TclWire installation.
# chore = "examples/five_minute_chore.tcl"
# chore_class = "FiveMinuteLogChore"

# Empty values preserve the runtime's current TLS defaults. Set these when
# secure protocols should share one certificate and private key.
certfile = ""
keyfile = ""

# This application is selected when an HTTP request has no Host header. Its
# descriptor also provides defaults for every other host application.
default_application = "default"

# Environment configuration is intentionally separate from [tclwire]. Each
# [env.<name>] table is an environment-owned key/value dictionary. The only
# runtime-reserved key is "parent"; child environment configuration inherits
# the parent dictionary and overrides selected keys.
#
# [env.stdchans]
# capture_stderr = true
# auto_chunked_on_flush = true
#
# [env.rivet]
# parent = "stdchans"
# UploadMaxSize = 10485760
# BeforeScript = "rivet/before.tcl"
#
# Applications that list an environment carry the effective environment
# configuration into their content-generator workers. Application and
# environment code can read it through:
#   ::tclwire::app::environment_configuration ?environment? ?key?

[http]
enabled = true
port = 8990
log_level = "info"

# Optional default for applications configured under this service. This
# overrides [tclwire].libdir and is overridden by an application's libdir.
# libdir = "/opt/tclwire-apps/http"

# The final table component is the application ID and, when "hosts" is
# omitted, its hostname. Application IDs containing dots must be quoted so
# TOML treats the DNS name as one key instead of nested subtables, for example:
# [http."www.example.test"]
[http.default]
# The bundled parser currently mishandles TOML arrays.  Until it is repaired,
# encode host aliases as a Tcl list in one string.
# Omit this to use [tclwire].default_hosts.
# hosts = "localhost 127.0.0.1"
class = "::tclwire::CApplication"

# "file" is the application entry point. Loading it should define the TclOO
# class named by "class". Relative paths are searched for in this order:
# run directory, application docroot, effective libdir, TclWire installation
# directory.
file = "tcl/application.tcl"

# Optional scheduler chore for this application. Loading it must define a
# concrete TclOO class inheriting from ::tclwire::ApplicationChore when it
# needs application_id, application_config, or pool_key. If the file defines
# exactly one new chore subclass, the scheduler registers that class
# automatically; otherwise set chore_class explicitly. Application chores are
# not inherited from the default application into virtual hosts.
# chore = "application-maintenance-chore.tcl"
# chore_class = "ApplicationMaintenanceChore"

# Optional per-application override for [tclwire].libdir.
# libdir = "/opt/tclwire-apps/default"

# Load stdchans when an application writes its response body with ordinary
# standard-channel commands such as "puts" or "flush stdout" instead of calling
# TclWire's response API directly. This is useful for porting classic CGI-style
# Tcl applications or scripts that expect stdout to become the HTTP
# response body.
#
# Application environments are optional and are loaded before application
# instances are created in each content-generator worker.
# environment = "stdchans"
# environment = "stdchans otherenv"

# When "file" is absent, the worker loads "package" with package require.
# Before loading it, the worker places the application's docroot, effective
# libdir, and the TclWire installation directory at the front of auto_path, in
# that order.
package = "tclwire::application"
docroot = "/tmp/tclwire"
encoding = "utf-8"
minimum_workers = 0
maximum_workers = 20

# Optional per-host/application error-log threshold. Supported levels, from
# least to most severe: trace8 through trace1, debug, info, notice, warn,
# error, crit, alert, emerg.
# log_level = "debug"

# Optional application aliases are searched before inherited aliases, so they
# can override or extend [tclwire].aliases and [http.default].aliases.
# aliases = '''
# /assets/ public/assets
# '''

# A virtual host can override only what differs from the default application.
#
# [http."example.test"]
# hosts = "example.test www.example.test"
# docroot = "applications/example/public"
#
# class, file/package, encoding, libdir, and worker limits are inherited from
# [http.default]. Any of them may still be overridden in the host table.
#
# Direct settings under configure apply to the resolved application class.
# Class-specific child tables can still target another TclOO class, or make
# the target explicit. Bare class names are qualified under ::tclwire::app.
# Constructors decide how those values map to object state.
#
# ::tclwire::CApplication uses directory_index as the ordered list of default
# page file names for directory URLs. The built-in default is "index.html".
# directory_index = "index.html home.html"
#
[http.hello]
hosts = "<my-hello-app>"
class = "Hello"
file = "examples/hello.tcl"
docroot = "/tmp/tclwire"

[http.hello.configure]
message = "Hello from a configured virtual host"

# [http.hello.configure.Hello]
# message = "Override the direct configure value for Hello"

[https]
enabled = false
port = 9443

# libdir = "/opt/tclwire-apps/https"

# These override the global TLS defaults in [tclwire].
certfile = ""
keyfile = ""

# HTTPS applications have the same schema as HTTP applications.  Defining
# them separately permits HTTPS-only virtual hosts.  If no application tables
# are present here, the proposed behavior is to reuse the [http] applications.
#
# [https.secure_example]
# hosts: secure.example.test
# class: ::example::SecureApplication
# file: applications/example/secure_application.tcl
# package: example::secure_application
# docroot: applications/example/private
# encoding: utf-8
# minimum_workers = 1
# maximum_workers = 20

[ftp]
enabled = false
port = 8991
root = "/tmp/tclwire"
user_check = true

[ftps]
enabled = false
port = 8992
root = "/tmp/tclwire"
user_check = true
certfile = ""
keyfile = ""

[proxy]
enabled = false
port = 8993
