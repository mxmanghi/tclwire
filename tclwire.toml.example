# TclWire configuration draft
#
# Proposed precedence, from highest to lowest:
#   1. command-line options
#   2. values in this file
#   3. runtime defaults
#
# A protocol is enabled when its table exists, unless enabled is false.
# A missing protocol table disables that protocol.  The CLI --startservers
# option overrides protocol selection, while the protocol-specific CLI port
# option overrides the port below.
#
# Configuration paths are resolved relative to the directory containing this
# file. Relative application "file" values are searched for under the
# application's docroot, its effective libdir, and the TclWire installation.

[tclwire]
host = "127.0.0.1"
quiet = false
debug = false
encoding = "utf-8"
docroot = "/tmp/tclwire"
ftproot = "/tmp/tclwire"
ftp_user_check = true
logfile = "/tmp/tclwire.log"

# Optional directory containing application class files. An application's
# libdir overrides this value. The application docroot still has precedence.
# libdir = "/opt/tclwire-apps"

# Empty values preserve the runtime's current TLS defaults. Set these when
# secure protocols should share one certificate and private key.
certfile = ""
keyfile = ""

# This application is selected when an HTTP request has no Host header. Its
# descriptor also provides defaults for every other host application.
default_application = "default"

[http]
enabled = true
port = 8990

# Optional default for applications configured under this service. This
# overrides [tclwire].libdir and is overridden by an application's libdir.
# libdir = "/opt/tclwire-apps/http"

# The final table component is the application ID and, when "hosts" is
# omitted, its hostname. Quote DNS names containing dots, for example:
# [http."www.example.test"]
[http.default]
# The bundled parser currently mishandles TOML arrays.  Until it is repaired,
# encode host aliases as a Tcl list in one string.
hosts = "localhost 127.0.0.1"
class = "::tclwire::CApplication"

# "file" is the application entry point. Loading it should define the TclOO
# class named by "class". Relative paths are searched for in this order:
# application docroot, effective libdir, TclWire installation directory.
file = "tcl/application.tcl"

# Optional per-application override for [tclwire].libdir.
# libdir = "/opt/tclwire-apps/default"

# When "file" is absent, the worker loads "package" with package require.
# Before loading it, the worker places the application's docroot, effective
# libdir, and the TclWire installation directory at the front of auto_path, in
# that order.
package = "tclwire::application"

docroot = "/tmp/tclwire"
encoding = "utf-8"
minimum_workers = 0
maximum_workers = 20

# A virtual host can override only what differs from the default application.
#
# [http."example.test"]
# hosts = "example.test www.example.test"
# docroot = "applications/example/public"
#
# class, file/package, encoding, libdir, and worker limits are inherited from
# [http.default]. Any of them may still be overridden in the host table.

[https]
enabled = false
port = 9443

# libdir = "/opt/tclwire-apps/https"

# These override the global TLS defaults in [tclwire].
certfile = ""
keyfile = ""

# HTTPS applications have the same schema as HTTP applications.  Defining
# them separately permits HTTPS-only virtual hosts.  If no application tables
# are present here, the proposed behavior is to reuse the [http] applications.
#
# [https.secure_example]
# hosts: secure.example.test
# class: ::example::SecureApplication
# file: applications/example/secure_application.tcl
# package: example::secure_application
# docroot: applications/example/private
# encoding: utf-8
# minimum_workers = 1
# maximum_workers = 20

[ftp]
enabled = false
port = 8991
root = "/tmp/tclwire"
user_check = true

[ftps]
enabled = false
port = 990
root = "/tmp/tclwire"
user_check = true
certfile = ""
keyfile = ""

[proxy]
enabled = false
port = 8992
