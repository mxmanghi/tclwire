test http-connection-1.8 {custom document roots preserve UTF-8 content} -body {
    set docroot [file join [temporaryDirectory] tclwire-docroot-[pid]]
    set expected "Caff\u00e8 \u2014 \u6771\u4eac"
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot index.html] $expected

    ::tclwire::runtime start [list \
        --docroot $docroot \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]

    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 $separator-1]
    set body_bytes [string range $response $separator+4 end]
    list \
        [regexp {Content-Length: 17} $headers] \
        [expr {[encoding convertfrom utf-8 $body_bytes] eq $expected}]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    catch {file delete -force $docroot}
} -result {1 1}

test http-connection-1.9 {static binary files are preserved byte for byte} -body {
    set docroot [file join [temporaryDirectory] tclwire-docroot-[pid]]
    file mkdir [file join $docroot assets]
    set expected [binary format H* 0001027f80feff89504e470d0a]
    ::fileutil::writeFile -translation binary \
        [file join $docroot assets sample.bin] $expected

    ::tclwire::runtime start [list \
        --docroot $docroot \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET /assets/sample.bin HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]

    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 $separator-1]
    set body_bytes [string range $response $separator+4 end]
    list \
        [string match "HTTP/1.1 200 OK*" $headers] \
        [regexp -nocase \
            {Content-Type: application/octet-stream} $headers] \
        [regexp "Content-Length: [string length $expected]" $headers] \
        [expr {$body_bytes eq $expected}]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    catch {file delete -force $docroot}
} -result {1 1 1 1}

test http-connection-1.10 {malformed chunked requests receive a protocol error} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\ninvalid\r\n"]
    string match "HTTP/1.1 400 Bad Request*" $response
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result 1

test http-connection-1.11 {gzip chunked requests reach the application} -body {
    set compressed [zlib gzip "request body"]
    set request \
        "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"
    append request [format "%X\r\n" [string length $compressed]]
    append request $compressed "\r\n0\r\n\r\n"

    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request $request]
    string match "HTTP/1.1 200 OK*" $response
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result 1

test http-connection-1.11a {
    spooled multipart requests expose the same application interface
} -setup {
    set upload_area [file join [temporaryDirectory] tclwire-spooled-upload-[pid]]
    file delete -force $upload_area
    set multipart_application [makeFile {
package require tclwire::application 0.1

oo::class create ::tclwire::http_connection_test::MultipartApplication {
    superclass ::tclwire::CApplication

    method handle_request {request} {
        set file [$request uploaded_file upload]
        set channel [open [dict get $file body_path] rb]
        try {
            set file_body [read $channel]
        } finally {
            close $channel
        }
        ::tclwire::io response 200 OK \
            [list "Content-Type: text/plain; charset=utf-8"] text utf-8
        ::tclwire::io out [list \
            [$request body_media] \
            [$request body_storage] \
            [$request form_value field] \
            [dict get $file filename] \
            [dict get $file body_storage] \
            $file_body]
    }
}
} multipart-application.tcl]
    set multipart_config [makeFile [format {
[tclwire]
default_application = "localhost"
docroot = "%s"
logfile = "%s"

[http]
enabled = true
port = 8990
upload_area = "%s"
request_memory_threshold = 16

[http.localhost]
class = "::tclwire::http_connection_test::MultipartApplication"
file = "%s"
docroot = "%s"
encoding = "utf-8"
} $project_root \
   $::tclwire::http_connection_test::logfile \
   $upload_area \
   $multipart_application \
   $project_root] multipart-config.toml]
} -body {
    set boundary TclWireBoundary
    set body [binary format a* {}]
    append body "--$boundary\r\n"
    append body "Content-Disposition: form-data; name=\"field\"\r\n\r\n"
    append body "value\r\n"
    append body "--$boundary\r\n"
    append body "Content-Disposition: form-data; name=\"upload\"; filename=\"hello.txt\"\r\n"
    append body "Content-Type: text/plain\r\n\r\n"
    append body "hello from a spooled multipart request\r\n"
    append body "--$boundary--\r\n"

    ::tclwire::runtime start [list --config $multipart_config]
    set request "POST / HTTP/1.1\r\n"
    append request "Host: localhost\r\n"
    append request "Connection: close\r\n"
    append request "Content-Type: multipart/form-data; boundary=$boundary\r\n"
    append request "Content-Length: [string length $body]\r\n\r\n"
    append request $body
    set response [::tclwire::http_connection_test::request $request]
    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 $separator-1]
    set response_body [string range $response $separator+4 end]
    list \
        [string match "HTTP/1.1 200 OK*" $headers] \
        $response_body \
        [llength [glob -nocomplain -directory $upload_area *]]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    removeFile $multipart_config
    removeFile $multipart_application
    file delete -force $upload_area
} -result [list 1 \
    {multipart decomposed value hello.txt spooled_file {hello from a spooled multipart request}} \
    0]

test http-connection-1.12 {applications can stream chunked responses} -setup {
    set streaming_status [makeFile {} streaming-status.txt]
    set streaming_application [makeFile [format {
package require tclwire::application 0.1

oo::class create ::tclwire::http_connection_test::StreamingApplication {
    superclass ::tclwire::CApplication

    method handle_request {request_descriptor} {
        ::tclwire::io response 200 OK \
            [list "Content-Type: text/plain; charset=utf-8"] text utf-8
        ::tclwire::http::io header set Transfer-Encoding chunked
        ::tclwire::io out alpha
        ::tclwire::io flush
        ::tclwire::io out beta
        ::tclwire::io complete
        ::tclwire::io out ignored
        set account [::tclwire::accounting get_thread_account [::thread::id]]
        set channel [open %s w]
        puts $channel [dict get $account status]
        close $channel
    }
}
} [list $streaming_status]] streaming-application.tcl]
    set streaming_config [makeFile [format {
[tclwire]
default_application = "localhost"
docroot = "%s"
logfile = "%s"

[http]
enabled = true
port = 8990

[http.localhost]
class = "::tclwire::http_connection_test::StreamingApplication"
file = "%s"
docroot = "%s"
encoding = "utf-8"
} $project_root \
   $::tclwire::http_connection_test::logfile \
   $streaming_application \
   $project_root] streaming-config.toml]
} -body {
    ::tclwire::runtime start [list --config $streaming_config]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]
    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 $separator-1]
    set body [string range $response $separator+4 end]
    for {set attempt 0} {$attempt < 100 && [file size $streaming_status] == 0} \
            {incr attempt} {
        after 10
        update
    }
    list \
        [string match "HTTP/1.1 200 OK*" $headers] \
        [regexp -nocase {Transfer-Encoding: chunked} $headers] \
        [expr {![regexp -nocase {Content-Length:} $headers]}] \
        [binary encode hex $body] \
        [string trim [::fileutil::cat $streaming_status]]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    removeFile $streaming_config
    removeFile $streaming_application
    removeFile $streaming_status
} -result {1 1 1 350d0a616c7068610d0a340d0a626574610d0a300d0a0d0a running}

