test http-connection-1.13a {
    package-backed applications are loaded from their document root
} -setup {
    set package_docroot [file join \
        [temporaryDirectory] tclwire-package-docroot-[pid]]
    set package_libdir [file join \
        [temporaryDirectory] tclwire-package-libdir-[pid]]
    file mkdir $package_docroot
    file mkdir $package_libdir
    ::fileutil::writeFile [file join $package_docroot package_application.tcl] {
package require TclOO

oo::class create ::example::PackageApplication {
    constructor {descriptor} {}
    method handle_request {request} {
        ::tclwire::io response 200 OK \
            [list "Content-Type: text/plain; charset=utf-8"] text utf-8
        ::tclwire::io out package-docroot-ok
    }
}

package provide example::package_application 0.1
}
    ::fileutil::writeFile [file join $package_docroot pkgIndex.tcl] {
package ifneeded example::package_application 0.1 \
    [list source [file join $dir package_application.tcl]]
}
    ::fileutil::writeFile [file join $package_libdir package_application.tcl] {
error "application package was loaded from libdir instead of docroot"
}
    ::fileutil::writeFile [file join $package_libdir pkgIndex.tcl] {
package ifneeded example::package_application 0.1 \
    [list source [file join $dir package_application.tcl]]
}
    set package_config [makeFile [format {
[tclwire]
default_application = "package.example.test"
docroot = "%s"
logfile = "%s"

[http]
enabled = true
port = 8990

[http."package.example.test"]
class = "::example::PackageApplication"
package = "example::package_application"
docroot = "%s"
libdir = "%s"
encoding = "utf-8"
} $package_docroot \
   $::tclwire::http_connection_test::logfile \
   $package_docroot \
   $package_libdir] package-application-config.toml]
} -body {
    ::tclwire::runtime start [list --config $package_config]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.1\r\nHost: package.example.test\r\nConnection: close\r\n\r\n"]
    list \
        [string match "HTTP/1.1 200 OK*" $response] \
        [string match "*package-docroot-ok" $response]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    removeFile $package_config
    file delete -force $package_docroot
    file delete -force $package_libdir
} -result {1 1}

test http-connection-1.14 {HEAD returns GET metadata without representation bytes} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set get_response [::tclwire::http_connection_test::request \
        "GET /index.html HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]
    set head_response [::tclwire::http_connection_test::request \
        "HEAD /index.html HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]
    set error_response [::tclwire::http_connection_test::request \
        "HEAD /missing HTTP/1.1\r\nHost: unknown.example\r\nConnection: close\r\n\r\n"]

    set get_separator [string first "\r\n\r\n" $get_response]
    set head_separator [string first "\r\n\r\n" $head_response]
    set error_separator [string first "\r\n\r\n" $error_response]
    set get_headers [string range $get_response 0 $get_separator-1]
    set head_headers [string range $head_response 0 $head_separator-1]
    set error_headers [string range $error_response 0 \
        $error_separator-1]
    set head_body [string range $head_response $head_separator+4 end]
    set error_body [string range $error_response \
        $error_separator+4 end]
    regexp -nocase {Content-Length:\s*([0-9]+)} \
        $get_headers -> get_length
    regexp -nocase {Content-Length:\s*([0-9]+)} \
        $head_headers -> head_length
    list \
        [string match "HTTP/1.1 200 OK*" $head_headers] \
        [expr {$get_length == $head_length}] \
        [regexp -nocase {Accept-Ranges: bytes} $head_headers] \
        [string length $head_body] \
        [string match "HTTP/1.1 404 Not Found*" $error_headers] \
        [string length $error_body]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {1 1 1 0 1 0}

test http-connection-1.15 {static files support single byte ranges} -setup {
    set range_root [file join [temporaryDirectory] tclwire-range-[pid]]
    file mkdir $range_root
    ::fileutil::writeFile -translation binary \
        [file join $range_root range.bin] 0123456789
} -body {
    ::tclwire::runtime start [list \
        --docroot $range_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET /range.bin HTTP/1.1\r\nHost: localhost\r\nRange: bytes=2-5\r\nConnection: close\r\n\r\n"]
    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 $separator-1]
    set body [string range $response $separator+4 end]
    list \
        [string match "HTTP/1.1 206 Partial Content*" $headers] \
        [regexp -nocase {Content-Range: bytes 2-5/10} $headers] \
        [regexp -nocase {Content-Length: 4} $headers] \
        $body
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    catch {file delete -force $range_root}
} -result {1 1 1 2345}

test http-connection-1.16 {static files support multipart byte ranges} -setup {
    set range_root [file join [temporaryDirectory] tclwire-range-[pid]]
    file mkdir $range_root
    ::fileutil::writeFile -translation binary \
        [file join $range_root range.bin] 0123456789
} -body {
    ::tclwire::runtime start [list \
        --docroot $range_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET /range.bin HTTP/1.1\r\nHost: localhost\r\nRange: bytes=0-1,8-9\r\nConnection: close\r\n\r\n"]
    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 $separator-1]
    set body [string range $response $separator+4 end]
    regexp -nocase \
        {Content-Type: multipart/byteranges; boundary=([^\r\n]+)} \
        $headers -> boundary
    list \
        [string match "HTTP/1.1 206 Partial Content*" $headers] \
        [string match \
            "*--$boundary\r\n*Content-Range: bytes 0-1/10*\r\n01\r\n*" \
            $body] \
        [string match \
            "*Content-Range: bytes 8-9/10*\r\n89\r\n--$boundary--\r\n" \
            $body]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    catch {file delete -force $range_root}
} -result {1 1 1}

test http-connection-1.17 {unsatisfiable byte ranges return 416} -setup {
    set range_root [file join [temporaryDirectory] tclwire-range-[pid]]
    file mkdir $range_root
    ::fileutil::writeFile -translation binary \
        [file join $range_root range.bin] 0123456789
} -body {
    ::tclwire::runtime start [list \
        --docroot $range_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET /range.bin HTTP/1.1\r\nHost: localhost\r\nRange: bytes=20-30\r\nConnection: close\r\n\r\n"]
    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 $separator-1]
    set body [string range $response $separator+4 end]
    list \
        [string match "HTTP/1.1 416 Range Not Satisfiable*" $headers] \
        [regexp -nocase {Content-Range: bytes \*/10} $headers] \
        [regexp -nocase {Content-Length: 0} $headers] \
        [string length $body]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    catch {file delete -force $range_root}
} -result {1 1 1 0}

test http-connection-1.18 {unsupported and malformed ranges fall back to 200} -setup {
    set range_root [file join [temporaryDirectory] tclwire-range-[pid]]
    file mkdir $range_root
    ::fileutil::writeFile -translation binary \
        [file join $range_root range.bin] 0123456789
} -body {
    ::tclwire::runtime start [list \
        --docroot $range_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set results {}
    foreach range {items=2-5 bytes=bad} {
        set response [::tclwire::http_connection_test::request \
            "GET /range.bin HTTP/1.1\r\nHost: localhost\r\nRange: $range\r\nConnection: close\r\n\r\n"]
        set separator [string first "\r\n\r\n" $response]
        set headers [string range $response 0 $separator-1]
        set body [string range $response $separator+4 end]
        lappend results \
            [string match "HTTP/1.1 200 OK*" $headers] \
            $body
    }
    set results
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    catch {file delete -force $range_root}
} -result {1 0123456789 1 0123456789}

::tclwire::http_connection_test::cleanup
cleanupTests
