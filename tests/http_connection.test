package require tcltest
namespace import ::tcltest::*
package require fileutil

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::runtime 0.1
package require tclwire::http::protocol 0.1
package require tclwire::http::query 0.1
package require tclwire::http::request 0.1
package require tclwire::connection_agent 0.1
package require tclwire::http::connection_agent 0.1

namespace eval ::tclwire::http_connection_test {
    variable logfile [file join [temporaryDirectory] tclwire-http-[pid].log]
    variable logerr [file join [temporaryDirectory] tclwire-http-[pid].err]

    proc cleanup {} {
        variable logfile
        variable logerr
        catch {::tclwire::runtime stop}
        catch {file delete -force $logfile}
        catch {file delete -force $logerr}
    }

    proc log_contents {} {
        variable logfile
        set channel [open $logfile r]
        try {
            return [read $channel]
        } finally {
            close $channel
        }
    }

    proc error_log_contents {} {
        variable logerr
        set channel [open $logerr r]
        try {
            return [read $channel]
        } finally {
            close $channel
        }
    }

    proc request {request} {
        set chan [socket 127.0.0.1 8990]
        chan configure $chan -blocking 0 -buffering none -translation binary
        puts -nonewline $chan $request
        flush $chan

        set response {}
        set deadline [expr {[clock milliseconds] + 3000}]
        while {[clock milliseconds] < $deadline} {
            update
            append response [read $chan]
            if {[eof $chan]} {
                close $chan
                return $response
            }
            after 5
        }
        catch {close $chan}
        error "timed out waiting for HTTP response"
    }

    proc request_while_uploading {headers body} {
        set chan [socket 127.0.0.1 8990]
        chan configure $chan -blocking 0 -buffering none -translation binary
        puts -nonewline $chan $headers
        catch {
            puts -nonewline $chan $body
            flush $chan
        }

        set response {}
        set deadline [expr {[clock milliseconds] + 3000}]
        while {[clock milliseconds] < $deadline} {
            update
            append response [read $chan]
            if {[string first "\r\n\r\n" $response] >= 0} {
                catch {close $chan}
                return $response
            }
            if {[eof $chan]} {
                close $chan
                return $response
            }
            after 5
        }
        catch {close $chan}
        error "timed out waiting for HTTP response"
    }
}

::tclwire::http_connection_test::cleanup

test http-protocol-1.1 {protocol session extracts path query and headers} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set request "GET /hello/world?name=TclWire&mode=test HTTP/1.1\r\nHost: localhost\r\nX-Test: yes\r\n\r\n"
        set info [$protocol parse_request $request]
        list \
            [dict get $info method] \
            [dict get $info path] \
            [dict get $info query] \
            [dict get $info query_dict] \
            [dict get $info version] \
            [dict get $info headers host] \
            [dict get $info headers x-test]
    } finally {
        $protocol destroy
    }
} -result {GET /hello/world name=TclWire&mode=test {name TclWire mode test} 1.1 localhost yes}

test http-query-1.1 {query fields decode into a dictionary} -body {
    ::tclwire::http::query decode \
        {name=Tcl+Wire&message=caf%C3%A8&escaped=a%26b%3Dc}
} -result [dict create name {Tcl Wire} message "caf\u00e8" escaped {a&b=c}]

test http-query-1.2 {empty and valueless query fields are retained} -body {
    ::tclwire::http::query decode {flag&empty=&=value&&}
} -result [dict create flag {} empty {} {} value]

test http-query-1.3 {duplicate query names keep the last value} -body {
    ::tclwire::http::query decode {mode=first&mode=second}
} -result [dict create mode second]

test http-query-1.4 {malformed query escapes are rejected} -body {
    list \
        [catch {::tclwire::http::query decode {value=%}} first] $first \
        [catch {::tclwire::http::query decode {value=%GG}} second] $second
} -result [list \
    1 {incomplete percent escape in URL query} \
    1 {invalid percent escape in URL query}]

test http-protocol-1.2 {request completion waits for the declared body} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set head "POST /submit HTTP/1.1\r\nContent-Length: 4\r\n\r\n"
        set first [$protocol feed "${head}ab"]
        set second [$protocol feed cd]
        list \
            [dict get $first status] \
            [dict get $first phase] \
            [dict get $second status] \
            [dict get [dict get $second descriptor] body]
    } finally {
        $protocol destroy
    }
} -result {need_more body complete abcd}

test http-protocol-1.2a {
    incremental feed results have a stable dictionary contract
} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set head "POST /upload HTTP/1.1\r\nContent-Length: 7"
        set tail "\r\n\r\npayload"
        set first [$protocol feed $head]
        set second [$protocol feed $tail]
        list \
            [lsort [dict keys $first]] \
            [dict get $first status] \
            [dict get $first phase] \
            [dict get $first method] \
            [dict get $first declared_request_size] \
            [dict get $first descriptor] \
            [lsort [dict keys $second]] \
            [dict get $second status] \
            [dict get $second phase] \
            [dict get $second method] \
            [expr {[dict get $second declared_request_size] == \
                [string length "$head$tail"]}] \
            [dict get [dict get $second descriptor] body]
    } finally {
        $protocol destroy
    }
} -result [list \
    {declared_request_size descriptor header_size method phase status} \
    need_more headers {} 0 {} \
    {declared_request_size descriptor header_size method phase status} \
    complete complete POST 1 payload]

test http-protocol-1.3 {uploaded data is retained in the request descriptor} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set request "POST /upload HTTP/1.1\r\nContent-Length: 7\r\n\r\npayload"
        set descriptor [$protocol parse_request $request]
        list \
            [dict get $descriptor body_storage] \
            [dict get $descriptor body_size] \
            [dict get $descriptor body]
    } finally {
        $protocol destroy
    }
} -result {in_memory 7 payload}

test http-protocol-1.3a {incremental bodies remain in memory through threshold} -body {
    set area [file join [temporaryDirectory] tclwire-body-[pid]]
    set protocol [::tclwire::HttpProtocolSession new \
        -bodythreshold 7 -spooldirectory $area]
    try {
        set first [$protocol feed \
            "POST /upload HTTP/1.1\r\nContent-Length: 7\r\n\r\npay"]
        set second [$protocol feed load]
        set descriptor [dict get $second descriptor]
        list [dict get $first status] [dict get $descriptor body_storage] \
            [dict get $descriptor body_size] [dict get $descriptor body] \
            [file exists $area]
    } finally {
        $protocol destroy
        file delete -force $area
    }
} -result {need_more in_memory 7 payload 0}

test http-protocol-1.3b {fixed-length body spills after threshold} -body {
    set area [file join [temporaryDirectory] tclwire-body-[pid]]
    set protocol [::tclwire::HttpProtocolSession new \
        -bodythreshold 4 -spooldirectory $area]
    set path {}
    try {
        $protocol feed \
            "POST /upload HTTP/1.1\r\nContent-Length: 8\r\n\r\nab"
        set result [$protocol feed cdefgh]
        set descriptor [dict get $result descriptor]
        set path [dict get $descriptor body_path]
        set channel [open $path rb]
        try { set stored [read $channel] } finally { close $channel }
        list [dict get $descriptor body_storage] \
            [dict get $descriptor body_size] $stored
    } finally {
        if {$path ne {}} { file delete $path }
        $protocol destroy
        file delete -force $area
    }
} -result {spooled_file 8 abcdefgh}

test http-protocol-1.3c {chunked body spills decoded payload incrementally} -body {
    set area [file join [temporaryDirectory] tclwire-body-[pid]]
    set protocol [::tclwire::HttpProtocolSession new \
        -bodythreshold 4 -spooldirectory $area]
    set path {}
    try {
        $protocol feed \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nab"
        set result [$protocol feed "c\r\n3\r\ndef\r\n0\r\nX-End: yes\r\n\r\n"]
        set descriptor [dict get $result descriptor]
        set path [dict get $descriptor body_path]
        set channel [open $path rb]
        try { set stored [read $channel] } finally { close $channel }
        list [dict get $descriptor body_storage] \
            [dict get $descriptor body_size] $stored \
            [dict get $descriptor trailers x-end]
    } finally {
        if {$path ne {}} { file delete $path }
        $protocol destroy
        file delete -force $area
    }
} -result {spooled_file 6 abcdef yes}

test http-protocol-1.3d {aborting an incomplete spill removes its file} -body {
    set area [file join [temporaryDirectory] tclwire-body-[pid]]
    set protocol [::tclwire::HttpProtocolSession new \
        -bodythreshold 2 -spooldirectory $area]
    try {
        $protocol feed \
            "POST /upload HTTP/1.1\r\nContent-Length: 20\r\n\r\npartial"
        set before [glob -nocomplain -directory $area *]
        $protocol abort
        set after [glob -nocomplain -directory $area *]
        list [llength $before] [llength $after]
    } finally {
        $protocol destroy
        file delete -force $area
    }
} -result {1 0}

test http-protocol-1.3e {incremental gzip decoding uses the hybrid sink} -body {
    set area [file join [temporaryDirectory] tclwire-body-[pid]]
    set protocol [::tclwire::HttpProtocolSession new \
        -bodythreshold 16 -spooldirectory $area]
    set path {}
    try {
        set expected [string repeat payload 100]
        set compressed [zlib gzip $expected]
        set request \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"
        append request [format "%X\r\n" [string length $compressed]]
        append request $compressed "\r\n0\r\n\r\n"
        set result [$protocol feed $request]
        set descriptor [dict get $result descriptor]
        set path [dict get $descriptor body_path]
        set channel [open $path rb]
        try { set stored [read $channel] } finally { close $channel }
        list [dict get $descriptor body_storage] \
            [dict get $descriptor body_size] [expr {$stored eq $expected}]
    } finally {
        if {$path ne {}} { file delete $path }
        $protocol destroy
        file delete -force $area
    }
} -result {spooled_file 700 1}

test http-protocol-1.3f {
    parsed request information is internal write-once session state
} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set result [$protocol feed \
            "POST /upload HTTP/1.1\r\nContent-Length: 7\r\n\r\npayload"]
        list \
            [dict get $result status] \
            [expr {"install_request_info" ni \
                [info object methods $protocol -all]}] \
            [dict get [dict get $result descriptor] method]
    } finally {
        $protocol destroy
    }
} -result {complete 1 POST}

test http-protocol-1.3g {
    multipart bodies are decomposed incrementally without aggregate spooling
} -body {
    set area [file join [temporaryDirectory] tclwire-multipart-[pid]]
    set protocol [::tclwire::HttpProtocolSession new \
        -bodythreshold 16 -spooldirectory $area]
    set file_path {}
    try {
        set boundary AaB03x
        set body [binary format a* {}]
        append body "--$boundary\r\n"
        append body "Content-Disposition: form-data; name=\"field\"\r\n\r\n"
        append body "value\r\n"
        append body "--$boundary\r\n"
        append body "Content-Disposition: form-data; name=\"upload\"; filename=\"hello.txt\"\r\n"
        append body "Content-Type: text/plain\r\n\r\n"
        append body "hello file\r\n"
        append body "--$boundary--\r\n"

        set head "POST /upload HTTP/1.1\r\n"
        append head "Content-Type: multipart/form-data; boundary=$boundary\r\n"
        append head "Content-Length: [string length $body]\r\n\r\n"
        $protocol feed "${head}[string range $body 0 20]"
        set result [$protocol feed [string range $body 21 end]]
        set descriptor [dict get $result descriptor]
        set request [::tclwire::HttpRequest new $descriptor]
        set file [$request uploaded_file upload]
        set file_path [dict get $file body_path]
        set channel [open $file_path rb]
        try { set stored [read $channel] } finally { close $channel }
        list \
            [dict get $descriptor body_media] \
            [dict get $descriptor body_storage] \
            [expr {[dict get $descriptor body_size] == [string length $body]}] \
            [$request form_value field] \
            [dict get $file filename] \
            [dict get $file body_storage] \
            $stored \
            [llength [glob -nocomplain -directory $area tclwire-request*]]
    } finally {
        catch {$request destroy}
        if {$file_path ne {}} { catch {file delete $file_path} }
        $protocol destroy
        file delete -force $area
    }
} -result {multipart decomposed 1 value hello.txt spooled_file {hello file} 0}

test http-protocol-1.4 {UTF-8 response lengths count encoded bytes} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set response [$protocol build_response 200 OK {caffè} utf-8]
        set separator [string first "\r\n\r\n" $response]
        set headers [string range $response 0 $separator-1]
        set body_bytes [string range $response $separator+4 end]
        list \
            [regexp {Content-Length: 6} $headers] \
            [encoding convertfrom utf-8 $body_bytes]
    } finally {
        $protocol destroy
    }
} -result {1 caffè}

test http-protocol-1.5 {response framing does not infer a media type} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set response [$protocol build_response 200 OK {caffè} iso8859-1]
        set separator [string first "\r\n\r\n" $response]
        set headers [string range $response 0 $separator-1]
        set body_bytes [string range $response $separator+4 end]
        list \
            [regexp {Content-Length: 5} $headers] \
            [expr {![regexp -nocase {Content-Type:} $headers]}] \
            [encoding convertfrom iso8859-1 $body_bytes]
    } finally {
        $protocol destroy
    }
} -result {1 1 caffè}

test http-protocol-1.6 {chunked request completion waits for the terminator} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set headers \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"
        set first [$protocol feed "${headers}4\r\nWiki\r\n5\r\npedia\r\n"]
        set second [$protocol feed "0\r\n\r\n"]
        list \
            [dict get $first status] \
            [dict get $first phase] \
            [dict get $second status] \
            [dict get [dict get $second descriptor] body]
    } finally {
        $protocol destroy
    }
} -result {need_more body complete Wikipedia}

test http-protocol-1.7 {
    chunk extensions and trailers produce a decoded binary request body
} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set binary_tail [binary format H* 0080ff]
        set request \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: Chunked\r\n\r\n"
        append request "5;name=value\r\nhello\r\n"
        append request "3\r\n$binary_tail\r\n"
        append request "0\r\nX-Checksum: accepted\r\n\r\n"
        set descriptor [$protocol parse_request $request]
        list \
            [dict get $descriptor body_framing] \
            [dict get $descriptor body_size] \
            [binary encode hex [dict get $descriptor body]] \
            [dict get $descriptor trailers x-checksum]
    } finally {
        $protocol destroy
    }
} -result {chunked 8 68656c6c6f0080ff accepted}

test http-protocol-1.8 {ambiguous and unsupported request framing is rejected} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set ambiguous \
            "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 4\r\n\r\n0\r\n\r\n"
        set unsupported \
            "POST / HTTP/1.1\r\nTransfer-Encoding: deflate, chunked\r\n\r\n0\r\n\r\n"
        set duplicate_length \
            "POST / HTTP/1.1\r\nContent-Length: 4\r\nContent-Length: 5\r\n\r\nbody!"
        set ambiguous_status [catch {$protocol feed $ambiguous} ambiguous_error]
        $protocol reset
        set unsupported_status [catch {$protocol feed $unsupported} unsupported_error]
        $protocol reset
        set length_status [catch {$protocol feed $duplicate_length} length_error]
        list \
            $ambiguous_status $ambiguous_error \
            $unsupported_status $unsupported_error \
            $length_status $length_error
    } finally {
        $protocol destroy
    }
} -result [list \
    1 "request contains both Transfer-Encoding and Content-Length" \
    1 "unsupported Transfer-Encoding" \
    1 "invalid Content-Length"]

test http-protocol-1.8a {request body framing is available to connection agents} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        list \
            [$protocol request_body_framing [dict create]] \
            [$protocol request_body_framing [dict create content-length 4]] \
            [$protocol request_body_framing [dict create transfer-encoding chunked]]
    } finally {
        $protocol destroy
    }
} -result {none content-length chunked}

test http-protocol-1.9 {malformed chunk framing is rejected} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set bad_size \
            "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nZZ\r\nbody\r\n0\r\n\r\n"
        set bad_ending \
            "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nbodyXX0\r\n\r\n"
        set size_status [catch {$protocol feed $bad_size} size_error]
        $protocol reset
        set ending_status [catch {$protocol feed $bad_ending} ending_error]
        list \
            $size_status $size_error \
            $ending_status $ending_error
    } finally {
        $protocol destroy
    }
} -result [list \
    1 "invalid chunk size" \
    1 "chunk data is not terminated by CRLF"]

test http-protocol-1.10 {gzip is decoded after chunk framing} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set expected [binary format H* 0001027f80feff]
        set compressed [zlib gzip $expected]
        set request \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"
        append request [format "%X\r\n" [string length $compressed]]
        append request $compressed "\r\n0\r\n\r\n"
        set descriptor [$protocol parse_request $request]
        list \
            [dict get $descriptor transfer_codings] \
            [dict get $descriptor body_size] \
            [binary encode hex [dict get $descriptor body]]
    } finally {
        $protocol destroy
    }
} -result {{gzip chunked} 7 0001027f80feff}

test http-protocol-1.11 {invalid gzip transfer data is rejected} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set request \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"
        append request "4\r\nnope\r\n0\r\n\r\n"
        catch {$protocol parse_request $request} message
        set message
    } finally {
        $protocol destroy
    }
} -result {invalid gzip transfer coding}

test http-protocol-1.12 {protocol session frames chunked response bytes} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set head [$protocol build_chunked_response_head \
            200 OK utf-8 [list "Content-Type: text/plain"] text]
        set untyped_head [$protocol build_chunked_response_head \
            200 OK utf-8 {} text]
        set first [$protocol chunk_frame \
            [$protocol encode_response_body alpha utf-8 text]]
        set binary [binary format H* 0080ff]
        set second [$protocol chunk_frame \
            [$protocol encode_response_body $binary utf-8 binary]]
        list \
            [string match "HTTP/1.1 200 OK*" $head] \
            [regexp -nocase {Transfer-Encoding: chunked} $head] \
            [expr {![regexp -nocase {Content-Length:} $head]}] \
            [expr {![regexp -nocase {Content-Type:} $untyped_head]}] \
            [binary encode hex $first] \
            [binary encode hex $second] \
            [$protocol chunk_terminator]
    } finally {
        $protocol destroy
    }
} -result [list \
    1 1 1 1 \
    350d0a616c7068610d0a \
    330d0a0080ff0d0a \
    "0\r\n\r\n"]

test http-protocol-1.13 {HEAD response retains GET content length without body} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set response [$protocol build_response \
            200 OK {caffè} utf-8 [list "Content-Type: text/plain"] text 1]
        set separator [string first "\r\n\r\n" $response]
        set headers [string range $response 0 $separator-1]
        set body [string range $response $separator+4 end]
        list \
            [regexp {Content-Length: 6} $headers] \
            [string length $body]
    } finally {
        $protocol destroy
    }
} -result {1 0}

test http-connection-agent-1.1 {HTTP agent specializes the generic connection agent} -body {
    list \
        [info class superclasses ::tclwire::HttpConnectionAgent] \
        [expr {"application_output" ni \
            [info class methods ::tclwire::ConnectionAgent -all]}] \
        [expr {"application_output" in \
            [info class methods ::tclwire::HttpConnectionAgent -all]}] \
        [expr {"handle_request" ni \
            [info class methods ::tclwire::HttpConnectionAgent -all]}] \
        [expr {"build_request_descriptor" in \
            [info class methods ::tclwire::HttpConnectionAgent -all]}] \
        [expr {"active_transaction" in \
            [info class methods ::tclwire::ConnectionAgent -all]}] \
        [expr {"outstanding_transactions" ni \
            [info class methods ::tclwire::ConnectionAgent -all]}]
} -result {::tclwire::ConnectionAgent 1 1 1 1 1 1}

test http-connection-1.3 {each accepted connection receives the document root index} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET /?argument=value HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]

    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 $separator-1]
    set body_bytes [string range $response $separator+4 end]
    set expected [::fileutil::cat -encoding utf-8 \
        [file join $project_root index.html]]
    ::tclwire::runtime stop
    set log [::tclwire::http_connection_test::log_contents]
    list \
        [string match "HTTP/1.1 200 OK*" $headers] \
        [regexp -nocase {Content-Type: text/html; charset=utf-8} $headers] \
        [regexp "Content-Length: [string length \
            [encoding convertto utf-8 $expected]]" $headers] \
        [expr {[encoding convertfrom utf-8 $body_bytes] eq $expected}] \
        [regexp {http method=GET path=/ status=200 bytes=[0-9]+ remote=127\.0\.0\.1} $log]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {1 1 1 1 1}

test http-connection-1.4 {malformed request lines receive a protocol error} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "NOT AN HTTP REQUEST\r\nHost: localhost\r\n\r\n"]
    list \
        [string match "HTTP/1.1 400 Bad Request*" $response] \
        [string match \
            {*The request could not be understood by TclWire.*} \
            $response]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {1 1}

test http-connection-1.4a {declared oversized requests are rejected before their body arrives} -body {
    ::tclwire::runtime start [list \
        --max-request-bytes 100 \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 1000\r\n\r\n"]
    set upload_response [::tclwire::http_connection_test::request_while_uploading \
        "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 1000\r\n\r\n" \
        [string repeat x 200000]]
    list \
        [string match "HTTP/1.1 413 Content Too Large*" $response] \
        [string match "HTTP/1.1 413 Content Too Large*" $upload_response]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {1 1}

test http-connection-1.4b {oversized request headers receive 431} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set request "GET / HTTP/1.1\r\nX-Fill: [string repeat x 65536]"
    set response [::tclwire::http_connection_test::request $request]
    string match "HTTP/1.1 431 Request Header Fields Too Large*" $response
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result 1

test http-connection-1.5 {sequential connections reuse a TPBA pool worker} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set reactor [::tclwire::runtime transport_reactor]

    ::tclwire::http_connection_test::request \
        "GET /first HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    update
    set first_status [::tclwire::tpba request [dict create \
        operation pool_status \
        pool_key [$reactor pool_key]]]
    set first_idle [dict get $first_status result stats per_status_lists idle]

    ::tclwire::http_connection_test::request \
        "GET /second HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    update
    set second_status [::tclwire::tpba request [dict create \
        operation pool_status \
        pool_key [$reactor pool_key]]]
    set second_idle [dict get $second_status result stats per_status_lists idle]

    list \
        [$reactor pool_key] \
        [llength $first_idle] \
        [expr {$first_idle eq $second_idle}]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {connection:http:8990 1 1}

test http-connection-1.5a {deferred connections are logged at debug severity} -setup {
    set slow_application [makeFile {
package require tclwire::application 0.1

oo::class create ::tclwire::http_connection_test::SlowApplication {
    superclass ::tclwire::CApplication

    method handle_request {request_descriptor} {
        after 500
        ::tclwire::io response 200 OK \
            [list "Content-Type: text/plain; charset=utf-8"] text utf-8
        ::tclwire::io out slow-ok
    }
}
} slow-application.tcl]
    set slow_config [makeFile [format {
[tclwire]
default_application = "localhost"
docroot = "%s"
logfile = "%s"
logerr = "%s"
log_level = "debug"

[http]
enabled = true
port = 8990

[http.localhost]
class = "::tclwire::http_connection_test::SlowApplication"
file = "%s"
docroot = "%s"
encoding = "utf-8"
} $project_root \
   $::tclwire::http_connection_test::logfile \
   $::tclwire::http_connection_test::logerr \
   $slow_application \
   $project_root] slow-config.toml]
} -body {
    ::tclwire::runtime start [list \
        --config $slow_config \
        --conn-max-workers 1 \
        --conn-max-per-thread 1 \
        --conn-max-wait 1000]

    set first [socket 127.0.0.1 8990]
    chan configure $first -blocking 0 -buffering none -translation binary
    puts -nonewline $first \
        "GET /first HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    flush $first

    after 50
    update

    set second [socket 127.0.0.1 8990]
    chan configure $second -blocking 0 -buffering none -translation binary
    puts -nonewline $second \
        "GET /second HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    flush $second

    set responses [dict create $first {} $second {}]
    set deadline [expr {[clock milliseconds] + 5000}]
    while {[clock milliseconds] < $deadline &&
            (! [eof $first] || ! [eof $second])} {
        update
        foreach channel [list $first $second] {
            if {![eof $channel]} {
                dict append responses $channel [read $channel]
            }
        }
        after 5
    }
    foreach channel [list $first $second] {
        dict append responses $channel [read $channel]
        catch {close $channel}
    }

    ::tclwire::runtime stop
    set log [::tclwire::http_connection_test::error_log_contents]
    list \
        [string match "HTTP/1.1 200 OK*" [dict get $responses $first]] \
        [string match "*slow-ok" [dict get $responses $first]] \
        [string match "HTTP/1.1 200 OK*" [dict get $responses $second]] \
        [string match "*slow-ok" [dict get $responses $second]] \
        [string match {*transport level=debug event=connection_queued*attempts=1*} $log] \
        [string match {*transport level=debug event=connection_dispatched*worker_thread_id=*} $log]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    removeFile $slow_config
    removeFile $slow_application
} -result {1 1 1 1 1 1}

test http-connection-1.5aa {one connection worker handles concurrent connections up to configured limit} -setup {
    set slow_application [makeFile {
package require tclwire::application 0.1

oo::class create ::tclwire::http_connection_test::ConcurrentSlowApplication {
    superclass ::tclwire::CApplication

    method handle_request {request_descriptor} {
        after 500
        ::tclwire::io response 200 OK \
            [list "Content-Type: text/plain; charset=utf-8"] text utf-8
        ::tclwire::io out concurrent-ok
    }
}
} concurrent-slow-application.tcl]
    set slow_config [makeFile [format {
[tclwire]
default_application = "localhost"
docroot = "%s"
logfile = "%s"
logerr = "%s"
log_level = "debug"

[http]
enabled = true
port = 8990

[http.localhost]
class = "::tclwire::http_connection_test::ConcurrentSlowApplication"
file = "%s"
docroot = "%s"
encoding = "utf-8"
} $project_root \
   $::tclwire::http_connection_test::logfile \
   $::tclwire::http_connection_test::logerr \
   $slow_application \
   $project_root] concurrent-slow-config.toml]
} -body {
    ::tclwire::runtime start [list \
        --config $slow_config \
        --conn-max-workers 1 \
        --conn-max-per-thread 2 \
        --conn-max-wait 0]

    set first [socket 127.0.0.1 8990]
    chan configure $first -blocking 0 -buffering none -translation binary
    puts -nonewline $first \
        "GET /first HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    flush $first

    after 50
    update

    set second [socket 127.0.0.1 8990]
    chan configure $second -blocking 0 -buffering none -translation binary
    puts -nonewline $second \
        "GET /second HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    flush $second

    set responses [dict create $first {} $second {}]
    set deadline [expr {[clock milliseconds] + 5000}]
    while {[clock milliseconds] < $deadline &&
            (! [eof $first] || ! [eof $second])} {
        update
        foreach channel [list $first $second] {
            if {![eof $channel]} {
                dict append responses $channel [read $channel]
            }
        }
        after 5
    }
    foreach channel [list $first $second] {
        dict append responses $channel [read $channel]
        catch {close $channel}
    }

    set reactor [::tclwire::runtime transport_reactor]
    set status [::tclwire::tpba request [dict create \
        operation pool_status \
        pool_key [$reactor pool_key]]]
    set workloads [dict get $status result stats workloads]
    set worker_id [lindex [dict keys $workloads] 0]
    set log [::tclwire::http_connection_test::error_log_contents]
    ::tclwire::runtime stop
    list \
        [string match "HTTP/1.1 200 OK*" [dict get $responses $first]] \
        [string match "*concurrent-ok" [dict get $responses $first]] \
        [string match "HTTP/1.1 200 OK*" [dict get $responses $second]] \
        [string match "*concurrent-ok" [dict get $responses $second]] \
        [dict get $status result stats live_threads_number] \
        [dict get $status result stats workloads $worker_id running_workload] \
        [dict get $status result stats workloads $worker_id cumulative_workload] \
        [string match {*event=connection_queued*} $log]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    removeFile $slow_config
    removeFile $slow_application
} -result {1 1 1 1 1 0 2 0}

test http-connection-1.5b {deferred connection timeout close is logged at crit severity} -setup {
    set slow_application [makeFile {
package require tclwire::application 0.1

oo::class create ::tclwire::http_connection_test::SlowCloseApplication {
    superclass ::tclwire::CApplication

    method handle_request {request_descriptor} {
        after 500
        ::tclwire::io response 200 OK \
            [list "Content-Type: text/plain; charset=utf-8"] text utf-8
        ::tclwire::io out slow-ok
    }
}
} slow-close-application.tcl]
    set slow_config [makeFile [format {
[tclwire]
default_application = "localhost"
docroot = "%s"
logfile = "%s"
logerr = "%s"
log_level = "info"

[http]
enabled = true
port = 8990

[http.localhost]
class = "::tclwire::http_connection_test::SlowCloseApplication"
file = "%s"
docroot = "%s"
encoding = "utf-8"
} $project_root \
   $::tclwire::http_connection_test::logfile \
   $::tclwire::http_connection_test::logerr \
   $slow_application \
   $project_root] slow-close-config.toml]
} -body {
    ::tclwire::runtime start [list \
        --config $slow_config \
        --conn-max-workers 1 \
        --conn-max-per-thread 1 \
        --conn-max-wait 0]

    set first [socket 127.0.0.1 8990]
    chan configure $first -blocking 0 -buffering none -translation binary
    puts -nonewline $first \
        "GET /first HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    flush $first

    after 50
    update

    set second [socket 127.0.0.1 8990]
    chan configure $second -blocking 0 -buffering none -translation binary
    puts -nonewline $second \
        "GET /second HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    flush $second

    set second_response {}
    set deadline [expr {[clock milliseconds] + 1000}]
    while {[clock milliseconds] < $deadline && ![eof $second]} {
        update
        append second_response [read $second]
        after 5
    }
    append second_response [read $second]
    set second_closed [eof $second]
    catch {close $second}

    set first_response {}
    set deadline [expr {[clock milliseconds] + 3000}]
    while {[clock milliseconds] < $deadline && ![eof $first]} {
        update
        append first_response [read $first]
        after 5
    }
    append first_response [read $first]
    catch {close $first}

    ::tclwire::runtime stop
    set log [::tclwire::http_connection_test::error_log_contents]
    list [string match "HTTP/1.1 200 OK*" $first_response] \
         $second_closed \
         $second_response \
         [string match {*transport level=crit event=connection_closed*reason=deferred_attempts_exhausted*} $log]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    removeFile $slow_config
    removeFile $slow_application
} -result {1 1 {} 1}

test http-connection-1.6 {a request without Host uses the default application} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.0\r\nConnection: close\r\n\r\n"]
    string match "HTTP/1.1 200 OK*" $response
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result 1

test http-connection-1.7 {an unknown Host is not dispatched to the default application} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.1\r\nHost: unknown.example\r\nConnection: close\r\n\r\n"]
    list \
        [string match "HTTP/1.1 404 Not Found*" $response] \
        [string match {*TclWire could not find <code>/</code>.*} $response]
