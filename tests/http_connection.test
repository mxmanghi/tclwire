package require tcltest
namespace import ::tcltest::*
package require fileutil

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::runtime 0.1
package require tclwire::http::protocol 0.1
package require tclwire::connection_agent 0.1
package require tclwire::http::connection_agent 0.1

namespace eval ::tclwire::http_connection_test {
    variable logfile [file join [temporaryDirectory] tclwire-http-[pid].log]

    proc cleanup {} {
        variable logfile
        catch {::tclwire::runtime stop}
        catch {file delete -force $logfile}
    }

    proc log_contents {} {
        variable logfile
        set channel [open $logfile r]
        try {
            return [read $channel]
        } finally {
            close $channel
        }
    }

    proc request {request} {
        set chan [socket 127.0.0.1 8990]
        chan configure $chan -blocking 0 -buffering none -translation binary
        puts -nonewline $chan $request
        flush $chan

        set response {}
        set deadline [expr {[clock milliseconds] + 3000}]
        while {[clock milliseconds] < $deadline} {
            update
            append response [read $chan]
            if {[eof $chan]} {
                close $chan
                return $response
            }
            after 5
        }
        catch {close $chan}
        error "timed out waiting for HTTP response"
    }
}

::tclwire::http_connection_test::cleanup

test http-protocol-1.1 {protocol session extracts path query and headers} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set request "GET /hello/world?name=TclWire&mode=test HTTP/1.1\r\nHost: localhost\r\nX-Test: yes\r\n\r\n"
        set info [$protocol parse_request $request]
        list \
            [dict get $info method] \
            [dict get $info path] \
            [dict get $info query] \
            [dict get $info version] \
            [dict get $info headers host] \
            [dict get $info headers x-test]
    } finally {
        $protocol destroy
    }
} -result {GET /hello/world name=TclWire&mode=test 1.1 localhost yes}

test http-protocol-1.2 {request completion waits for the declared body} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set partial "POST /submit HTTP/1.1\r\nContent-Length: 4\r\n\r\nab"
        set complete "${partial}cd"
        list \
            [$protocol complete_request $partial] \
            [expr {[$protocol complete_request $complete] eq $complete}]
    } finally {
        $protocol destroy
    }
} -result {{} 1}

test http-protocol-1.3 {uploaded data is retained in the request descriptor} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set request "POST /upload HTTP/1.1\r\nContent-Length: 7\r\n\r\npayload"
        set descriptor [$protocol parse_request $request]
        list \
            [dict get $descriptor body_mode] \
            [dict get $descriptor body_size] \
            [dict get $descriptor body]
    } finally {
        $protocol destroy
    }
} -result {in_memory 7 payload}

test http-protocol-1.4 {UTF-8 response lengths count encoded bytes} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set response [$protocol build_response 200 OK {caffè} utf-8]
        set separator [string first "\r\n\r\n" $response]
        set headers [string range $response 0 [expr {$separator - 1}]]
        set body_bytes [string range $response [expr {$separator + 4}] end]
        list \
            [regexp {Content-Length: 6} $headers] \
            [encoding convertfrom utf-8 $body_bytes]
    } finally {
        $protocol destroy
    }
} -result {1 caffè}

test http-protocol-1.5 {response framing uses the configured encoding} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set response [$protocol build_response 200 OK {caffè} iso8859-1]
        set separator [string first "\r\n\r\n" $response]
        set headers [string range $response 0 [expr {$separator - 1}]]
        set body_bytes [string range $response [expr {$separator + 4}] end]
        list \
            [regexp {Content-Length: 5} $headers] \
            [regexp -nocase \
                {Content-Type: text/html; charset=iso8859-1} $headers] \
            [encoding convertfrom iso8859-1 $body_bytes]
    } finally {
        $protocol destroy
    }
} -result {1 1 caffè}

test http-protocol-1.6 {chunked request completion waits for the terminator} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set headers \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"
        set partial "${headers}4\r\nWiki\r\n5\r\npedia\r\n"
        set complete "${partial}0\r\n\r\n"
        set trailing "${complete}NEXT"
        list \
            [$protocol complete_request $partial] \
            [expr {[$protocol complete_request $trailing] eq $complete}]
    } finally {
        $protocol destroy
    }
} -result {{} 1}

test http-protocol-1.7 {
    chunk extensions and trailers produce a decoded binary request body
} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set binary_tail [binary format H* 0080ff]
        set request \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: Chunked\r\n\r\n"
        append request "5;name=value\r\nhello\r\n"
        append request "3\r\n$binary_tail\r\n"
        append request "0\r\nX-Checksum: accepted\r\n\r\n"
        set descriptor [$protocol parse_request $request]
        list \
            [dict get $descriptor body_framing] \
            [dict get $descriptor body_size] \
            [binary encode hex [dict get $descriptor body]] \
            [dict get $descriptor trailers x-checksum]
    } finally {
        $protocol destroy
    }
} -result {chunked 8 68656c6c6f0080ff accepted}

test http-protocol-1.8 {ambiguous and unsupported request framing is rejected} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set ambiguous \
            "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 4\r\n\r\n0\r\n\r\n"
        set unsupported \
            "POST / HTTP/1.1\r\nTransfer-Encoding: deflate, chunked\r\n\r\n0\r\n\r\n"
        set duplicate_length \
            "POST / HTTP/1.1\r\nContent-Length: 4\r\nContent-Length: 5\r\n\r\nbody!"
        list \
            [catch {$protocol complete_request $ambiguous} ambiguous_error] \
            $ambiguous_error \
            [catch {$protocol complete_request $unsupported} unsupported_error] \
            $unsupported_error \
            [catch {$protocol complete_request $duplicate_length} length_error] \
            $length_error
    } finally {
        $protocol destroy
    }
} -result [list \
    1 "request contains both Transfer-Encoding and Content-Length" \
    1 "unsupported Transfer-Encoding" \
    1 "invalid Content-Length"]

test http-protocol-1.9 {malformed chunk framing is rejected} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set bad_size \
            "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nZZ\r\nbody\r\n0\r\n\r\n"
        set bad_ending \
            "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nbodyXX0\r\n\r\n"
        list \
            [catch {$protocol complete_request $bad_size} size_error] \
            $size_error \
            [catch {$protocol complete_request $bad_ending} ending_error] \
            $ending_error
    } finally {
        $protocol destroy
    }
} -result [list \
    1 "invalid chunk size" \
    1 "chunk data is not terminated by CRLF"]

test http-protocol-1.10 {gzip is decoded after chunk framing} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set expected [binary format H* 0001027f80feff]
        set compressed [zlib gzip $expected]
        set request \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"
        append request [format "%X\r\n" [string length $compressed]]
        append request $compressed "\r\n0\r\n\r\n"
        set descriptor [$protocol parse_request $request]
        list \
            [dict get $descriptor transfer_codings] \
            [dict get $descriptor body_size] \
            [binary encode hex [dict get $descriptor body]]
    } finally {
        $protocol destroy
    }
} -result {{gzip chunked} 7 0001027f80feff}

test http-protocol-1.11 {invalid gzip transfer data is rejected} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set request \
            "POST /upload HTTP/1.1\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"
        append request "4\r\nnope\r\n0\r\n\r\n"
        catch {$protocol parse_request $request} message
        set message
    } finally {
        $protocol destroy
    }
} -result {invalid gzip transfer coding}

test http-protocol-1.12 {protocol session frames chunked response bytes} -body {
    set protocol [::tclwire::HttpProtocolSession new]
    try {
        set head [$protocol build_chunked_response_head \
            200 OK utf-8 [list "Content-Type: text/plain"] text]
        set first [$protocol chunk_frame \
            [$protocol encode_response_body alpha utf-8 text]]
        set binary [binary format H* 0080ff]
        set second [$protocol chunk_frame \
            [$protocol encode_response_body $binary utf-8 binary]]
        list \
            [string match "HTTP/1.1 200 OK*" $head] \
            [regexp -nocase {Transfer-Encoding: chunked} $head] \
            [expr {![regexp -nocase {Content-Length:} $head]}] \
            [binary encode hex $first] \
            [binary encode hex $second] \
            [$protocol chunk_terminator]
    } finally {
        $protocol destroy
    }
} -result [list \
    1 1 1 \
    350d0a616c7068610d0a \
    330d0a0080ff0d0a \
    "0\r\n\r\n"]

test http-connection-agent-1.1 {HTTP agent specializes the generic connection agent} -body {
    list \
        [info class superclasses ::tclwire::HttpConnectionAgent] \
        [expr {"application_output" ni \
            [info class methods ::tclwire::ConnectionAgent -all]}] \
        [expr {"application_output" in \
            [info class methods ::tclwire::HttpConnectionAgent -all]}] \
        [expr {"handle_request" in \
            [info class methods ::tclwire::HttpConnectionAgent -all]}] \
        [expr {"build_request_descriptor" in \
            [info class methods ::tclwire::HttpConnectionAgent -all]}] \
        [expr {"active_transaction" in \
            [info class methods ::tclwire::ConnectionAgent -all]}] \
        [expr {"outstanding_transactions" ni \
            [info class methods ::tclwire::ConnectionAgent -all]}]
} -result {::tclwire::ConnectionAgent 1 1 1 1 1 1}

test http-connection-1.3 {each accepted connection receives the document root index} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET /?argument=value HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]

    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 [expr {$separator - 1}]]
    set body_bytes [string range $response [expr {$separator + 4}] end]
    set expected [::fileutil::cat -encoding utf-8 \
        [file join $project_root index.html]]
    ::tclwire::runtime stop
    set log [::tclwire::http_connection_test::log_contents]
    list \
        [string match "HTTP/1.1 200 OK*" $headers] \
        [regexp -nocase {Content-Type: text/html; charset=utf-8} $headers] \
        [regexp "Content-Length: [string length \
            [encoding convertto utf-8 $expected]]" $headers] \
        [expr {[encoding convertfrom utf-8 $body_bytes] eq $expected}] \
        [regexp {http method=GET path=/ status=200 bytes=[0-9]+ remote=127\.0\.0\.1} $log]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {1 1 1 1 1}

test http-connection-1.4 {malformed request lines receive a protocol error} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "NOT AN HTTP REQUEST\r\nHost: localhost\r\n\r\n"]
    list \
        [string match "HTTP/1.1 400 Bad Request*" $response] \
        [string match \
            {*The request could not be understood by TclWire.*} \
            $response]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {1 1}

test http-connection-1.5 {sequential connections reuse a TPBA pool worker} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set reactor [::tclwire::runtime transport_reactor]

    ::tclwire::http_connection_test::request \
        "GET /first HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    update
    set first_status [::tclwire::tpba request [dict create \
        operation pool_status \
        pool_key [$reactor pool_key]]]
    set first_idle [dict get $first_status result stats per_status_lists idle]

    ::tclwire::http_connection_test::request \
        "GET /second HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    update
    set second_status [::tclwire::tpba request [dict create \
        operation pool_status \
        pool_key [$reactor pool_key]]]
    set second_idle [dict get $second_status result stats per_status_lists idle]

    list \
        [$reactor pool_key] \
        [llength $first_idle] \
        [expr {$first_idle eq $second_idle}]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {connection:http:8990 1 1}

test http-connection-1.6 {a request without Host uses the default application} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.0\r\nConnection: close\r\n\r\n"]
    string match "HTTP/1.1 200 OK*" $response
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result 1

test http-connection-1.7 {an unknown Host is not dispatched to the default application} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.1\r\nHost: unknown.example\r\nConnection: close\r\n\r\n"]
    list \
        [string match "HTTP/1.1 404 Not Found*" $response] \
        [string match {*TclWire could not find <code>/</code>.*} $response]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result {1 1}

test http-connection-1.8 {custom document roots preserve UTF-8 content} -body {
    set docroot [file join [temporaryDirectory] tclwire-docroot-[pid]]
    set expected "Caff\u00e8 \u2014 \u6771\u4eac"
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot index.html] $expected

    ::tclwire::runtime start [list \
        --docroot $docroot \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]

    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 [expr {$separator - 1}]]
    set body_bytes [string range $response [expr {$separator + 4}] end]
    list \
        [regexp {Content-Length: 17} $headers] \
        [expr {[encoding convertfrom utf-8 $body_bytes] eq $expected}]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    catch {file delete -force $docroot}
} -result {1 1}

test http-connection-1.9 {static binary files are preserved byte for byte} -body {
    set docroot [file join [temporaryDirectory] tclwire-docroot-[pid]]
    file mkdir [file join $docroot assets]
    set expected [binary format H* 0001027f80feff89504e470d0a]
    ::fileutil::writeFile -translation binary \
        [file join $docroot assets sample.bin] $expected

    ::tclwire::runtime start [list \
        --docroot $docroot \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "GET /assets/sample.bin HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]

    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 [expr {$separator - 1}]]
    set body_bytes [string range $response [expr {$separator + 4}] end]
    list \
        [string match "HTTP/1.1 200 OK*" $headers] \
        [regexp -nocase \
            {Content-Type: application/octet-stream} $headers] \
        [regexp "Content-Length: [string length $expected]" $headers] \
        [expr {$body_bytes eq $expected}]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    catch {file delete -force $docroot}
} -result {1 1 1 1}

test http-connection-1.10 {malformed chunked requests receive a protocol error} -body {
    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request \
        "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\ninvalid\r\n"]
    string match "HTTP/1.1 400 Bad Request*" $response
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result 1

test http-connection-1.11 {gzip chunked requests reach the application} -body {
    set compressed [zlib gzip "request body"]
    set request \
        "POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: gzip, chunked\r\n\r\n"
    append request [format "%X\r\n" [string length $compressed]]
    append request $compressed "\r\n0\r\n\r\n"

    ::tclwire::runtime start [list \
        --docroot $project_root \
        --logfile $::tclwire::http_connection_test::logfile]
    set response [::tclwire::http_connection_test::request $request]
    string match "HTTP/1.1 200 OK*" $response
} -cleanup {
    ::tclwire::http_connection_test::cleanup
} -result 1

test http-connection-1.12 {applications can stream chunked responses} -setup {
    set streaming_application [makeFile {
package require tclwire::application 0.1

oo::class create ::tclwire::http_connection_test::StreamingApplication {
    superclass ::tclwire::CApplication

    method handle_request {request_descriptor} {
        ::tclwire::io response 200 OK \
            [list "Content-Type: text/plain; charset=utf-8"] text utf-8
        ::tclwire::http::io header set Transfer-Encoding chunked
        ::tclwire::io out alpha
        ::tclwire::io flush
        ::tclwire::io out beta
    }
}
} streaming-application.tcl]
    set streaming_config [makeFile [format {
[tclwire]
default_application = "localhost"
docroot = "%s"
logfile = "%s"

[http]
enabled = true
port = 8990

[http.localhost]
class = "::tclwire::http_connection_test::StreamingApplication"
file = "%s"
docroot = "%s"
encoding = "utf-8"
} $project_root \
   $::tclwire::http_connection_test::logfile \
   $streaming_application \
   $project_root] streaming-config.toml]
} -body {
    ::tclwire::runtime start [list --config $streaming_config]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"]
    set separator [string first "\r\n\r\n" $response]
    set headers [string range $response 0 [expr {$separator - 1}]]
    set body [string range $response [expr {$separator + 4}] end]
    list \
        [string match "HTTP/1.1 200 OK*" $headers] \
        [regexp -nocase {Transfer-Encoding: chunked} $headers] \
        [expr {![regexp -nocase {Content-Length:} $headers]}] \
        [binary encode hex $body]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    removeFile $streaming_config
    removeFile $streaming_application
} -result {1 1 1 350d0a616c7068610d0a340d0a626574610d0a300d0a0d0a}

test http-connection-1.13 {connection workers resolve installation-relative application files} -setup {
    set docroot [file join [temporaryDirectory] tclwire-relative-file-[pid]]
    file mkdir $docroot
    ::fileutil::writeFile [file join $docroot index.html] relative-file-ok
    set relative_file_config [makeFile [format {
[tclwire]
default_application = "default"
docroot = "%s"
logfile = "%s"

[http]
enabled = true
port = 8990

[http.default]
class = "::tclwire::CApplication"
file = "tcl/application.tcl"
hosts = "localhost"

[http."relative.example.test"]
docroot = "%s"
} $docroot \
   $::tclwire::http_connection_test::logfile \
   $docroot] relative-file-config.toml]
} -body {
    ::tclwire::runtime start [list --config $relative_file_config]
    set response [::tclwire::http_connection_test::request \
        "GET / HTTP/1.1\r\nHost: relative.example.test\r\nConnection: close\r\n\r\n"]
    list \
        [string match "HTTP/1.1 200 OK*" $response] \
        [string match "*relative-file-ok" $response]
} -cleanup {
    ::tclwire::http_connection_test::cleanup
    removeFile $relative_file_config
    file delete -force $docroot
} -result {1 1}

::tclwire::http_connection_test::cleanup
cleanupTests
