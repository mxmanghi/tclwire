package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root
package require tclwire::tpba 0.1

namespace eval ::tclwire::tpba_test {
    variable next_worker_id 0
}

oo::class create ::tclwire::tpba_test::FakeThreadMaster {
    variable maximum_workers
    variable workers
    variable metric_class
    variable metric_options
    variable workloads
    variable eligible
    variable reservations

    constructor {worker_script maximum {family {}}} {
        set maximum_workers $maximum
        set workers [dict create]
        set metric_class ::tclwire::PlainMetric
        set metric_options [dict create]
        set workloads [dict create]
        set eligible {}
        set reservations [dict create]
    }

    method configure_metric {class options} {
        set metric_class $class
        if {$metric_class eq "::tclwire::ConcurrentConnectionMetric"} {
            set metric_options [dict merge [dict create max_conn_per_thread 5] $options]
            set max_conn_per_thread [dict get $metric_options max_conn_per_thread]
            if {![string is integer -strict $max_conn_per_thread] ||
                    $max_conn_per_thread < 1} {
                error "max_conn_per_thread must be an integer greater than or equal to 1"
            }
        } else {
            set metric_options $options
        }
        return $metric_class
    }

    method owns_thread {worker_id} {
        return [dict exists $workers $worker_id]
    }

    method workload_record {worker_id running_workload cumulative_workload} {
        if {$metric_class eq "::tclwire::ConcurrentConnectionMetric"} {
            set combined_workload [expr {
                [dict get $metric_options max_conn_per_thread] *
                $running_workload + $cumulative_workload
            }]
        } else {
            set combined_workload $cumulative_workload
        }
        return [dict create \
            thread_id $worker_id \
            running_workload $running_workload \
            cumulative_workload $cumulative_workload \
            combined_workload $combined_workload]
    }

    method workload_eligible {worker_id} {
        if {![dict exists $workers $worker_id]} {
            return false
        }
        set status [dict get $workers $worker_id]
        if {$metric_class eq "::tclwire::ConcurrentConnectionMetric"} {
            if {$status ni {idle running}} {
                return false
            }
            if {![dict exists $workloads $worker_id running_workload]} {
                return true
            }
            return [expr {
                [dict get $workloads $worker_id running_workload] <
                [dict get $metric_options max_conn_per_thread]
            }]
        }
        return [expr {$status eq "idle"}]
    }

    method refresh_eligibility {worker_id} {
        set index [lsearch -exact $eligible $worker_id]
        if {[my workload_eligible $worker_id]} {
            if {$index < 0} {
                lappend eligible $worker_id
            }
        } elseif {$index >= 0} {
            set eligible [lreplace $eligible $index $index]
        }
        return $eligible
    }

    method acquire_worker {} {
        set selected {}
        set selected_workload {}
        dict for {worker_id status} $workers {
            if {[my workload_eligible $worker_id]} {
                if {[dict exists [my workloads] $worker_id combined_workload]} {
                    set worker_workload \
                        [dict get [my workloads] $worker_id combined_workload]
                } else {
                    set worker_workload 0
                }
                if {$selected eq {} ||
                        $worker_workload < $selected_workload ||
                        ($worker_workload == $selected_workload &&
                            [string compare $worker_id $selected] < 0)} {
                    set selected $worker_id
                    set selected_workload $worker_workload
                }
            }
        }
        if {$selected ne {}} {
            dict set workers $selected allocated
            my refresh_eligibility $selected
            return $selected
        }
        if {[dict size $workers] >= $maximum_workers} {
            return {}
        }

        set worker_id fake-worker-[incr ::tclwire::tpba_test::next_worker_id]
        dict set workers $worker_id allocated
        dict set workloads $worker_id [my workload_record $worker_id 0 0]
        dict set reservations $worker_id 0
        return $worker_id
    }

    method return_thread {worker_id} {
        if {![dict exists $workers $worker_id]} {
            error "unknown fake worker: $worker_id"
        }
        dict set workers $worker_id idle
        my refresh_eligibility $worker_id
        return true
    }

    method remove_thread {worker_id} {
        if {![dict exists $workers $worker_id]} {
            error "unknown fake worker: $worker_id"
        }
        dict unset workers $worker_id
        if {[dict exists $workloads $worker_id]} {
            dict unset workloads $worker_id
        }
        return true
    }

    method thread_ids {{filter all}} {
        set result {}
        dict for {worker_id status} $workers {
            if {$filter eq "all" || $status eq $filter} {
                lappend result $worker_id
            }
        }
        return $result
    }

    method thread_workload_changed {worker_id transition_id} {
        if {![dict exists $workloads $worker_id]} {
            dict set workloads $worker_id [my workload_record $worker_id 0 0]
        }
        set record [dict get $workloads $worker_id]
        switch -exact -- $transition_id {
            thread-start {
            }
            request-processed {
                dict incr record cumulative_workload
                dict set record running_workload 0
                catch {my return_thread $worker_id}
            }
            new-connection-processing {
                dict incr record running_workload
                dict incr record cumulative_workload
                dict incr reservations $worker_id
                dict set workers $worker_id running
            }
            connection-open {
                if {[dict get $reservations $worker_id] < 1} {
                    error "connection-open without a reservation for thread $worker_id"
                }
                dict incr reservations $worker_id -1
                dict set workers $worker_id running
            }
            connection-closed {
                set running_workload [dict get $record running_workload]
                if {$running_workload < 1} {
                    error "connection-closed without workload for thread $worker_id"
                }
                dict set record running_workload [expr {$running_workload - 1}]
                if {[dict get $record running_workload] == 0} {
                    catch {my return_thread $worker_id}
                }
            }
            connection-reservation-cancelled {
                if {[dict get $reservations $worker_id] < 1} {
                    error "connection reservation underflow for thread $worker_id"
                }
                dict incr reservations $worker_id -1
                set running_workload [dict get $record running_workload]
                if {$running_workload < 1} {
                    error "connection reservation has no workload for thread $worker_id"
                }
                dict set record running_workload [expr {$running_workload - 1}]
                if {[dict get $record running_workload] == 0} {
                    catch {my return_thread $worker_id}
                }
            }
            idle-connection-agent {
                dict set record running_workload 0
                catch {my return_thread $worker_id}
            }
            thread-exit {
                dict set workers $worker_id terminating
            }
            default {
                error "unknown test workload transition: $transition_id"
            }
        }
        set record [my workload_record $worker_id \
            [dict get $record running_workload] \
            [dict get $record cumulative_workload]]
        dict set workloads $worker_id $record
        my refresh_eligibility $worker_id
        return $record
    }

    method workloads {} {
        return $workloads
    }

    method resize {maximum} {
        set maximum_workers $maximum
        return $maximum_workers
    }

    method stats {} {
        set per_status [dict create allocated {} idle {} running {} terminating {}]
        dict for {worker_id status} $workers {
            dict lappend per_status $status $worker_id
        }
        return [dict create \
            max_threads_number $maximum_workers \
            live_threads_number [dict size $workers] \
            per_status_lists $per_status \
            workloads $workloads \
            eligible_threads_list $eligible]
    }

    method stop_threads {{filter all}} {
        return
    }
}

proc ::tclwire::tpba_test::new_broker {} {
    return [::tclwire::ThreadPoolsBrokerAgent new \
        -threadmasterfactory ::tclwire::tpba_test::FakeThreadMaster]
}

proc ::tclwire::tpba_test::workload_transition {
    broker worker_id pool_key transition_id
} {
    set response [$broker execute_command [dict create \
        operation thread_workload_changed \
        notification [list $worker_id $pool_key $transition_id]]]
    if {![dict get $response ok]} {
        error [dict get $response error]
    }
    return [dict get $response result]
}

test tpba-1.1 {dispatcher-controlled keys identify independent pools} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:shop {worker script} \
            [dict create maximum_workers 2] \
            [dict create kind application application shop]
        $broker create_pool transport:http {reactor script} \
            [dict create maximum_workers 1] \
            [dict create kind transport endpoint http-main]
        $broker list_pools
    } finally {
        $broker destroy
    }
} -result {app:shop transport:http}

test tpba-1.2 {workers are acquired and released through their pool key} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:shop {worker script} \
            [dict create maximum_workers 1]
        set worker_id [$broker acquire_worker app:shop]
        set exhausted [$broker acquire_worker app:shop]
        set released [$broker release_worker app:shop $worker_id]
        set reacquired [$broker acquire_worker app:shop]
        list [string match fake-worker-* $worker_id] $exhausted $released \
            [expr {$worker_id eq $reacquired}]
    } finally {
        $broker destroy
    }
} -result {1 {} true 1}

test tpba-1.2.1 {workers can remove themselves from their pool key} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:shop {worker script} \
            [dict create maximum_workers 1]
        set worker_id [$broker acquire_worker app:shop]
        set removed [$broker remove_worker app:shop $worker_id]
        set reacquired [$broker acquire_worker app:shop]
        list \
            $removed \
            [expr {$worker_id ne $reacquired}] \
            [dict get [$broker pool_status app:shop] stats live_threads_number]
    } finally {
        $broker destroy
    }
} -result {true 1 1}

test tpba-1.2.2 {dictionary command API removes workers from pools} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:docs {worker script} \
            [dict create maximum_workers 1]
        set acquire_response [$broker execute_command [dict create \
            operation acquire_worker \
            pool_key app:docs]]
        set worker_id [dict get $acquire_response result]
        set remove_response [$broker execute_command [dict create \
            operation remove_worker \
            pool_key app:docs \
            worker_id $worker_id]]
        list \
            [dict get $remove_response ok] \
            [dict get $remove_response result] \
            [dict get [$broker pool_status app:docs] stats live_threads_number]
    } finally {
        $broker destroy
    }
} -result {1 true 0}

test tpba-1.2.3 {dictionary command API reports thread ids for a pool key} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:docs {worker script} \
            [dict create maximum_workers 2]
        set first [$broker acquire_worker app:docs]
        set second [$broker acquire_worker app:docs]
        $broker release_worker app:docs $first
        set all_response [$broker execute_command [dict create \
            operation pool_thread_ids \
            pool_key app:docs]]
        set idle_response [$broker execute_command [dict create \
            operation pool_thread_ids \
            pool_key app:docs \
            filter idle]]
        list \
            [dict get $all_response ok] \
            [expr {[dict get $all_response result] eq [list $first $second]}] \
            [expr {[dict get $idle_response result] eq [list $first]}]
    } finally {
        $broker destroy
    }
} -result {1 1 1}

test tpba-1.3 {pool status retains descriptor policy and aggregate stats} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:admin {worker script} \
            [dict create minimum_workers 1 maximum_workers 3] \
            [dict create kind application application admin]
        set status [$broker pool_status app:admin]
        list \
            [dict get $status pool_key] \
            [dict get $status descriptor application] \
            [dict get $status policy maximum_workers] \
            [dict get $status stats live_threads_number] \
            [dict get $status lifecycle_state]
    } finally {
        $broker destroy
    }
} -result {app:admin admin 3 1 active}

test tpba-1.4 {resize updates both policy and ThreadMaster limit} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool protocol:http {worker script} \
            [dict create maximum_workers 2]
        $broker resize_pool protocol:http [dict create maximum_workers 5]
        set status [$broker pool_status protocol:http]
        list \
            [dict get $status policy maximum_workers] \
            [dict get $status stats max_threads_number]
    } finally {
        $broker destroy
    }
} -result {5 5}

test tpba-1.5 {dictionary command API preserves correlation identifiers} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        set create_response [$broker execute_command [dict create \
            correlation_id request-1 \
            operation create_pool \
            pool_key app:docs \
            worker_script {worker script}]]
        set list_response [$broker execute_command [dict create \
            correlation_id request-2 \
            operation list_pools]]
        list \
            [dict get $create_response ok] \
            [dict get $create_response correlation_id] \
            [dict get $list_response result]
    } finally {
        $broker destroy
    }
} -result {1 request-1 app:docs}

test tpba-1.6 {dictionary command API returns structured failures} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        set response [$broker execute_command [dict create \
            correlation_id request-3 \
            operation acquire_worker \
            pool_key missing]]
        list \
            [dict get $response ok] \
            [dict get $response correlation_id] \
            [dict get $response error]
    } finally {
        $broker destroy
    }
} -result {0 request-3 {unknown thread pool: missing}}

test tpba-1.7 {stopped pools reject further allocation and resizing} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:stopped {worker script}
        $broker shutdown_pool app:stopped
        set acquire_error [catch {$broker acquire_worker app:stopped} acquire_message]
        set resize_error [catch {$broker resize_pool app:stopped 2} resize_message]
        list $acquire_error $acquire_message $resize_error $resize_message
    } finally {
        $broker destroy
    }
} -result [list \
    1 {thread pool is not active: app:stopped} \
    1 {thread pool is not active: app:stopped}]

test tpba-1.8 {connection-agent descriptors produce canonical pool keys} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        list \
            [$broker pool_key [dict create \
                kind connection_agent protocol HTTP]] \
            [$broker create_pool {} {worker script} {} [dict create \
                kind connection_agent protocol ftp]]
    } finally {
        $broker destroy
    }
} -result {connection:http connection:ftp}

test tpba-1.9 {command API derives a connection-agent pool key} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        set response [$broker execute_command [dict create \
            operation pool_key \
            descriptor [dict create kind connection_agent protocol http]]]
        list [dict get $response ok] [dict get $response result]
    } finally {
        $broker destroy
    }
} -result {1 connection:http}

test tpba-1.10 {workers notify plain workload transitions through TPBA} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:metrics {worker script} \
            [dict create maximum_workers 1] \
            [dict create kind application application metrics]
        set worker_id [$broker acquire_worker app:metrics]
        set reported [::tclwire::tpba_test::workload_transition \
            $broker $worker_id app:metrics request-processed]
        set status [$broker pool_status app:metrics]
        list \
            [dict get $reported running_workload] \
            [dict get $reported cumulative_workload] \
            [dict get $reported combined_workload] \
            [dict get $status stats workloads $worker_id combined_workload]
    } finally {
        $broker destroy
    }
} -result {0 1 1 1}

test tpba-1.11 {connection pools use concurrent connection workload metric} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool connection:http {worker script} \
            [dict create maximum_workers 1] \
            [dict create kind connection_agent protocol http]
        set worker_id [$broker acquire_worker connection:http]
        ::tclwire::tpba_test::workload_transition \
            $broker $worker_id connection:http new-connection-processing
        ::tclwire::tpba_test::workload_transition \
            $broker $worker_id connection:http connection-open
        ::tclwire::tpba_test::workload_transition \
            $broker $worker_id connection:http new-connection-processing
        set reported [::tclwire::tpba_test::workload_transition \
            $broker $worker_id connection:http connection-open]
        dict get $reported combined_workload
    } finally {
        $broker destroy
    }
} -result 12

test tpba-1.11.0 {connection pools select running workers below connection limit} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool connection:http {worker script} \
            [dict create maximum_workers 1 max_conn_per_thread 2] \
            [dict create kind connection_agent protocol http]
        set first [$broker acquire_worker connection:http]
        ::tclwire::tpba_test::workload_transition \
            $broker $first connection:http new-connection-processing
        ::tclwire::tpba_test::workload_transition \
            $broker $first connection:http connection-open
        set second [$broker acquire_worker connection:http]
        ::tclwire::tpba_test::workload_transition \
            $broker $second connection:http new-connection-processing
        ::tclwire::tpba_test::workload_transition \
            $broker $second connection:http connection-open
        set exhausted [$broker acquire_worker connection:http]
        list [expr {$first eq $second}] $exhausted
    } finally {
        $broker destroy
    }
} -result {1 {}}

test tpba-1.11.0a {connection processing reservations count against the connection limit} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool connection:http {worker script} \
            [dict create maximum_workers 1 max_conn_per_thread 1] \
            [dict create kind connection_agent protocol http]
        set worker_id [$broker acquire_worker connection:http]
        ::tclwire::tpba_test::workload_transition \
            $broker $worker_id connection:http new-connection-processing
        set exhausted [$broker acquire_worker connection:http]
        ::tclwire::tpba_test::workload_transition \
            $broker $worker_id connection:http connection-open
        set status [$broker pool_status connection:http]
        list $exhausted \
            [dict get $status stats workloads $worker_id running_workload] \
            [dict get $status stats workloads $worker_id cumulative_workload]
    } finally {
        $broker destroy
    }
} -result {{} 1 1}

test tpba-1.11.1 {connection metric validates max_conn_per_thread} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        catch {
            $broker create_pool connection:bad {worker script} \
                [dict create maximum_workers 1 max_conn_per_thread 0] \
                [dict create kind connection_agent protocol bad]
        } message
        set message
    } finally {
        $broker destroy
    }
} -result {max_conn_per_thread must be an integer greater than or equal to 1}

test tpba-1.12 {idle allocation selects the lowest combined workload} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:balanced {worker script} \
            [dict create maximum_workers 2] \
            [dict create kind application application balanced]
        set first [$broker acquire_worker app:balanced]
        set second [$broker acquire_worker app:balanced]
        for {set i 0} {$i < 10} {incr i} {
            ::tclwire::tpba_test::workload_transition \
                $broker $first app:balanced request-processed
        }
        ::tclwire::tpba_test::workload_transition \
            $broker $second app:balanced request-processed
        $broker release_worker app:balanced $first
        $broker release_worker app:balanced $second
        set selected [$broker acquire_worker app:balanced]
        expr {$selected eq $second}
    } finally {
        $broker destroy
    }
} -result 1

test tpba-1.13 {workload notifications validate pool ownership} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        $broker create_pool app:owned {worker script} \
            [dict create maximum_workers 1] \
            [dict create kind application application owned]
        catch {::tclwire::tpba_test::workload_transition \
            $broker missing-worker app:owned request-processed} message
        set message
    } finally {
        $broker destroy
    }
} -result {Thread missing-worker is not owned by pool app:owned}

test tpba-1.14 {workload notifications require strict three-field form} -body {
    set broker [::tclwire::tpba_test::new_broker]
    try {
        set response [$broker execute_command [dict create \
            operation thread_workload_changed \
            notification [list worker app:owned]]]
        set message [dict get $response error]
        set message
    } finally {
        $broker destroy
    }
} -result {workload notification must be {thread_id pool_key transition_id}}

cleanupTests
