    catch {::tclwire::chores::ContextFileChore destroy}
    removeFile context-file-chore.tcl
} -result {context_application_chore app app:app}

test chore-1.3 {diagnostic chore runs probes in scheduler} -body {
    set config [dict create \
        diagnostics_interval_ms 100 \
        diagnostics_watchdog_max_age_ms 1000]
    set specs [::tclwire::diagnostics::default_chore_specs $config]
    ::tsv::set tclwire diagnostics_heartbeat [dict create \
        sequence 1 \
        now_ms [clock milliseconds] \
        main_thread_id [::thread::id]]
    ::tclwire::chore start [dict create chore_interval_ms 100]
    ::tclwire::chore register $specs
    set deadline [expr {[clock milliseconds] + 1000}]
    set status {}
    while {[clock milliseconds] < $deadline} {
        set status [::tclwire::chore status]
        set chore [lindex [dict get $status chores] 0]
        if {[dict get $chore status runs] >= 1} {
            break
        }
        after 20
    }
    set rows [::tclwire::diagnostics rows]
    ::tclwire::chore stop
    set chore [lindex [dict get $status chores] 0]
    set found_event_loop 0
    set found_accounting 0
    foreach row $rows {
        if {[dict get $row probe] eq "event_loop" &&
                [dict get $row metric] eq "samples"} {
            set found_event_loop 1
        }
        if {[dict get $row probe] eq "accounting" &&
                [dict get $row metric] eq "threads"} {
            set found_accounting 1
        }
    }
    list \
        [dict get $chore name] \
        [dict exists $chore mode] \
        [expr {[dict get $chore status runs] >= 1}] \
        [dict get $chore last_status ok] \
        [dict get $chore last_status result ok] \
        [dict exists [dict get $chore last_status result snapshot] probes event_loop] \
        [dict exists [dict get $chore last_status result snapshot] probes accounting] \
        [dict exists [dict get $chore last_status result snapshot] probes tpba] \
        $found_event_loop \
        $found_accounting
} -cleanup {
    ::tclwire::chore_test::cleanup
} -result {diagnostics 0 1 1 1 1 1 1 1 1}

test chore-1.4 {file-backed chore infers concrete class} -setup {
    set chore_file [makeFile [string map [list @KEY@ chore_test_events] {
package require tclwire::chore 0.1
catch {::tclwire::chores::FileBackedChore destroy}
oo::class create FileBackedChore {
    superclass ::tclwire::Chore

    method run {wakeup} {
        set record [dict create name [my name] \
            sequence [dict get $wakeup sequence] \
            thread_id [::thread::id]]
        ::tsv::lappend tclwire @KEY@ $record
        return $record
    }
}
}] file-backed-chore.tcl]
} -body {
    ::tclwire::chore start [dict create chore_interval_ms 100]
    ::tclwire::chore register [list [dict create \
        name file_backed_test \
        file $chore_file]]
    set deadline [expr {[clock milliseconds] + 1000}]
    set events {}
    while {[clock milliseconds] < $deadline} {
        catch {set events [::tsv::get tclwire chore_test_events]}
        if {[llength $events] >= 1} {
            break
        }
        after 20
    }
    set status [::tclwire::chore status]
    ::tclwire::chore stop
    set chore [lindex [dict get $status chores] 0]
    list \
        [dict get $chore class] \
        [dict get [lindex $events 0] name] \
        [expr {[dict get $chore status runs] >= 1}]
} -cleanup {
    ::tclwire::chore_test::cleanup
    catch {::tclwire::chores::FileBackedChore destroy}
    removeFile file-backed-chore.tcl
} -result {::tclwire::chores::FileBackedChore file_backed_test 1}

test chore-1.5 {file-backed chore source is loaded once for repeated specs} -setup {
    set chore_file [makeFile [string map [list @KEY@ chore_test_events] {
package require tclwire::chore 0.1
oo::class create RepeatedFileChore {
    superclass ::tclwire::Chore

    method run {wakeup} {
        set record [dict create name [my name] \
            sequence [dict get $wakeup sequence] \
            thread_id [::thread::id]]
        ::tsv::lappend tclwire @KEY@ $record
        return $record
    }
}
}] repeated-file-chore.tcl]
} -body {
    ::tclwire::chore start [dict create chore_interval_ms 100]
    ::tclwire::chore register [list \
        [dict create name repeated_first file $chore_file] \
        [dict create name repeated_second file $chore_file]]
    set status [::tclwire::chore status]
    set classes [lmap chore [dict get $status chores] {
        dict get $chore class
    }]
    ::tclwire::chore stop
    list \
        [llength $classes] \
        [lsort -unique $classes]
} -cleanup {
    ::tclwire::chore_test::cleanup
    catch {::tclwire::chores::RepeatedFileChore destroy}
    removeFile repeated-file-chore.tcl
} -result {2 ::tclwire::chores::RepeatedFileChore}

cleanupTests
