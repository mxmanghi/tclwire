package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::chore 0.1
package require tclwire::diagnostics 0.1

namespace eval ::tclwire::chore_test {
    proc cleanup {} {
        catch {::tclwire::chore stop}
        catch {::tsv::unset tclwire chore_test_events}
        catch {::tsv::set tclwire diagnostics_heartbeat {}}
        catch {::tsv::set tclwire diagnostics_snapshot {}}
    }
}

::tclwire::chore_test::cleanup

test chore-1.1 {runner fires registered chores with wakeup sequence} -body {
    set specs [list \
        [dict create \
            name every_tick_test \
            package tclwire::chore \
            class ::tclwire::TsvRecordingChore \
            args [list -key chore_test_events -every 1]] \
        [dict create \
            name every_other_tick_test \
            package tclwire::chore \
            class ::tclwire::TsvRecordingChore \
            args [list -key chore_test_events -every 2] \
            mode async]]
    ::tclwire::chore start [dict create chore_interval_ms 100]
    ::tclwire::chore register $specs
    set deadline [expr {[clock milliseconds] + 2000}]
    set events {}
    while {[clock milliseconds] < $deadline} {
        catch {set events [::tsv::get tclwire chore_test_events]}
        set sync_count 0
        set async_count 0
        foreach event $events {
            if {[dict get $event name] eq "every_tick_test"} {
                incr sync_count
            }
            if {[dict get $event name] eq "every_other_tick_test"} {
                incr async_count
            }
        }
        if {$sync_count >= 2 && $async_count >= 1} {
            break
        }
        after 20
    }
    set status [::tclwire::chore status]
    ::tclwire::chore stop
    set sync_threads {}
    set async_threads {}
    foreach event $events {
        if {[dict get $event name] eq "every_tick_test"} {
            lappend sync_threads [dict get $event thread_id]
        }
        if {[dict get $event name] eq "every_other_tick_test"} {
            lappend async_threads [dict get $event thread_id]
        }
    }
    set chore_statuses {}
    set has_mode 0
    foreach chore [dict get $status chores] {
        lappend chore_statuses [dict get $chore status]
        if {[dict exists $chore mode]} {
            set has_mode 1
        }
    }
    list \
        [dict get $status running] \
        [expr {[dict get $status sequence] >= 2}] \
        [expr {[llength $sync_threads] >= 2}] \
        [expr {[llength $async_threads] >= 1}] \
        [expr {[lindex $sync_threads 0] eq [lindex $async_threads 0]}] \
        $has_mode \
        [expr {[dict get [lindex $chore_statuses 0] runs] >= 2}]
} -cleanup {
    ::tclwire::chore_test::cleanup
} -result {1 1 1 1 1 0 1}

test chore-1.2 {base chore class is abstract} -body {
    ::tclwire::Chore new
} -returnCodes error -match glob -result "*abstract*"

test chore-1.2a {application chore stores immutable context handles} -body {
    oo::class create ::tclwire::chore_test::ContextChore {
        superclass ::tclwire::ApplicationChore
        method run {wakeup} {
            return [dict create \
                application_id [my application_id] \
                application_config [my application_config] \
                pool_key [my pool_key]]
        }
    }
    set envelope [dict create \
        type tclwire.application_configuration \
        version 1 \
        application_id app \
        values [dict create]]
    set chore [::tclwire::chore_test::ContextChore new \
        -name application:app \
        -applicationid app \
        -applicationconfig $envelope \
        -poolkey app:app]
    set result [$chore run [dict create]]
    $chore destroy
    list \
        [dict get $result application_id] \
        [dict get $result application_config] \
        [dict get $result pool_key]
} -cleanup {
    catch {::tclwire::chore_test::ContextChore destroy}
    ::tclwire::chore_test::cleanup
} -result [list app [dict create \
    type tclwire.application_configuration \
    version 1 \
    application_id app \
    values [dict create]] app:app]

test chore-1.2aa {server chore stores server configuration envelope} -body {
    oo::class create ::tclwire::chore_test::ServerContextChore {
        superclass ::tclwire::ServerChore
        method run {wakeup} {
            return [my server_config]
        }
    }
    set envelope [dict create \
        type tclwire.server_configuration \
        version 1 \
        values [dict create host 127.0.0.1]]
    set chore [::tclwire::chore_test::ServerContextChore new \
        -name server:default \
        -serverconfig $envelope]
    set result [$chore run [dict create]]
    $chore destroy
    list \
        [dict get $result type] \
        [dict get $result version] \
        [dict get $result values host]
} -cleanup {
    catch {::tclwire::chore_test::ServerContextChore destroy}
    ::tclwire::chore_test::cleanup
} -result {tclwire.server_configuration 1 127.0.0.1}

test chore-1.2ab {server chore context is injected for opt-in subclasses} -setup {
    set chore_file [makeFile [string map [list @KEY@ chore_test_events] {
package require tclwire::chore 0.1
oo::class create ServerContextFileChore {
    superclass ::tclwire::ServerChore

    method run {wakeup} {
        set config [my server_config]
        set record [dict create \
            name [my name] \
            type [dict get $config type] \
            host [dict get $config values host]]
        ::tsv::lappend tclwire @KEY@ $record
        return $record
    }
}
}] server-context-file-chore.tcl]
} -body {
    set spec [dict create \
        name server_context_chore \
        file $chore_file \
        server_context [dict create \
            type tclwire.server_configuration \
            version 1 \
            values [dict create host 127.0.0.1]]]
    ::tclwire::chore start [dict create chore_interval_ms 100]
    ::tclwire::chore register [list $spec]
    set deadline [expr {[clock milliseconds] + 1000}]
    set events {}
    while {[clock milliseconds] < $deadline} {
        catch {set events [::tsv::get tclwire chore_test_events]}
        if {[llength $events] >= 1} {
            break
        }
        after 20
    }
    ::tclwire::chore stop
    list \
        [dict get [lindex $events 0] name] \
        [dict get [lindex $events 0] type] \
        [dict get [lindex $events 0] host]
} -cleanup {
    ::tclwire::chore_test::cleanup
    catch {::tclwire::chores::ServerContextFileChore destroy}
    removeFile server-context-file-chore.tcl
} -result {server_context_chore tclwire.server_configuration 127.0.0.1}

test chore-1.2b {plain chores ignore scheduler application context} -body {
    set spec [dict create \
        name plain_application_chore \
        package tclwire::chore \
        class ::tclwire::TsvRecordingChore \
        args [list -key chore_test_events] \
        application_context [dict create \
            application_id app \
            application_config [dict create] \
            pool_key app:app]]
    ::tclwire::chore start [dict create chore_interval_ms 100]
    ::tclwire::chore register [list $spec]
    set deadline [expr {[clock milliseconds] + 1000}]
    set events {}
    while {[clock milliseconds] < $deadline} {
        catch {set events [::tsv::get tclwire chore_test_events]}
        if {[llength $events] >= 1} {
            break
        }
        after 20
    }
    set status [::tclwire::chore status]
    ::tclwire::chore stop
    set chore [lindex [dict get $status chores] 0]
    list \
        [dict get [lindex $events 0] name] \
        [dict exists $chore application_context] \
        [expr {[dict get $chore status runs] >= 1}]
} -cleanup {
    ::tclwire::chore_test::cleanup
} -result {plain_application_chore 0 1}

test chore-1.2c {application chore context is injected for opt-in subclasses} -setup {
    set chore_file [makeFile [string map [list @KEY@ chore_test_events] {
package require tclwire::chore 0.1
oo::class create ContextFileChore {
    superclass ::tclwire::ApplicationChore

    method run {wakeup} {
        set record [dict create \
            name [my name] \
