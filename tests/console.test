package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require json
package require fileutil
package require tclwire::console::protocol 0.1

test console-protocol-1.1 {PS returns thread accounting rows as JSON table} -body {
    set thread_id console-test-thread
    catch {::tclwire::accounting remove_thread $thread_id}
    try {
        ::tclwire::accounting register_thread $thread_id running http
        ::tclwire::accounting update_thread_workload $thread_id \
            [dict create running_workload 2 cumulative_workload 7 \
                         combined_workload 17]
        ::tclwire::accounting change_thread_status $thread_id running test-command
        after 2
        ::tclwire::accounting change_thread_status $thread_id idle
        set response [::json::json2dict [::tclwire::console dispatch PS]]
        set rows [dict get $response rows]
        set found 0
        foreach row $rows {
            if {[dict get $row thread_id] eq $thread_id} {
                set found [expr {
                    [dict get $row status] eq "idle" &&
                    [dict get $row family] eq "http" &&
                    [dict get $row running_workload] == 2 &&
                    [dict get $row cumulative_workload] == 7 &&
                    [string is integer -strict [dict get $row run_time_ms]] &&
                    [dict get $row run_time_ms] >= 0 &&
                    [dict get $row command] eq "test-command"
                }]
            }
        }
        list \
            [dict get $response ok] \
            [dict get $response type] \
            [dict get $response command] \
            [expr {"nruns" ni [dict get $response columns]}] \
            [expr {"running_workload" in [dict get $response columns]}] \
            [expr {"cumulative_workload" in [dict get $response columns]}] \
            [expr {"combined_workload" ni [dict get $response columns]}] \
            [expr {"last_run_end" ni [dict get $response columns]}] \
            [expr {"run_time_ms" in [dict get $response columns]}] \
            $found
    } finally {
        ::tclwire::accounting remove_thread $thread_id
    }
} -result {true table PS 1 1 1 1 1 1 1}

test console-protocol-1.1a {PS rows are sorted by family and thread id} -body {
    set thread_ids {
        console-sort-http-z
        console-sort-app-b
        console-sort-http-a
        console-sort-app-a
    }
    foreach thread_id $thread_ids {
        catch {::tclwire::accounting remove_thread $thread_id}
    }
    try {
        ::tclwire::accounting register_thread console-sort-http-z running http
        ::tclwire::accounting register_thread console-sort-app-b running application
        ::tclwire::accounting register_thread console-sort-http-a running http
        ::tclwire::accounting register_thread console-sort-app-a running application
        set response [::json::json2dict [::tclwire::console dispatch PS]]
        set selected {}
        foreach row [dict get $response rows] {
            set thread_id [dict get $row thread_id]
            if {$thread_id in $thread_ids} {
                lappend selected [list \
                    [dict get $row family] \
                    $thread_id]
            }
        }
        set selected
    } finally {
        foreach thread_id $thread_ids {
            catch {::tclwire::accounting remove_thread $thread_id}
        }
    }
} -result {{application console-sort-app-a} {application console-sort-app-b} {http console-sort-http-a} {http console-sort-http-z}}

test console-protocol-1.1b {PS filters rows by family} -body {
    set thread_ids {
        console-filter-http
        console-filter-application
        console-filter-ftp
    }
    foreach thread_id $thread_ids {
        catch {::tclwire::accounting remove_thread $thread_id}
    }
    try {
        ::tclwire::accounting register_thread console-filter-http running http
        ::tclwire::accounting register_thread console-filter-application running application
        ::tclwire::accounting register_thread console-filter-ftp running ftp
        set response [::json::json2dict \
            [::tclwire::console dispatch {PS -family APPLICATION}]]
        set selected {}
        foreach row [dict get $response rows] {
            set thread_id [dict get $row thread_id]
            if {$thread_id in $thread_ids} {
                lappend selected [list \
                    [dict get $row family] \
                    $thread_id]
            }
        }
        list \
            [dict get $response ok] \
            [dict get $response command] \
            $selected
    } finally {
        foreach thread_id $thread_ids {
            catch {::tclwire::accounting remove_thread $thread_id}
        }
    }
} -result {true PS {{application console-filter-application}}}

test console-protocol-1.1c {PS rejects invalid family filter arguments} -body {
    set missing [::json::json2dict \
        [::tclwire::console dispatch {PS -family}]]
    set unknown [::json::json2dict \
        [::tclwire::console dispatch {PS -status running}]]
    list \
        [dict get $missing ok] \
        [dict get $missing error code] \
        [dict get $missing error message] \
        [dict get $unknown ok] \
        [dict get $unknown error code] \
        [dict get $unknown error message]
} -result {false bad_arguments {missing value after -family} false bad_arguments {unknown PS option: -status}}

test console-protocol-1.2 {CONN returns and filters connection rows} -body {
    set first console-http#1
    set second console-ftp#2
    foreach key [list $first $second] {
        catch {::tclwire::accounting remove_connection $key}
    }
    try {
        ::tclwire::accounting record_connection_opened $first \
            [dict create connection_id 1 protocol http service_id http:8990 \
                         listener_port 8990 peer_host 127.0.0.1]
        ::tclwire::accounting record_connection_opened $second \
            [dict create connection_id 2 protocol ftp service_id ftp:2121 \
                         listener_port 2121 peer_host 192.0.2.10]
        set all [::json::json2dict [::tclwire::console dispatch CONN]]
        set port [::json::json2dict \
            [::tclwire::console dispatch {CONN -port 8990}]]
        set remote [::json::json2dict \
            [::tclwire::console dispatch {CONN -remote 192.0.2.10}]]
        list \
            [dict get $all ok] \
            [expr {"closed_at" ni [dict get $all columns]}] \
            [dict get $all configuration debug_connection] \
            [llength [dict get $port rows]] \
            [dict get [lindex [dict get $port rows] 0] connection_key] \
            [llength [dict get $remote rows]] \
            [dict get [lindex [dict get $remote rows] 0] connection_key]
    } finally {
        ::tclwire::accounting remove_connection $first
        ::tclwire::accounting remove_connection $second
    }
} -result {true 1 false 1 console-http#1 1 console-ftp#2}

test console-protocol-1.2a {CONN debug view includes retained closed connection diagnostics} -body {
    set connection_key console-http#debug
    catch {::tclwire::accounting remove_connection $connection_key}
    ::tclwire::accounting configure_debug_connection 1
    try {
        ::tclwire::accounting record_connection_opened $connection_key \
            [dict create connection_id 3 protocol http service_id http:8990 \
                         listener_port 8990 peer_host 127.0.0.1]
        ::tclwire::accounting record_connection_closed $connection_key \
            [dict create status failed close_reason test_failed \
                         transport_error test_error]
        ::tclwire::accounting configure_debug_connection 0
        set normal [::json::json2dict [::tclwire::console dispatch CONN]]
        ::tclwire::accounting configure_debug_connection 1
        set debug [::json::json2dict \
            [::tclwire::console dispatch {CONN -port 8990}]]
        set row [lindex [dict get $debug rows] 0]
        list \
            [expr {"closed_at" ni [dict get $normal columns]}] \
            [llength [dict get $normal rows]] \
            [expr {"closed_at" in [dict get $debug columns]}] \
            [dict get $debug configuration debug_connection] \
            [llength [dict get $debug rows]] \
            [dict get $row connection_key] \
            [dict get $row status] \
            [dict get $row close_reason] \
            [dict get $row transport_error]
    } finally {
        catch {::tclwire::accounting remove_connection $connection_key}
        ::tclwire::accounting configure_debug_connection 0
    }
} -result {1 0 1 true 1 console-http#debug failed test_failed test_error}

test console-protocol-1.2b {SERVERCONF returns global service and host configuration rows} -body {
    ::tclwire::console configure [dict create \
        debug_connection 1 \
        host 127.0.0.1 \
        services [list [dict create protocol http port 8990 id http:8990]] \
        applications [dict create default [dict create \
            hosts {localhost 127.0.0.1} docroot /tmp/tclwire encoding utf-8]]]
    try {
        set response [::json::json2dict [::tclwire::console dispatch SERVERCONF]]
        set rows [dict get $response rows]
        set found_global 0
        set found_service 0
        set found_host 0
        foreach row $rows {
            if {[dict get $row scope] eq "global" &&
                    [dict get $row name] eq "debug_connection" &&
                    [dict get $row value] == 1} {
                set found_global 1
            }
            if {[dict get $row scope] eq "service:http:8990" &&
                    [dict get $row name] eq "protocol" &&
                    [dict get $row value] eq "http"} {
                set found_service 1
            }
            if {[dict get $row scope] eq "host:localhost" &&
                    [dict get $row name] eq "docroot" &&
                    [dict get $row value] eq "/tmp/tclwire"} {
                set found_host 1
            }
        }
        list \
            [dict get $response ok] \
            [dict get $response configuration debug_connection] \
            [dict get $response columns] \
            $found_global \
            $found_service \
            $found_host
    } finally {
        ::tclwire::console configure {}
    }
} -result {true true {scope name value} 1 1 1}

test console-protocol-1.2c {CWORK returns connection worker workload rows} -body {
    set worker_id console-worker-thread
    set ftp_worker_id console-ftp-worker-thread
    set app_worker_id console-app-thread
    set first console-http#worker-1
    set second console-http#worker-2
    foreach thread_id [list $worker_id $ftp_worker_id $app_worker_id] {
        catch {::tclwire::accounting remove_thread $thread_id}
    }
    foreach key [list $first $second] {
        catch {::tclwire::accounting remove_connection $key}
    }
    try {
        ::tclwire::accounting register_thread $worker_id running http
        ::tclwire::accounting update_thread_workload $worker_id \
            [dict create running_workload 2 cumulative_workload 9 \
                         combined_workload 19]
        ::tclwire::accounting register_thread $ftp_worker_id idle ftp
        ::tclwire::accounting update_thread_workload $ftp_worker_id \
            [dict create running_workload 0 cumulative_workload 3 \
                         combined_workload 3]
        ::tclwire::accounting register_thread $app_worker_id idle application
        ::tclwire::accounting update_thread_workload $app_worker_id \
            [dict create running_workload 0 cumulative_workload 4 \
                         combined_workload 4]
        ::tclwire::accounting record_connection_opened $first \
            [dict create connection_id 1 protocol http service_id http:8990 \
                         listener_port 8990 worker_thread_id $worker_id]
        ::tclwire::accounting record_connection_opened $second \
            [dict create connection_id 2 protocol http service_id http:8990 \
                         listener_port 8990 worker_thread_id $worker_id]
        set response [::json::json2dict [::tclwire::console dispatch CWORK]]
        set rows [dict get $response rows]
        set found 0
        set excluded 1
        set selected {}
        foreach row $rows {
            if {[dict get $row worker_id] in [list $worker_id $ftp_worker_id]} {
                lappend selected [list \
                    [dict get $row family] \
                    [dict get $row worker_id]]
            }
            if {[dict get $row worker_id] eq $worker_id} {
                set found [expr {
                    [dict get $row connection_state] eq "active" &&
                    [dict get $row family] eq "http" &&
                    [dict get $row active_connections] == 2 &&
                    [dict get $row cumulative_connections] == 9 &&
                    [dict get $row combined_workload] == 19 &&
                    [string match "*$first*" [dict get $row connection_keys]] &&
                    [string match "*$second*" [dict get $row connection_keys]]
                }]
            }
            if {[dict get $row worker_id] eq $app_worker_id} {
                set excluded 0
            }
        }
        list \
            [dict get $response ok] \
            [dict get $response command] \
            [dict get $response columns] \
            $found \
            $excluded \
            $selected
    } finally {
        foreach thread_id [list $worker_id $ftp_worker_id $app_worker_id] {
            catch {::tclwire::accounting remove_thread $thread_id}
        }
        foreach key [list $first $second] {
            catch {::tclwire::accounting remove_connection $key}
        }
    }
} -result {true CWORK {worker_id connection_state family active_connections cumulative_connections combined_workload connection_keys} 1 1 {{ftp console-ftp-worker-thread} {http console-worker-thread}}}

test console-protocol-1.2d {SERVICES returns configured service rows} -body {
    ::tclwire::console configure [dict create \
        services [list \
            [dict create protocol http port 8990 id http:8990 \
                description "HTTP application service"] \
            [dict create protocol ftp port 2121 id ftp:2121 \
                description "FTP file transfer service"]] \
        applications [dict create]]
    try {
        set response [::json::json2dict [::tclwire::console dispatch SERVICES]]
        set rows [dict get $response rows]
        list \
            [dict get $response ok] \
            [dict get $response command] \
            [dict get $response columns] \
            [dict get [lindex $rows 0] service_id] \
            [dict get [lindex $rows 0] port] \
            [dict get [lindex $rows 0] description] \
            [dict get [lindex $rows 1] service_id] \
            [dict get [lindex $rows 1] description]
    } finally {
        ::tclwire::console configure {}
    }
} -result {true SERVICES {service_id protocol port description} http:8990 8990 {HTTP application service} ftp:2121 {FTP file transfer service}}

test console-protocol-1.3 {console command errors use JSON error shape} -body {
    set response [::json::json2dict [::tclwire::console dispatch {CONN -bad x}]]
    set error [dict get $response error]
    list \
        [dict get $response ok] \
        [dict get $response type] \
        [dict get $response command] \
        [dict get $error code] \
        [dict exists $error message]
} -result {false error CONN bad_arguments 1}

test console-protocol-1.4 {SHUT returns conventional OK JSON} -body {
    set response [::json::json2dict [::tclwire::console dispatch SHUT]]
    list \
        [dict get $response ok] \
        [dict get $response type] \
        [dict get $response command] \
        [dict get $response message]
} -result {true ok SHUT {shutdown requested}}

test console-protocol-1.4a {DIAG returns runtime diagnostic rows} -body {
    set response [::json::json2dict [::tclwire::console dispatch DIAG]]
    set row [lindex [dict get $response rows] 0]
    list \
        [dict get $response ok] \
        [dict get $response type] \
        [dict get $response command] \
        [dict get $response columns] \
        [dict get $row probe] \
        [dict get $row metric] \
        [dict get $row value]
} -result {true table DIAG {probe metric value} runtime enabled 0}

test console-protocol-1.5 {LOGROTATE reopens logger files and returns OK} -body {
    set logfile [file join [temporaryDirectory] tclwire-console-rotate-[pid].log]
    set logerr [file join [temporaryDirectory] tclwire-console-rotate-[pid].err]
    catch {::tclwire::logger stop}
    catch {file delete -force $logfile $logerr "$logfile.1" "$logerr.1"}
    try {
        ::tclwire::logger start [dict create logfile $logfile logerr $logerr]
        ::tclwire::logger write before-console-rotate
        file rename -force $logfile "$logfile.1"
        set response [::json::json2dict \
            [::tclwire::console dispatch LOGROTATE]]
        ::tclwire::logger write after-console-rotate
        ::tclwire::logger stop
        list \
            [dict get $response ok] \
            [dict get $response type] \
            [dict get $response command] \
            [dict get $response message] \
            [string match {*before-console-rotate*} \
                [::fileutil::cat "$logfile.1"]] \
            [string match {*after-console-rotate*} \
                [::fileutil::cat $logfile]]
    } finally {
        catch {::tclwire::logger stop}
        catch {file delete -force $logfile $logerr "$logfile.1" "$logerr.1"}
    }
} -result {true ok LOGROTATE {logs reopened} 1 1}

cleanupTests
