package require tcltest
package require fileutil
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::runtime 0.1

namespace eval ::tclwire::runtime_test {
    variable logfile [file join [temporaryDirectory] tclwire-runtime-[pid].log]
    variable logerr [file join [temporaryDirectory] tclwire-runtime-[pid].err]
    variable config_files {}

    proc cleanup {} {
        variable logfile
        variable logerr
        variable config_files
        catch {::tclwire::runtime stop}
        catch {file delete -force $logfile}
        catch {file delete -force $logerr}
        foreach path $config_files {
            catch {file delete -force $path}
        }
        set config_files {}
    }

    proc make_config {contents} {
        variable config_files
        set directory [file join [temporaryDirectory] tclwire-config-[pid]]
        file mkdir $directory
        set path [file join $directory tclwire.toml]
        set channel [open $path w]
        puts -nonewline $channel $contents
        close $channel
        lappend config_files $directory
        return $path
    }
}

::tclwire::runtime_test::cleanup

test runtime-1.1 {default arguments prepare one future HTTP service} -body {
    set config [::tclwire::runtime parse_args {}]
    list \
        [dict get $config host] \
        [dict get $config startservers] \
        [dict get $config services] \
        [dict get $config default_application] \
        [dict get $config debug_connection] \
        [dict get $config encoding] \
        [dict get $config applications default hosts] \
        [dict get $config applications default docroot] \
        [dict get $config applications default encoding] \
        [dict get $config logfile] \
        [dict get $config logerr] \
        [dict get $config unix_socket] \
        [dict get $config conn_max_wait] \
        [dict get $config conn_max_workers] \
        [dict get $config help]
} -result [list \
    127.0.0.1 \
    http \
    [list [dict create \
        protocol http port 8990 id http:8990 secure 0]] \
    default \
    0 \
    utf-8 \
    {localhost 127.0.0.1} \
    [::tclwire::support default_doc_root] \
    utf-8 \
    [file normalize /tmp/tclwire.log] \
    [file normalize /tmp/tclwire-err.log] \
    [file normalize /tmp/tclwire.sock] \
    1000 \
    100 \
    0]

test runtime-1.2 {legacy service options are normalized without starting services} -body {
    set config [::tclwire::runtime parse_args [list \
        --host 0.0.0.0 \
        --startservers http,https \
        --httpport 8080 \
        --httpsport 8443 \
        --docroot ./www \
        --logfile $::tclwire::runtime_test::logfile \
        --logerr $::tclwire::runtime_test::logerr \
        --unix-socket /tmp/tclwire-test.sock \
        --quiet \
        --debug]]
    list \
        [dict get $config host] \
        [dict get $config services] \
        [dict get $config docroot] \
        [dict get $config applications default docroot] \
        [dict get $config ftproot] \
        [dict get $config logfile] \
        [dict get $config logerr] \
        [dict get $config unix_socket] \
        [dict get $config quiet] \
        [dict get $config debug] \
        [dict get $config debug_connection]
} -result [list \
    0.0.0.0 \
    [list \
        [dict create protocol http port 8080 id http:8080 secure 0] \
        [dict create \
            protocol https port 8443 id https:8443 secure 1 \
            certfile {} keyfile {}]] \
    [file normalize ./www] \
    [file normalize ./www] \
    [file normalize ./www] \
    [file normalize $::tclwire::runtime_test::logfile] \
    [file normalize $::tclwire::runtime_test::logerr] \
    [file normalize /tmp/tclwire-test.sock] \
    1 \
    1 \
    0]

test runtime-1.2a {protocol descriptors share connection-agent classes by family} -body {
    list \
        [dict get [::tclwire::runtime::protocol_descriptor http] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor https] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor ftp] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor ftps] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor proxy] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor https] secure] \
        [dict get [::tclwire::runtime::protocol_descriptor ftps] secure]
} -result [list \
    ::tclwire::HttpConnectionAgent \
    ::tclwire::HttpConnectionAgent \
    ::tclwire::FtpConnectionAgent \
    ::tclwire::FtpConnectionAgent \
    ::tclwire::ProxyConnectionAgent \
    1 \
    1]

test runtime-1.2b {connection queue limits are parsed from CLI aliases} -body {
    set config [::tclwire::runtime parse_args [list \
        --conn-max-wait 250 \
        --conn_max_workers 3]]
    list \
        [dict get $config conn_max_wait] \
        [dict get $config conn_max_workers]
} -result {250 3}

test runtime-1.3 {invalid arguments fail before internal agents start} -body {
    set status [catch {
        ::tclwire::runtime start {--httpport invalid}
    } message]
    list \
        $status \
        $message \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 {invalid value for --httpport: invalid} {} {}}

test runtime-1.4 {help prepares configuration without starting agents} -body {
    set config [::tclwire::runtime start {--help}]
    list \
        [dict get $config help] \
        [::tclwire::runtime is_running] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 0 {} {}}

test runtime-1.5 {runtime starts internal agents and the hardcoded HTTP listener} -body {
    set config [::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]]
    set tpba_id [::tsv::get tclwire tpba_thread_id]
    set logger_id [::tsv::get tclwire logger_thread_id]
    list \
        [dict get $config services] \
        [::tclwire::runtime is_running] \
        [::thread::exists $tpba_id] \
        [::thread::exists $logger_id] \
        [expr {$tpba_id ne $logger_id}] \
        [dict get [[::tclwire::runtime transport_reactor] endpoint] host] \
        [dict get [[::tclwire::runtime transport_reactor] endpoint] port] \
        [expr {[[::tclwire::runtime transport_reactor] listener] ne {}}]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    [list [dict create \
        protocol http port 8990 id http:8990 secure 0]] \
    1 1 1 1 127.0.0.1 8990 1]

test runtime-1.5a {missing document root is seeded from generated documentation} -body {
    set docroot [file join [temporaryDirectory] tclwire-runtime-docroot-[pid]]
    catch {file delete -force $docroot}
    ::tclwire::support prepare_doc_root $docroot
    set index [::fileutil::cat -encoding utf-8 [file join $docroot index.html]]
    list \
        [file isdirectory $docroot] \
        [string match {*TclWire Documentation*} $index] \
        [file isfile [file join $docroot worker_request_api.html]]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $docroot}
} -result {1 1 1}

test runtime-1.5b {existing document root is not seeded or overwritten} -body {
    set docroot [file join [temporaryDirectory] tclwire-runtime-docroot-[pid]]
    file mkdir $docroot
    ::fileutil::writeFile -encoding utf-8 [file join $docroot index.html] custom
    ::tclwire::support prepare_doc_root $docroot
    list \
        [::fileutil::cat -encoding utf-8 [file join $docroot index.html]] \
        [file exists [file join $docroot worker_request_api.html]]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $docroot}
} -result {custom 0}

test runtime-1.5c {connection queue limits configure reactor and pool policy} -body {
    ::tclwire::runtime start [list \
        --conn-max-wait 250 \
        --conn-max-workers 3 \
        --logfile $::tclwire::runtime_test::logfile]
    set reactor [::tclwire::runtime transport_reactor]
    set status [::tclwire::tpba request [dict create \
        operation pool_status \
        pool_key [$reactor pool_key]]]
    list \
        [$reactor pending_retry_after_ms] \
        [$reactor pending_max_attempts] \
        [dict get $status result policy maximum_workers]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {100 3 3}

test runtime-1.6 {the runtime TPBA accepts broker requests} -body {
    ::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]
    set response [::tclwire::tpba request [dict create \
        correlation_id runtime-test \
        operation list_pools]]
    list \
        [dict get $response ok] \
        [dict get $response correlation_id] \
        [dict get $response result]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 runtime-test {app:default connection:http:8990}}

test runtime-1.7 {runtime stop clears endpoints and terminates both agents} -body {
    ::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]
    set tpba_id [::tsv::get tclwire tpba_thread_id]
    set logger_id [::tsv::get tclwire logger_thread_id]
    ::tclwire::runtime stop
    list \
        [::tclwire::runtime is_running] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id] \
        [::thread::exists $tpba_id] \
        [::thread::exists $logger_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {0 {} {} 0 0}

test runtime-1.8 {configured services use distinct reactor pools} -body {
    set ftp_root [file join [temporaryDirectory] tclwire-runtime-ftp-[pid]]
    ::tclwire::runtime start [list \
        --startservers http,ftp,proxy \
        --ftproot $ftp_root \
        --noftp-user-check \
        --logfile $::tclwire::runtime_test::logfile]
    set pools [::tclwire::tpba request [dict create operation list_pools]]
    list \
        [lsort [dict keys [::tclwire::runtime transport_reactors]]] \
        [[::tclwire::runtime transport_reactor http] pool_key] \
        [[::tclwire::runtime transport_reactor ftp] pool_key] \
        [[::tclwire::runtime transport_reactor proxy] pool_key] \
        [dict get $pools result] \
        [file isfile [file join $ftp_root index.html]] \
        [file isfile [file join $ftp_root tcl9.png]]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $ftp_root}
} -result [list \
    {ftp:8991 http:8990 proxy:8992} \
    connection:http:8990 \
    connection:ftp:8991 \
    connection:proxy:8992 \
    {app:default connection:ftp:8991 connection:http:8990 connection:proxy:8992} \
    1 1]

test runtime-1.9 {service TLS credentials override global defaults} -body {
    set config [::tclwire::runtime parse_args [list \
        --startservers https,ftps \
        --certfile ./default-cert.pem \
        --keyfile ./default-key.pem \
        --service "https:9443;certfile=./https-cert.pem;keyfile=./https-key.pem" \
        --service ftps:990]]
    set https_service [lindex [dict get $config services] 0]
    set ftps_service [lindex [dict get $config services] 1]
    list \
        [dict get $config certfile] \
        [dict get $config keyfile] \
        [dict get $https_service certfile] \
        [dict get $https_service keyfile] \
        [dict get $ftps_service certfile] \
        [dict get $ftps_service keyfile]
} -result [list \
    [file normalize ./default-cert.pem] \
    [file normalize ./default-key.pem] \
    [file normalize ./https-cert.pem] \
    [file normalize ./https-key.pem] \
    [file normalize ./default-cert.pem] \
    [file normalize ./default-key.pem]]

test runtime-1.10 {same protocol ports retain independent TLS credentials} -body {
    set config [::tclwire::runtime parse_args [list \
        --startservers https \
        --service "https:9443;certfile=./first.pem;keyfile=./first.key" \
        --service "https:9444;certfile=./second.pem;keyfile=./second.key"]]
    set first [lindex [dict get $config services] 0]
    set second [lindex [dict get $config services] 1]
    list \
        [dict get $first id] \
        [dict get $first certfile] \
        [dict get $second id] \
        [dict get $second certfile]
} -result [list \
    https:9443 [file normalize ./first.pem] \
    https:9444 [file normalize ./second.pem]]

test runtime-1.11 {secure services reject missing default credentials} -body {
    set status [catch {
        ::tclwire::runtime start [list \
            --startservers https \
            --logfile $::tclwire::runtime_test::logfile]
    } message]
    list \
        $status \
        $message \
        [::tclwire::runtime is_running] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 {secure service 'https:9443' is missing certfile} 0 {} {}}

test runtime-1.12 {TOML controls global and protocol configuration} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
host = "0.0.0.0"
debug = true
debug_connection = true
quiet = true
encoding = "iso8859-1"
docroot = "www"
ftproot = "ftp"
logfile = "logs/runtime.log"
logerr = "logs/runtime.err"
libdir = "lib"
certfile = "tls/default.crt"
keyfile = "tls/default.key"
ftp_user_check = false
conn_max_wait = 750
conn_max_workers = 8
default_application = "site.example.test"

[http]
enabled = false
port = 8080

[https]
enabled = true
port = 8443

[https."site.example.test"]
class = "::example::Application"
file = "apps/example.tcl"
libdir = "site-lib"
encoding = "utf-8"
minimum_workers = 2
maximum_workers = 7

[ftp]
enabled = true
port = 2121
root = "ftp-public"
user_check = true

[proxy]
enabled = false
port = 8081
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    set directory [file dirname $config_file]
    list \
        [dict get $config host] \
        [dict get $config debug] \
        [dict get $config debug_connection] \
        [dict get $config quiet] \
        [dict get $config encoding] \
        [dict get $config docroot] \
        [dict get $config ftproot] \
        [dict get $config logfile] \
        [dict get $config logerr] \
        [dict get $config libdir] \
        [dict get $config certfile] \
        [dict get $config keyfile] \
        [dict get $config ftp_user_check] \
        [dict get $config conn_max_wait] \
        [dict get $config conn_max_workers] \
        [dict get $config startservers] \
        [dict get $config services] \
        [dict get $config default_application] \
        [dict get $config applications site.example.test]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    0.0.0.0 1 1 1 iso8859-1 \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] www]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] ftp-public]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] logs runtime.log]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] logs runtime.err]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] lib]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] tls default.crt]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] tls default.key]] \
    1 \
    750 \
    8 \
    {https ftp} \
    [list \
        [dict create protocol https port 8443 id https:8443 secure 1 \
            certfile [file normalize [file join [temporaryDirectory] tclwire-config-[pid] tls default.crt]] \
            keyfile [file normalize [file join [temporaryDirectory] tclwire-config-[pid] tls default.key]]] \
        [dict create protocol ftp port 2121 id ftp:2121 secure 0]] \
    site.example.test \
    [dict create \
        docroot [file normalize [file join [temporaryDirectory] tclwire-config-[pid] www]] \
        encoding utf-8 \
        class ::example::Application \
        hosts site.example.test \
        libdir [file normalize [file join [temporaryDirectory] tclwire-config-[pid] site-lib]] \
        file [file join apps example.tcl] \
        pool_policy [dict create minimum_workers 2 maximum_workers 7]]]

test runtime-1.13 {CLI values supersede TOML configuration} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
host = "0.0.0.0"
docroot = "configured-www"
logfile = "configured.log"
logerr = "configured.err"

[http]
enabled = true
port = 8080

[ftp]
enabled = true
port = 2121

[proxy]
enabled = false
port = 8180
}]
    set config [::tclwire::runtime parse_args [list \
        --config $config_file \
        --host 127.0.0.2 \
        --startservers http,proxy \
        --httpport 8181 \
        --docroot ./cli-www \
        --logfile ./cli.log \
        --logerr ./cli.err \
        --debug]]
    list \
        [dict get $config host] \
        [dict get $config debug] \
        [dict get $config docroot] \
        [dict get $config logfile] \
        [dict get $config logerr] \
        [dict get $config startservers] \
        [dict get $config services]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    127.0.0.2 1 \
    [file normalize ./cli-www] \
    [file normalize ./cli.log] \
    [file normalize ./cli.err] \
    {http proxy} \
    [list \
        [dict create protocol http port 8181 id http:8181 secure 0] \
        [dict create protocol proxy port 8180 id proxy:8180 secure 0]]]

test runtime-1.13a {log levels can be configured globally by service and by host} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
log_level = "error"

[http]
enabled = true
port = 8080
log_level = "debug"

[http.default]
hosts = "localhost"
log_level = "notice"

[http."quiet.example"]
hosts = "quiet.example"
log_level = "alert"
}]
    set config [::tclwire::runtime parse_args [list \
        --config $config_file --log-level warn]]
    list \
        [dict get $config log_level] \
        [dict get [lindex [dict get $config services] 0] log_level] \
        [dict get $config applications default log_level] \
        [dict get $config applications quiet.example log_level]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {warn debug notice alert}

test runtime-1.14 {missing protocol tables disable all external services} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
logfile = "runtime.log"
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    list [dict get $config startservers] [dict get $config services]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {{} {}}

test runtime-1.15 {application libdir precedence is host service global} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
docroot = "www"
libdir = "global-lib"

[http]
libdir = "http-lib"

[http.service]
class = "::example::ServiceApplication"
file = "service.tcl"

[http.host]
class = "::example::HostApplication"
file = "host.tcl"
libdir = "host-lib"
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    list \
        [dict get $config libdir] \
        [dict get $config applications service libdir] \
        [dict get $config applications host libdir]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    [file normalize [file join \
        [temporaryDirectory] tclwire-config-[pid] global-lib]] \
    [file normalize [file join \
        [temporaryDirectory] tclwire-config-[pid] http-lib]] \
    [file normalize [file join \
        [temporaryDirectory] tclwire-config-[pid] host-lib]]]

test runtime-1.16 {host applications inherit the named default descriptor} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
docroot = "global-www"
default_application = "default"

[http]

[http.default]
class = "::example::Application"
package = "example::application"
encoding = "iso8859-1"
minimum_workers = 2
maximum_workers = 8

[http."one.example.test"]
docroot = "sites/one"

[http.two]
hosts = "two.example.test www.two.example.test"
docroot = "sites/two"
maximum_workers = 12
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    list \
        [dict get $config applications one.example.test] \
        [dict get $config applications two]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    [dict create \
        docroot [file normalize [file join \
            [temporaryDirectory] tclwire-config-[pid] sites one]] \
        encoding iso8859-1 \
        class ::example::Application \
        package example::application \
        hosts one.example.test \
        pool_policy [dict create minimum_workers 2 maximum_workers 8]] \
    [dict create \
        docroot [file normalize [file join \
            [temporaryDirectory] tclwire-config-[pid] sites two]] \
        encoding iso8859-1 \
        class ::example::Application \
        package example::application \
        hosts {two.example.test www.two.example.test} \
        pool_policy [dict create minimum_workers 2 maximum_workers 12]]]

::tclwire::runtime_test::cleanup
cleanupTests
