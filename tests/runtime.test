package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::runtime 0.1

namespace eval ::tclwire::runtime_test {
    variable logfile [file join [temporaryDirectory] tclwire-runtime-[pid].log]

    proc cleanup {} {
        variable logfile
        catch {::tclwire::runtime stop}
        catch {file delete -force $logfile}
    }
}

::tclwire::runtime_test::cleanup

test runtime-1.1 {default arguments prepare one future HTTP service} -body {
    set config [::tclwire::runtime parse_args {}]
    list \
        [dict get $config host] \
        [dict get $config startservers] \
        [dict get $config services] \
        [dict get $config default_application] \
        [dict get $config encoding] \
        [dict get $config applications default hosts] \
        [dict get $config applications default docroot] \
        [dict get $config applications default encoding] \
        [dict get $config logfile] \
        [dict get $config help]
} -result [list \
    127.0.0.1 \
    http \
    [list [dict create protocol http port 8990]] \
    default \
    utf-8 \
    {localhost 127.0.0.1} \
    [::tclwire::support default_doc_root] \
    utf-8 \
    [file normalize /tmp/tclwire.log] \
    0]

test runtime-1.2 {legacy service options are normalized without starting services} -body {
    set config [::tclwire::runtime parse_args [list \
        --host 0.0.0.0 \
        --startservers http,https \
        --httpport 8080 \
        --httpsport 8443 \
        --docroot ./www \
        --logfile $::tclwire::runtime_test::logfile \
        --quiet \
        --debug]]
    list \
        [dict get $config host] \
        [dict get $config services] \
        [dict get $config docroot] \
        [dict get $config applications default docroot] \
        [dict get $config ftproot] \
        [dict get $config logfile] \
        [dict get $config quiet] \
        [dict get $config debug]
} -result [list \
    0.0.0.0 \
    [list \
        [dict create protocol http port 8080] \
        [dict create protocol https port 8443]] \
    [file normalize ./www] \
    [file normalize ./www] \
    [file normalize ./www] \
    [file normalize $::tclwire::runtime_test::logfile] \
    1 \
    1]

test runtime-1.3 {invalid arguments fail before internal agents start} -body {
    set status [catch {
        ::tclwire::runtime start {--httpport invalid}
    } message]
    list \
        $status \
        $message \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 {invalid value for --httpport: invalid} {} {}}

test runtime-1.4 {help prepares configuration without starting agents} -body {
    set config [::tclwire::runtime start {--help}]
    list \
        [dict get $config help] \
        [::tclwire::runtime is_running] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 0 {} {}}

test runtime-1.5 {runtime starts internal agents and the hardcoded HTTP listener} -body {
    set config [::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]]
    set tpba_id [::tsv::get tclwire tpba_thread_id]
    set logger_id [::tsv::get tclwire logger_thread_id]
    list \
        [dict get $config services] \
        [::tclwire::runtime is_running] \
        [::thread::exists $tpba_id] \
        [::thread::exists $logger_id] \
        [expr {$tpba_id ne $logger_id}] \
        [dict get [[::tclwire::runtime transport_reactor] endpoint] host] \
        [dict get [[::tclwire::runtime transport_reactor] endpoint] port] \
        [expr {[[::tclwire::runtime transport_reactor] listener] ne {}}]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    [list [dict create protocol http port 8990]] \
    1 1 1 1 127.0.0.1 8990 1]

test runtime-1.6 {the runtime TPBA accepts broker requests} -body {
    ::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]
    set response [::tclwire::tpba request [dict create \
        correlation_id runtime-test \
        operation list_pools]]
    list \
        [dict get $response ok] \
        [dict get $response correlation_id] \
        [dict get $response result]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 runtime-test {app:default connection:http}}

test runtime-1.7 {runtime stop clears endpoints and terminates both agents} -body {
    ::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]
    set tpba_id [::tsv::get tclwire tpba_thread_id]
    set logger_id [::tsv::get tclwire logger_thread_id]
    ::tclwire::runtime stop
    list \
        [::tclwire::runtime is_running] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id] \
        [::thread::exists $tpba_id] \
        [::thread::exists $logger_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {0 {} {} 0 0}

test runtime-1.8 {HTTP and FTP listeners use distinct reactor pools} -body {
    set ftp_root [file join [temporaryDirectory] tclwire-runtime-ftp-[pid]]
    ::tclwire::runtime start [list \
        --startservers http,ftp \
        --ftproot $ftp_root \
        --noftp-user-check \
        --logfile $::tclwire::runtime_test::logfile]
    set pools [::tclwire::tpba request [dict create operation list_pools]]
    list \
        [lsort [dict keys [::tclwire::runtime transport_reactors]]] \
        [[::tclwire::runtime transport_reactor http] pool_key] \
        [[::tclwire::runtime transport_reactor ftp] pool_key] \
        [dict get $pools result] \
        [file isfile [file join $ftp_root index.html]] \
        [file isfile [file join $ftp_root tcl9.png]]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $ftp_root}
} -result [list \
    {ftp http} \
    connection:http \
    connection:ftp \
    {app:default connection:ftp connection:http} \
    1 1]

::tclwire::runtime_test::cleanup
cleanupTests
