package require tcltest
package require fileutil
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::runtime 0.1

namespace eval ::tclwire::runtime_test {
    variable logfile [file join [temporaryDirectory] tclwire-runtime-[pid].log]
    variable logerr [file join [temporaryDirectory] tclwire-runtime-[pid].err]
    variable config_files {}

    proc cleanup {} {
        variable logfile
        variable logerr
        variable config_files
        catch {::tclwire::runtime stop}
        catch {file delete -force $logfile}
        catch {file delete -force $logerr}
        foreach path $config_files {
            catch {file delete -force $path}
        }
        set config_files {}
    }

    proc make_config {contents} {
        variable config_files
        set directory [file join [temporaryDirectory] tclwire-config-[pid]]
        file mkdir $directory
        set path [file join $directory tclwire.toml]
        set channel [open $path w]
        puts -nonewline $channel $contents
        close $channel
        lappend config_files $directory
        return $path
    }
}

::tclwire::runtime_test::cleanup

test runtime-1.1 {default arguments prepare one future HTTP service} -body {
    set config [::tclwire::runtime parse_args {}]
    list \
        [dict get $config host] \
        [dict get $config startservers] \
        [dict get $config services] \
        [dict get $config default_application] \
        [dict get $config debug_connection] \
        [dict get $config encoding] \
        [dict get $config applications default hosts] \
        [dict get $config applications default docroot] \
        [dict get $config applications default encoding] \
        [dict get $config logfile] \
        [dict get $config logerr] \
        [dict get $config unix_socket] \
        [dict get $config conn_max_wait] \
        [dict get $config conn_max_workers] \
        [dict get $config conn_max_per_thread] \
        [dict get $config chores_enabled] \
        [dict get $config chore_interval_ms] \
        [dict get $config diagnostics_enabled] \
        [dict get $config diagnostics_interval_ms] \
        [dict get $config diagnostics_watchdog_max_age_ms] \
        [dict get $config help]
} -result [list \
    127.0.0.1 \
    http \
    [list [dict create \
        protocol http port 8990 upload_area [file normalize /tmp] \
        max_request_bytes 16777216 max_header_bytes 65536 \
        request_memory_threshold 1048576 \
        id http:8990 secure 0 description "HTTP application service"]] \
    default \
    0 \
    utf-8 \
    {localhost 127.0.0.1} \
    [::tclwire::support default_doc_root] \
    utf-8 \
    [file normalize /tmp/tclwire.log] \
    [file normalize /tmp/tclwire-err.log] \
    [file normalize /tmp/tclwire.sock] \
    1000 \
    100 \
    5 \
    0 \
    5000 \
    0 \
    5000 \
    10000 \
    0]

test runtime-1.2 {legacy service options are normalized without starting services} -body {
    set config [::tclwire::runtime parse_args [list \
        --host 0.0.0.0 \
        --startservers http,https \
        --httpport 8080 \
        --httpsport 8443 \
        --docroot ./www \
        --logfile $::tclwire::runtime_test::logfile \
        --logerr $::tclwire::runtime_test::logerr \
        --unix-socket /tmp/tclwire-test.sock \
        --quiet \
        --debug]]
    list \
        [dict get $config host] \
        [dict get $config services] \
        [dict get $config docroot] \
        [dict get $config applications default docroot] \
        [dict get $config ftproot] \
        [dict get $config logfile] \
        [dict get $config logerr] \
        [dict get $config unix_socket] \
        [dict get $config quiet] \
        [dict get $config debug] \
        [dict get $config debug_connection]
} -result [list \
    0.0.0.0 \
    [list \
        [dict create protocol http port 8080 upload_area [file normalize /tmp] \
            max_request_bytes 16777216 max_header_bytes 65536 \
            request_memory_threshold 1048576 \
            id http:8080 secure 0 description "HTTP application service"] \
        [dict create \
            protocol https port 8443 upload_area [file normalize /tmp] \
            max_request_bytes 16777216 max_header_bytes 65536 \
            request_memory_threshold 1048576 \
            id https:8443 secure 1 description "HTTPS application service" \
            certfile {} keyfile {}]] \
    [file normalize ./www] \
    [file normalize ./www] \
    [file normalize ./www] \
    [file normalize $::tclwire::runtime_test::logfile] \
    [file normalize $::tclwire::runtime_test::logerr] \
    [file normalize /tmp/tclwire-test.sock] \
    1 \
    1 \
    0]

test runtime-1.2a {protocol descriptors share connection-agent classes by family} -body {
    list \
        [dict get [::tclwire::runtime::protocol_descriptor http] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor https] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor ftp] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor ftps] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor proxy] agent_class] \
        [dict get [::tclwire::runtime::protocol_descriptor https] secure] \
        [dict get [::tclwire::runtime::protocol_descriptor ftps] secure] \
        [dict get [::tclwire::runtime::protocol_descriptor http] description] \
        [dict get [::tclwire::runtime::protocol_descriptor https] description] \
        [dict get [::tclwire::runtime::protocol_descriptor ftp] description] \
        [dict get [::tclwire::runtime::protocol_descriptor ftps] description] \
        [dict get [::tclwire::runtime::protocol_descriptor proxy] description]
} -result [list \
    ::tclwire::HttpConnectionAgent \
    ::tclwire::HttpConnectionAgent \
    ::tclwire::FtpConnectionAgent \
    ::tclwire::FtpConnectionAgent \
    ::tclwire::ProxyConnectionAgent \
    1 \
    1 \
    "HTTP application service" \
    "HTTPS application service" \
    "FTP file transfer service" \
    "FTPS file transfer service" \
    "HTTP proxy service"]

test runtime-1.2b {connection queue limits are parsed from CLI aliases} -body {
    set config [::tclwire::runtime parse_args [list \
        --conn-max-wait 250 \
        --conn_max_workers 3 \
        --conn-max-per-thread 4]]
    list \
        [dict get $config conn_max_wait] \
        [dict get $config conn_max_workers] \
        [dict get $config conn_max_per_thread]
} -result {250 3 4}

test runtime-1.2ba {diagnostic options are parsed from CLI aliases} -body {
    set config [::tclwire::runtime parse_args [list \
        --enable-chores \
        --chore-interval-ms 800 \
        --diagnostics \
        --diagnostics-interval-ms 1200 \
        --diagnostics-watchdog-max-age-ms 2400]]
    list \
        [dict get $config chores_enabled] \
        [dict get $config chore_interval_ms] \
        [dict get $config diagnostics_enabled] \
        [dict get $config diagnostics_interval_ms] \
        [dict get $config diagnostics_watchdog_max_age_ms]
} -result {1 800 1 1200 2400}

test runtime-1.2bb {application chore files resolve through application libdir} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
default_application = "site.example.test"

[http]
enabled = true
port = 8080

[http."site.example.test"]
class = "::example::Application"
package = "tclwire::application"
docroot = "www"
libdir = "site-lib"
chore = "site-chore.tcl"
}]
    set directory [file dirname $config_file]
    file mkdir [file join $directory site-lib]
    ::fileutil::writeFile [file join $directory site-lib site-chore.tcl] {
package require tclwire::chore 0.1
oo::class create ::example::SiteChore {
    superclass ::tclwire::Chore
    method run {wakeup} {
        return [dict create ok 1]
    }
}
}
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    set specs [::tclwire::runtime::application_chore_specs $config]
    set spec [lindex $specs 0]
    list \
        [::tclwire::runtime::config_has_application_chores $config] \
        [dict get $config applications site.example.test chore] \
        [dict get $spec name] \
        [dict get $spec file] \
        [expr {[file join $directory site-lib] in [dict get $spec paths]}]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    1 \
    site-chore.tcl \
    application:site.example.test \
    [file normalize [file join \
        [temporaryDirectory] tclwire-config-[pid] site-lib site-chore.tcl]] \
    1]

test runtime-1.2bc {server chore files resolve from tclwire stanza} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
chore = "server-chore.tcl"
chore_class = "ServerChore"
}]
    set directory [file dirname $config_file]
    ::fileutil::writeFile [file join $directory server-chore.tcl] {
package require tclwire::chore 0.1
oo::class create ServerChore {
    superclass ::tclwire::ServerChore
    method run {wakeup} {
        return [dict create ok 1 config_type [dict get [my server_config] type]]
    }
}
}
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    set specs [::tclwire::runtime::server_chore_specs $config]
    set spec [lindex $specs 0]
    set server_context [dict get $spec server_context]
    list \
        [::tclwire::runtime::config_has_server_chores $config] \
        [dict get $spec name] \
        [dict get $spec file] \
        [dict get $spec class] \
        [expr {$directory in [dict get $spec paths]}] \
        [dict get $server_context type] \
        [dict exists $server_context values applications] \
        [dict exists $server_context application_configs default]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    1 \
    server:default \
    [file normalize [file join \
        [temporaryDirectory] tclwire-config-[pid] server-chore.tcl]] \
    ServerChore \
    1 \
    tclwire.server_configuration \
    0 \
    1]

test runtime-1.2bd {default application chore is not inherited by virtual hosts} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
default_application = "default"

[http]
enabled = true
port = 8080

[http.default]
class = "::example::Application"
package = "tclwire::application"
docroot = "www"
chore = "default-chore.tcl"

[http."hello.example.test"]
docroot = "www"
}]
    set directory [file dirname $config_file]
    file mkdir [file join $directory www]
    ::fileutil::writeFile [file join $directory www default-chore.tcl] {
package require tclwire::chore 0.1
oo::class create DefaultChore {
    superclass ::tclwire::ApplicationChore
    method run {wakeup} {
        return [dict create application [my application_id]]
    }
}
}
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    set specs [::tclwire::runtime::application_chore_specs $config]
    list \
        [llength $specs] \
        [dict get [lindex $specs 0] name] \
        [dict exists $config applications hello.example.test chore]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 application:default 0}

test runtime-1.2c {HTTP services inherit and override the upload area} -body {
    set global_area [file normalize ./global-uploads]
    set service_area [file normalize ./service-uploads]
    set config [::tclwire::runtime parse_args \
                    [list   --upload-area $global_area \
                            --service http:8080 \
                            --service "https:8443;upload_area=$service_area"]]
    set services [dict get $config services]
    list [dict get $config upload_area] \
         [dict get [lindex $services 0] protocol] \
         [dict get [lindex $services 0] upload_area] \
         [dict get [lindex $services 1] upload_area]
} -result [list \
    [file normalize ./global-uploads] http [file normalize ./global-uploads] \
    [file normalize ./service-uploads]]

test runtime-1.2d {an empty upload area explicitly selects in-memory uploads} -body {
    set config [::tclwire::runtime parse_args [list --upload-area {} \
                                                    --service http:8080 \
                                                    --service {https:8443;upload_area=}]]
    list [dict get $config upload_area] \
         [dict get [lindex [dict get $config services] 0] upload_area] \
         [dict get [lindex [dict get $config services] 1] upload_area]
} -result {{} {} {}}

test runtime-1.2e {an empty HTTP upload area in the config file disables multipart decomposition} -body {
    set config_file [::tclwire::runtime_test::make_config {
[http]
enabled = true
port = 8990
upload_area = ""
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    dict get [lindex [dict get $config services] 0] upload_area
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {}

test runtime-1.3 {invalid arguments fail before internal agents start} -body {
    set status [catch {
        ::tclwire::runtime start {--httpport invalid}
    } message]
    list \
        $status \
        $message \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 {invalid value for --httpport: invalid} {} {}}

test runtime-1.4 {help prepares configuration without starting agents} -body {
    set config [::tclwire::runtime start {--help}]
    list \
        [dict get $config help] \
        [::tclwire::runtime is_running] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 0 {} {}}

test runtime-1.5 {runtime starts internal agents and the hardcoded HTTP listener} -body {
    set config [::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]]
    set tpba_id [::tsv::get tclwire tpba_thread_id]
    set logger_id [::tsv::get tclwire logger_thread_id]
    list \
        [dict get $config services] \
        [::tclwire::runtime is_running] \
        [::thread::exists $tpba_id] \
        [::thread::exists $logger_id] \
        [expr {$tpba_id ne $logger_id}] \
        [dict get [[::tclwire::runtime transport_reactor] endpoint] host] \
        [dict get [[::tclwire::runtime transport_reactor] endpoint] port] \
        [expr {[[::tclwire::runtime transport_reactor] listener] ne {}}]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    [list [dict create \
        protocol http port 8990 upload_area [file normalize /tmp] \
        max_request_bytes 16777216 max_header_bytes 65536 \
        request_memory_threshold 1048576 \
        id http:8990 secure 0 description "HTTP application service"]] \
    1 1 1 1 127.0.0.1 8990 1]

test runtime-1.5a {missing document root is seeded from generated documentation} -body {
    set docroot [file join [temporaryDirectory] tclwire-runtime-docroot-[pid]]
    catch {file delete -force $docroot}
    ::tclwire::support prepare_doc_root $docroot
    set index [::fileutil::cat -encoding utf-8 [file join $docroot index.html]]
    list \
        [file isdirectory $docroot] \
        [string match {*TclWire Documentation*} $index] \
        [file isfile [file join $docroot worker_request_api.html]] \
        [file isfile [file join $docroot application_configuration.html]] \
        [file isfile [file join $docroot configuration_tree.html]] \
        [file isfile [file join $docroot chores.html]] \
        [string match {*href="application_configuration.html"*} $index] \
        [string match {*href="configuration_tree.html"*} $index] \
        [string match {*href="chores.html"*} $index]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $docroot}
} -result {1 1 1 1 1 1 1 1 1}

test runtime-1.5b {existing document root is not seeded or overwritten} -body {
    set docroot [file join [temporaryDirectory] tclwire-runtime-docroot-[pid]]
    file mkdir $docroot
    ::fileutil::writeFile -encoding utf-8 [file join $docroot index.html] custom
    ::tclwire::support prepare_doc_root $docroot
    list \
        [::fileutil::cat -encoding utf-8 [file join $docroot index.html]] \
        [file exists [file join $docroot worker_request_api.html]]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $docroot}
} -result {custom 0}

test runtime-1.5c {existing empty document root prevents automatic seeding} -body {
    set docroot [file join [temporaryDirectory] tclwire-runtime-docroot-[pid]]
    catch {file delete -force $docroot}
    file mkdir $docroot
    ::tclwire::support prepare_doc_root $docroot
    list \
        [file isdirectory $docroot] \
        [file exists [file join $docroot index.html]] \
        [file isfile [file join $docroot worker_request_api.html]]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $docroot}
} -result {1 0 0}

test runtime-1.5d {forced document root seeding writes existing directory} -body {
    set docroot [file join [temporaryDirectory] tclwire-runtime-docroot-[pid]]
    catch {file delete -force $docroot}
    file mkdir $docroot
    ::tclwire::support prepare_doc_root $docroot \
        [::tclwire::support runtime_doc_source] 1
    set index [::fileutil::cat -encoding utf-8 [file join $docroot index.html]]
    list \
        [string match {*TclWire Documentation*} $index] \
        [file isfile [file join $docroot worker_request_api.html]] \
        [file isfile [file join $docroot application_configuration.html]] \
        [file isfile [file join $docroot configuration_tree.html]] \
        [file isfile [file join $docroot chores.html]] \
        [string match {*href="application_configuration.html"*} $index] \
        [string match {*href="configuration_tree.html"*} $index] \
        [string match {*href="chores.html"*} $index]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $docroot}
} -result {1 1 1 1 1 1 1 1}

test runtime-1.5e {force docroot seeding is a global CLI option} -body {
    set config [::tclwire::runtime parse_args [list --force-docroot-seeding]]
    dict get $config force_docroot_seeding
} -result 1

test runtime-1.5f {manual site pages are copied below manual directory} -body {
    set original_project_root $::tclwire::support::project_root
    set project_root [file join [temporaryDirectory] tclwire-runtime-site-[pid]]
    set docroot [file join [temporaryDirectory] tclwire-runtime-docroot-[pid]]
    file mkdir [file join $project_root site manual]
    file mkdir [file join $project_root site assets]
    ::fileutil::writeFile -encoding utf-8 \
        [file join $project_root site index.html] site-home
    ::fileutil::writeFile -encoding utf-8 \
        [file join $project_root site manual index.html] manual-home
    ::fileutil::writeFile -encoding utf-8 \
        [file join $project_root site assets site.css] manual-css

    set ::tclwire::support::project_root $project_root
    list \
        [::tclwire::support seed_manual_site $docroot] \
        [::fileutil::cat -encoding utf-8 \
            [file join $docroot manual index.html]] \
        [::fileutil::cat -encoding utf-8 \
            [file join $docroot assets site.css]] \
        [file exists [file join $docroot manual manual]] \
        [file exists [file join $docroot manual assets]]
} -cleanup {
    set ::tclwire::support::project_root $original_project_root
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $project_root}
    catch {file delete -force $docroot}
} -result {1 manual-home manual-css 0 0}

test runtime-1.5fa {manual site seeding merges existing directories} -body {
    set original_project_root $::tclwire::support::project_root
    set project_root [file join [temporaryDirectory] tclwire-runtime-site-[pid]]
    set docroot [file join [temporaryDirectory] tclwire-runtime-docroot-[pid]]
    file mkdir [file join $project_root site manual]
    file mkdir [file join $project_root site stylesheets]
    file mkdir [file join $docroot manual stylesheets]
    file mkdir [file join $docroot stylesheets]
    ::fileutil::writeFile -encoding utf-8 \
        [file join $project_root site manual index.html] manual-home
    ::fileutil::writeFile -encoding utf-8 \
        [file join $project_root site stylesheets tclwire-manual.css] updated
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot stylesheets old.css] old

    set ::tclwire::support::project_root $project_root
    list \
        [::tclwire::support seed_manual_site $docroot] \
        [::fileutil::cat -encoding utf-8 \
            [file join $docroot stylesheets tclwire-manual.css]] \
        [::fileutil::cat -encoding utf-8 \
            [file join $docroot stylesheets old.css]] \
        [file exists [file join $docroot manual manual]] \
        [file exists [file join $docroot manual stylesheets stylesheets]]
} -cleanup {
    set ::tclwire::support::project_root $original_project_root
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $project_root}
    catch {file delete -force $docroot}
} -result {1 updated old 0 0}

test runtime-1.5g {connection queue limits configure reactor and pool policy} -body {
    ::tclwire::runtime start [list \
        --conn-max-wait 250 \
        --conn-max-workers 3 \
        --conn-max-per-thread 4 \
        --logfile $::tclwire::runtime_test::logfile]
    set reactor [::tclwire::runtime transport_reactor]
    set status [::tclwire::tpba request [dict create \
        operation pool_status \
        pool_key [$reactor pool_key]]]
    list \
        [$reactor pending_retry_after_ms] \
        [$reactor pending_max_attempts] \
        [dict get $status result policy maximum_workers] \
        [dict get $status result policy max_conn_per_thread]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {100 3 3 4}

test runtime-1.6 {the runtime TPBA accepts broker requests} -body {
    ::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]
    set response [::tclwire::tpba request [dict create \
        correlation_id runtime-test \
        operation list_pools]]
    list \
        [dict get $response ok] \
        [dict get $response correlation_id] \
        [dict get $response result]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 runtime-test {app:default connection:http:8990}}

test runtime-1.7 {runtime stop clears endpoints and terminates both agents} -body {
    ::tclwire::runtime start [list \
        --logfile $::tclwire::runtime_test::logfile]
    set tpba_id [::tsv::get tclwire tpba_thread_id]
    set logger_id [::tsv::get tclwire logger_thread_id]
    ::tclwire::runtime stop
    list \
        [::tclwire::runtime is_running] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id] \
        [::thread::exists $tpba_id] \
        [::thread::exists $logger_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {0 {} {} 0 0}

test runtime-1.8 {configured services use distinct reactor pools} -body {
    set ftp_root [file join [temporaryDirectory] tclwire-runtime-ftp-[pid]]
    ::tclwire::runtime start [list \
        --startservers http,ftp,proxy \
        --ftproot $ftp_root \
        --noftp-user-check \
        --logfile $::tclwire::runtime_test::logfile]
    set pools [::tclwire::tpba request [dict create operation list_pools]]
    list \
        [lsort [dict keys [::tclwire::runtime transport_reactors]]] \
        [[::tclwire::runtime transport_reactor http] pool_key] \
        [[::tclwire::runtime transport_reactor ftp] pool_key] \
        [[::tclwire::runtime transport_reactor proxy] pool_key] \
        [dict get $pools result] \
        [file isfile [file join $ftp_root index.html]] \
        [file isfile [file join $ftp_root tcl9.png]]
} -cleanup {
    ::tclwire::runtime_test::cleanup
    catch {file delete -force $ftp_root}
} -result [list \
    {ftp:8991 http:8990 proxy:8992} \
    connection:http:8990 \
    connection:ftp:8991 \
    connection:proxy:8992 \
    {app:default connection:ftp:8991 connection:http:8990 connection:proxy:8992} \
    1 1]

test runtime-1.9 {service TLS credentials override global defaults} -body {
    set config [::tclwire::runtime parse_args [list \
        --startservers https,ftps \
        --certfile ./default-cert.pem \
        --keyfile ./default-key.pem \
        --service "https:9443;certfile=./https-cert.pem;keyfile=./https-key.pem" \
        --service ftps:990]]
    set https_service [lindex [dict get $config services] 0]
    set ftps_service [lindex [dict get $config services] 1]
    list \
        [dict get $config certfile] \
        [dict get $config keyfile] \
        [dict get $https_service certfile] \
        [dict get $https_service keyfile] \
        [dict get $ftps_service certfile] \
        [dict get $ftps_service keyfile]
} -result [list \
    [file normalize ./default-cert.pem] \
    [file normalize ./default-key.pem] \
    [file normalize ./https-cert.pem] \
    [file normalize ./https-key.pem] \
    [file normalize ./default-cert.pem] \
    [file normalize ./default-key.pem]]

test runtime-1.10 {same protocol ports retain independent TLS credentials} -body {
    set config [::tclwire::runtime parse_args [list \
        --startservers https \
        --service "https:9443;certfile=./first.pem;keyfile=./first.key" \
        --service "https:9444;certfile=./second.pem;keyfile=./second.key"]]
    set first [lindex [dict get $config services] 0]
    set second [lindex [dict get $config services] 1]
    list \
        [dict get $first id] \
        [dict get $first certfile] \
        [dict get $second id] \
        [dict get $second certfile]
} -result [list \
    https:9443 [file normalize ./first.pem] \
    https:9444 [file normalize ./second.pem]]

test runtime-1.11 {secure services reject missing default credentials} -body {
    set status [catch {
        ::tclwire::runtime start [list \
            --startservers https \
            --logfile $::tclwire::runtime_test::logfile]
    } message]
    list \
        $status \
        $message \
        [::tclwire::runtime is_running] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {1 {secure service 'https:9443' is missing certfile} 0 {} {}}

test runtime-1.12 {TOML controls global and protocol configuration} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
host = "0.0.0.0"
debug = true
debug_connection = true
quiet = true
encoding = "iso8859-1"
docroot = "www"
ftproot = "ftp"
logfile = "logs/runtime.log"
logerr = "logs/runtime.err"
libdir = "lib"
certfile = "tls/default.crt"
keyfile = "tls/default.key"
ftp_user_check = false
conn_max_wait = 750
conn_max_workers = 8
conn_max_per_thread = 4
chores_enabled = true
chore_interval_ms = 700
diagnostics_enabled = true
diagnostics_interval_ms = 1500
diagnostics_watchdog_max_age_ms = 4500
default_application = "site.example.test"

[http]
enabled = false
port = 8080

[https]
enabled = true
port = 8443

[https."site.example.test"]
class = "::example::Application"
file = "apps/example.tcl"
libdir = "site-lib"
encoding = "utf-8"
minimum_workers = 2
maximum_workers = 7

[https."site.example.test".configure."::example::Application"]
message = "configured virtual host"

[ftp]
enabled = true
port = 2121
root = "ftp-public"
user_check = true

[proxy]
enabled = false
port = 8081
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    set directory [file dirname $config_file]
    list \
        [dict get $config host] \
        [dict get $config debug] \
        [dict get $config debug_connection] \
        [dict get $config quiet] \
        [dict get $config encoding] \
        [dict get $config docroot] \
        [dict get $config ftproot] \
        [dict get $config logfile] \
        [dict get $config logerr] \
        [dict get $config libdir] \
        [dict get $config certfile] \
        [dict get $config keyfile] \
        [dict get $config ftp_user_check] \
        [dict get $config conn_max_wait] \
        [dict get $config conn_max_workers] \
        [dict get $config conn_max_per_thread] \
        [dict get $config chores_enabled] \
        [dict get $config chore_interval_ms] \
        [dict get $config diagnostics_enabled] \
        [dict get $config diagnostics_interval_ms] \
        [dict get $config diagnostics_watchdog_max_age_ms] \
        [dict get $config startservers] \
        [dict get $config services] \
        [dict get $config default_application] \
        [dict get $config applications site.example.test]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    0.0.0.0 1 1 1 iso8859-1 \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] www]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] ftp-public]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] logs runtime.log]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] logs runtime.err]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] lib]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] tls default.crt]] \
    [file normalize [file join [temporaryDirectory] tclwire-config-[pid] tls default.key]] \
    1 \
    750 \
    8 \
    4 \
    1 \
    700 \
    1 \
    1500 \
    4500 \
    {https ftp} \
    [list \
        [dict create protocol https port 8443 upload_area [file normalize /tmp] \
            max_request_bytes 16777216 max_header_bytes 65536 \
            request_memory_threshold 1048576 \
            id https:8443 secure 1 description "HTTPS application service" \
            certfile [file normalize [file join [temporaryDirectory] tclwire-config-[pid] tls default.crt]] \
            keyfile [file normalize [file join [temporaryDirectory] tclwire-config-[pid] tls default.key]]] \
        [dict create protocol ftp port 2121 id ftp:2121 secure 0 \
            description "FTP file transfer service"]] \
    site.example.test \
    [dict create \
        docroot [file normalize [file join [temporaryDirectory] tclwire-config-[pid] www]] \
        encoding utf-8 \
        class ::example::Application \
        configure [dict create \
            ::example::Application [dict create message {configured virtual host}]] \
        hosts site.example.test \
        libdir [file normalize [file join [temporaryDirectory] tclwire-config-[pid] site-lib]] \
        file [file join apps example.tcl] \
        pool_policy [dict create minimum_workers 2 maximum_workers 7]]]

test runtime-1.13 {CLI values supersede TOML configuration} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
host = "0.0.0.0"
docroot = "configured-www"
logfile = "configured.log"
logerr = "configured.err"

[http]
enabled = true
port = 8080

[ftp]
enabled = true
port = 2121

[proxy]
enabled = false
port = 8180
}]
    set config [::tclwire::runtime parse_args [list \
        --config $config_file \
        --host 127.0.0.2 \
        --startservers http,proxy \
        --httpport 8181 \
        --docroot ./cli-www \
        --logfile ./cli.log \
        --logerr ./cli.err \
        --debug]]
    list \
        [dict get $config host] \
        [dict get $config debug] \
        [dict get $config docroot] \
        [dict get $config logfile] \
        [dict get $config logerr] \
        [dict get $config startservers] \
        [dict get $config services]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    127.0.0.2 1 \
    [file normalize ./cli-www] \
    [file normalize ./cli.log] \
    [file normalize ./cli.err] \
    {http proxy} \
    [list \
        [dict create protocol http port 8181 upload_area [file normalize /tmp] \
            max_request_bytes 16777216 max_header_bytes 65536 \
            request_memory_threshold 1048576 \
            id http:8181 secure 0 description "HTTP application service"] \
        [dict create protocol proxy port 8180 id proxy:8180 secure 0 \
            description "HTTP proxy service"]]]

test runtime-1.13a {bind address and default hosts are configured globally} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
bind_address = "192.0.2.10"
default_hosts = "example.test 192.0.2.10"

[http]
enabled = true
port = 8990
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set selected [$dispatcher select_application \
            [dict create headers [dict create host 192.0.2.10:8990]]]
    } finally {
        $dispatcher destroy
    }
    list \
        [dict get $config host] \
        [dict get $config applications default hosts] \
        $selected
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {192.0.2.10 {example.test 192.0.2.10} default}

test runtime-1.13b {application hosts override global default hosts} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
default_hosts = "global.example"

[http]
enabled = true
port = 8990

[http.default]
hosts = "local.example"
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    dict get $config applications default hosts
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result local.example

test runtime-1.13ba {quoted dotted application tables are host application ids} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
docroot = "www"
default_application = "default"

[http]
enabled = true
port = 8990

[http.default]
class = "::tclwire::CApplication"
package = "tclwire::application"
hosts = "localhost 127.0.0.1"

[http."hello.rivetweb.org"]
class = "::tclwire::Hello"
file = "examples/hello.tcl"

[http."hello.rivetweb.org".configure."::tclwire::Hello"]
message = "Hello from RivetWeb"
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set selected [$dispatcher select_application \
            [dict create headers [dict create host hello.rivetweb.org]]]
        set descriptor [$dispatcher application $selected]
        list \
            $selected \
            [dict get $descriptor class] \
            [dict get $descriptor hosts] \
            [dict get $descriptor file] \
            [dict get $descriptor configure]
    } finally {
        $dispatcher destroy
    }
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    hello.rivetweb.org \
    ::tclwire::Hello \
    hello.rivetweb.org \
    [file normalize [file join [pwd] examples hello.tcl]] \
    [dict create ::tclwire::Hello [dict create message {Hello from RivetWeb}]]]

test runtime-1.13baa {unquoted dotted application tables are rejected} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
docroot = "www"
default_application = "default"

[http]
enabled = true
port = 8990

[http.default]
class = "::tclwire::CApplication"
package = "tclwire::application"
hosts = "localhost 127.0.0.1"

[http.hello.rivetweb.org]
class = "::tclwire::Hello"
file = "examples/hello.tcl"
}]
    catch {
        ::tclwire::runtime parse_args [list --config $config_file]
    } message
    set message
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {application 'http.hello' contains nested table 'rivetweb'; quote dotted application ids, for example [http."hello.rivetweb.org"]}

test runtime-1.13bb {host applications override duplicate default host aliases} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
docroot = "www"
default_hosts = "localhost hello.rivetweb.org"
default_application = "default"

[http]
enabled = true
port = 8990

[http.default]
class = "::tclwire::CApplication"
package = "tclwire::application"
hosts = "localhost hello.rivetweb.org"

[http."hello.rivetweb.org"]
class = "::tclwire::Hello"
file = "examples/hello.tcl"
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set selected [$dispatcher select_application \
            [dict create headers [dict create host hello.rivetweb.org]]]
        list $selected [dict get [$dispatcher application $selected] class]
    } finally {
        $dispatcher destroy
    }
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {hello.rivetweb.org ::tclwire::Hello}

test runtime-1.13c {listen address is a bind address alias} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
listen_address = "192.0.2.20"
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    dict get $config host
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result 192.0.2.20

test runtime-1.13d {CLI bind address aliases configure listener address} -body {
    set bind [::tclwire::runtime parse_args \
        [list --bind-address 192.0.2.30]]
    set listen [::tclwire::runtime parse_args \
        [list --listen-address 192.0.2.31]]
    list [dict get $bind host] [dict get $listen host]
} -result {192.0.2.30 192.0.2.31}

test runtime-1.13e {log levels can be configured globally by service and by host} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
log_level = "error"

[http]
enabled = true
port = 8080
log_level = "debug"

[http.default]
hosts = "localhost"
log_level = "notice"

[http."quiet.example"]
hosts = "quiet.example"
log_level = "alert"
}]
    set config [::tclwire::runtime parse_args [list \
        --config $config_file --log-level warn]]
    list \
        [dict get $config log_level] \
        [dict get [lindex [dict get $config services] 0] log_level] \
        [dict get $config applications default log_level] \
        [dict get $config applications quiet.example log_level]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {warn debug notice alert}

test runtime-1.14 {missing protocol tables disable all external services} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
logfile = "runtime.log"
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    list [dict get $config startservers] [dict get $config services]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {{} {}}

test runtime-1.15 {application libdir precedence is host service global} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
docroot = "www"
libdir = "global-lib"

[http]
libdir = "http-lib"

[http.service]
class = "::example::ServiceApplication"
file = "service.tcl"

[http.host]
class = "::example::HostApplication"
file = "host.tcl"
libdir = "host-lib"
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    list \
        [dict get $config libdir] \
        [dict get $config applications service libdir] \
        [dict get $config applications host libdir]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    [file normalize [file join \
        [temporaryDirectory] tclwire-config-[pid] global-lib]] \
    [file normalize [file join \
        [temporaryDirectory] tclwire-config-[pid] http-lib]] \
    [file normalize [file join \
        [temporaryDirectory] tclwire-config-[pid] host-lib]]]

test runtime-1.16 {host applications inherit the named default descriptor} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
docroot = "global-www"
default_application = "default"

[http]

[http.default]
class = "::example::Application"
package = "example::application"
encoding = "iso8859-1"
minimum_workers = 2
maximum_workers = 8

[http."one.example.test"]
docroot = "sites/one"

[http.two]
hosts = "two.example.test www.two.example.test"
docroot = "sites/two"
maximum_workers = 12
}]
    set config [::tclwire::runtime parse_args [list --config $config_file]]
    list \
        [dict get $config applications one.example.test] \
        [dict get $config applications two]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result [list \
    [dict create \
        docroot [file normalize [file join \
            [temporaryDirectory] tclwire-config-[pid] sites one]] \
        encoding iso8859-1 \
        class ::example::Application \
        package example::application \
        hosts one.example.test \
        pool_policy [dict create minimum_workers 2 maximum_workers 8]] \
    [dict create \
        docroot [file normalize [file join \
            [temporaryDirectory] tclwire-config-[pid] sites two]] \
        encoding iso8859-1 \
        class ::example::Application \
        package example::application \
        hosts {two.example.test www.two.example.test} \
        pool_policy [dict create minimum_workers 2 maximum_workers 12]]]

test runtime-1.17 {request memory limits are configurable globally and per service} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
max_request_bytes = 4096
max_header_bytes = 768
request_memory_threshold = 1024

[http]
max_request_bytes = 2048
max_header_bytes = 384
request_memory_threshold = 512
}]
    set from_file [::tclwire::runtime parse_args [list --config $config_file]]
    set from_cli [::tclwire::runtime parse_args [list \
        --max-request-bytes 8192 --max_header_bytes 1536 \
        --request-memory-threshold 2048]]
    list \
        [dict get $from_file max_request_bytes] \
        [dict get [lindex [dict get $from_file services] 0] max_request_bytes] \
        [dict get $from_cli max_request_bytes] \
        [dict get [lindex [dict get $from_cli services] 0] max_request_bytes] \
        [dict get $from_file max_header_bytes] \
        [dict get [lindex [dict get $from_file services] 0] max_header_bytes] \
        [dict get $from_cli max_header_bytes] \
        [dict get [lindex [dict get $from_cli services] 0] max_header_bytes] \
        [dict get $from_file request_memory_threshold] \
        [dict get [lindex [dict get $from_file services] 0] request_memory_threshold] \
        [dict get $from_cli request_memory_threshold]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {4096 2048 8192 8192 768 384 1536 1536 1024 512 2048}

test runtime-1.18 {multipart request dumps are explicitly configurable} -body {
    set config_file [::tclwire::runtime_test::make_config {
[tclwire]
dump_multipart_requests = true
}]
    set defaults [::tclwire::runtime parse_args {}]
    set from_file [::tclwire::runtime parse_args [list --config $config_file]]
    set from_cli [::tclwire::runtime parse_args \
        [list --dump-multipart-requests]]
    list \
        [dict exists $defaults dump_multipart_requests] \
        [dict get $from_file dump_multipart_requests] \
        [dict get $from_cli dump_multipart_requests]
} -cleanup {
    ::tclwire::runtime_test::cleanup
} -result {0 1 1}

::tclwire::runtime_test::cleanup
cleanupTests
