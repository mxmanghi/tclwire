        set bad_args [catch {::rivet::lremove -all {a b}} args_message]
        set bad_binary [catch {::rivet::lremove [list "a\x00b"] *} binary_message]
        list $bad_switch $switch_message $bad_args $args_message \
            $bad_binary $binary_message
