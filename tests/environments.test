package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require Thread
package require fileutil
package require tclwire::application::io 0.1
package require tclwire::stdchans 0.1

namespace eval ::tclwire::environment_test {
    variable events {}
}

oo::class create ::tclwire::environment_test::OutputReceiver {
    method application_output {transaction_id event} {
        lappend ::tclwire::environment_test::events \
            [list $transaction_id $event]
    }
}

proc ::tclwire::route_application_output {agent transaction_id event} {
    $agent application_output $transaction_id $event
    return
}

test stdchans-1.1 {stdchans environment exposes lifecycle metadata} -body {
    list \
        [::tclwire::envs::stdchans name] \
        [::tclwire::envs::stdchans requires] \
        [::tclwire::envs::stdchans path_namespaces] \
        [::tclwire::envs::stdchans enabled]
} -result [list stdchans {} ::tclwire::envs::stdchans 0]

test stdchans-1.2 {stdchans captures app-namespace stdout during active output transaction} -body {
    set ::tclwire::environment_test::events {}
    set receiver [::tclwire::environment_test::OutputReceiver new]
    namespace eval ::tclwire::app {
        variable saved_path [namespace path]
        namespace path [list ::tclwire::envs::stdchans]
    }
    try {
        ::tclwire::envs::stdchans install
        ::tclwire::io begin [::thread::id] $receiver 21
        namespace eval ::tclwire::app {
            puts stdout alpha
            puts -nonewline stdout beta
            puts gamma
        }
        set buffered [::tclwire::io buffer]
        namespace eval ::tclwire::app {
            flush stdout
        }
        ::tclwire::io complete
        ::tclwire::io end
        update

        set output_event \
            [lindex [lindex $::tclwire::environment_test::events 0] 1]
        list \
            $buffered \
            [dict get $output_event type] \
            [dict get $output_event data] \
            [lmap item $::tclwire::environment_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        catch {
            namespace eval ::tclwire::app {
                namespace path $saved_path
                unset saved_path
            }
        }
        catch {::tclwire::envs::stdchans uninstall}
        $receiver destroy
    }
} -result [list "alpha\nbetagamma\n" output "alpha\nbetagamma\n" {output flush complete}]

test stdchans-1.3 {stdchans delegates non-stdout puts to native channels} -body {
    set path [file join [temporaryDirectory] tclwire-stdchans-[pid].txt]
    set channel [open $path w]
    try {
        ::tclwire::envs::stdchans install
        puts $channel alpha
        puts -nonewline $channel beta
        flush $channel
        close $channel
        set channel {}
        ::fileutil::cat -encoding utf-8 $path
    } finally {
        if {$channel ne {}} {
            catch {close $channel}
        }
        catch {::tclwire::envs::stdchans uninstall}
        file delete -force $path
    }
} -result "alpha\nbeta"

test stdchans-1.3a {stdchans delegates malformed puts calls to native command} -body {
    try {
        ::tclwire::envs::stdchans install
        catch {::tclwire::envs::stdchans::puts a b c} message options
        list $message [dict get $options -errorcode]
    } finally {
        catch {::tclwire::envs::stdchans uninstall}
    }
} -result [list {wrong # args: should be "::puts ?-nonewline? ?channelId? string"} \
    {TCL WRONGARGS}]

test stdchans-1.4 {stdchans install is idempotent and uninstall restores commands} -body {
    set original_puts [info command ::puts]
    set original_flush [info command ::flush]
    try {
        ::tclwire::envs::stdchans install
        ::tclwire::envs::stdchans install
        set installed [::tclwire::envs::stdchans enabled]
        ::tclwire::envs::stdchans uninstall
        list \
            $installed \
            [::tclwire::envs::stdchans enabled] \
            [expr {[info command ::puts] eq $original_puts}] \
            [expr {[info command ::flush] eq $original_flush}]
    } finally {
        catch {::tclwire::envs::stdchans uninstall}
    }
} -result {1 0 1 1}

test stdchans-1.5 {stdchans keeps app stdout virtualized after response completion} -body {
    set ::tclwire::environment_test::events {}
    set receiver [::tclwire::environment_test::OutputReceiver new]
    namespace eval ::tclwire::app {
        variable saved_path [namespace path]
        namespace path [list ::tclwire::envs::stdchans]
    }
    try {
        ::tclwire::envs::stdchans install
        ::tclwire::io begin [::thread::id] $receiver 22
        namespace eval ::tclwire::app {
            puts stdout alpha
        }
        ::tclwire::io complete
        namespace eval ::tclwire::app {
            puts stdout ignored
            flush stdout
        }
        set buffered [::tclwire::io buffer]
        ::tclwire::io end
        update

        list \
            $buffered \
            [lmap item $::tclwire::environment_test::events {
                dict get [lindex $item 1] type
            }] \
            [dict get [lindex [lindex \
                $::tclwire::environment_test::events 0] 1] data]
    } finally {
        catch {::tclwire::io end}
        catch {
            namespace eval ::tclwire::app {
                namespace path $saved_path
                unset saved_path
            }
        }
        catch {::tclwire::envs::stdchans uninstall}
        $receiver destroy
    }
} -result [list {} {output complete} "alpha\n"]

cleanupTests
