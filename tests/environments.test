test rivet-1.2g0a {rivet import_keyvalue_pairs imports switches and remaining args} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    try {
        ::tclwire::envs::rivet install
        array unset values
        ::rivet::import_keyvalue_pairs values {-foo one -bar two -- tail args}
        set first [array get values]
        array unset values
        ::rivet::import_keyvalue_pairs values {plain tail}
        set second [array get values]
        set reserved [catch {
            ::rivet::import_keyvalue_pairs values {-args bad}
        } reserved_message]
        list \
            [lsort -stride 2 $first] \
            [lsort -stride 2 $second] \
            $reserved \
            $reserved_message
    } finally {
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
        unset -nocomplain values
    }
} -result [list {args {tail args} bar two foo one} {args {plain tail}} \
    1 {-args is a reserved value.}]

test rivet-1.2g0b {rivet lmatch returns matching list elements} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    try {
        ::tclwire::envs::rivet install
        set bad_mode [catch {
            ::rivet::lmatch -bad {alpha beta} *
        } bad_mode_message]
        set bad_args [catch {
            ::rivet::lmatch only
        } bad_args_message]
        list \
            [::rivet::lmatch {alpha beta alpine} alp*] \
            [::rivet::lmatch -exact {alpha beta alpha} alpha] \
            [::rivet::lmatch -regexp {a1 b2 cc} {\d$}] \
            $bad_mode \
            $bad_mode_message \
            $bad_args \
            $bad_args_message
    } finally {
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
    }
} -result [list \
    {alpha alpine} \
    {alpha alpha} \
    {a1 b2} \
    1 {bad search mode "-bad": must be -exact, -glob, or -regexp} \
    1 {wrong # args: should be "lmatch ?mode? list pattern"}]

