    {::rivet::unescape_string: bad char in hex sequence %zz}]

test rivet-1.2gf {rivet parray writes escaped preformatted array contents} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    namespace eval ::tclwire::environment_test::parray {
        variable output {}
        proc capture {text} {
            variable output
            append output $text
            return
        }
    }
    array set values [list beta {<two>} alpha {one&}]
    try {
        ::tclwire::envs::rivet install
        ::rivet::parray values * ::tclwire::environment_test::parray::capture
        set missing [catch {::rivet::parray scalar} missing_message]
        list $::tclwire::environment_test::parray::output \
            $missing $missing_message
    } finally {
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
        catch {namespace delete ::tclwire::environment_test::parray}
    }
} -result [list \
    "<pre>\n<b>values</b>\nvalues(alpha) = one&amp;\nvalues(beta)  = &lt;two&gt;\n</pre>" \
    1 \
    {"scalar" isn't an array}]

test rivet-1.2gg {rivet parray_table writes escaped HTML table} -body {
    set ::tclwire::environment_test::events {}
    set receiver [::tclwire::environment_test::OutputReceiver new]
    array set values [list beta {<two>} alpha {one&}]
    try {
        ::tclwire::envs::stdchans install
        ::tclwire::envs::rivet install
        ::tclwire::io begin [::thread::id] $receiver 25
        ::rivet::parray_table values * [list class debug id values]
        ::tclwire::io flush
        ::tclwire::io complete
        ::tclwire::io end
        update

        set output_event \
            [lindex [lindex $::tclwire::environment_test::events 0] 1]
        dict get $output_event data
    } finally {
        catch {::tclwire::io end}
        catch {::tclwire::envs::rivet uninstall}
        catch {::tclwire::envs::stdchans uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
        catch {$receiver destroy}
    }
} -result "<table class=\"debug\" id=\"values\"><thead><tr><th colspan=\"2\">values</th></tr></thead>\n<tbody>\n<tr><td>alpha</td><td>one&amp;</td></tr>\n<tr><td>beta</td><td>&lt;two&gt;</td></tr>\n</tbody></table>\n"

test rivet-1.2gh {rivet wrapline wraps a single line on spaces} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    try {
        ::tclwire::envs::rivet install
        list \
            [::rivet::wrapline {alpha beta gamma} 10] \
            [::rivet::wrapline {alpha beta gamma} 10 -html] \
            [::tclwire::envs::rivet::wrapline {supercalifragilistic short} 10] \
            [::rivet::wrapline {a  b} 3]
    } finally {
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
    }
} -result [list "alpha beta\ngamma" {alpha beta<br>gamma} \
    "supercalifragilistic\nshort" "a \nb"]

test rivet-1.2gi {rivet wrap wraps each input line} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    set string "alpha beta gamma\ndelta epsilon"
    try {
        ::tclwire::envs::rivet install
        list \
            [::rivet::wrap $string 10] \
            [::rivet::wrap $string 10 -html] \
            [::tclwire::envs::rivet::wrap $string 10]
    } finally {
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
    }
} -result [list "alpha beta\ngamma\ndelta\nepsilon" \
    {alpha beta<br>gamma<br>delta<br>epsilon} \
    "alpha beta\ngamma\ndelta\nepsilon"]

test rivet-1.2h {rivet xml builds nested and self-closing markup} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    try {
        ::tclwire::envs::rivet install
        list \
            [::rivet::xml Test b i] \
            [::rivet::xml Test [list div class box id testbox] b i] \
            [::rivet::xml [list a attr1 val1 attr2 val2]] \
            [::rivet::xml "" [list a attr1 val1] [list b attr2 val2]]
    } finally {
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
    }
} -result [list \
    {<b><i>Test</i></b>} \
    {<div class="box" id="testbox"><b><i>Test</i></b></div>} \
    {<a attr1="val1" attr2="val2"/>} \
    {<a attr1="val1"><b attr2="val2"></b></a>}]

test rivet-1.2i {rivet html writes tagged output} -body {
    set ::tclwire::environment_test::events {}
    set receiver [::tclwire::environment_test::OutputReceiver new]
    try {
        ::tclwire::envs::stdchans install
        ::tclwire::envs::rivet install
        ::tclwire::io begin [::thread::id] $receiver 24
        ::rivet::html Test b i
        ::tclwire::io flush
        ::tclwire::io complete
        ::tclwire::io end
        update

        set output_event \
            [lindex [lindex $::tclwire::environment_test::events 0] 1]
        list \
            [dict get $output_event type] \
            [dict get $output_event data] \
            [lmap item $::tclwire::environment_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        catch {::tclwire::envs::rivet uninstall}
        catch {::tclwire::envs::stdchans uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
        $receiver destroy
    }
} -result [list output "<b><i>Test</i></b>\n" {output flush complete}]

test rivet-1.3 {rivet inspect options map to configure keys} -body {
    set options {
        ServerInitScript
        GlobalInitScript
        ChildInitScript
        ChildExitScript
        BeforeScript
        AfterScript
        AfterEveryScript
        AbortScript
        ErrorScript
        UploadMaxSize
        UploadDirectory
        UploadFilesToVar
        SeparateVirtualInterps
        HonorHeadRequests
        ImportRivetNS
    }
    list \
        [lmap option $options {
            ::tclwire::envs::rivet::inspect_key $option
        }] \
        [::tclwire::envs::rivet::inspect_value ImportRivetNS] \
        [::tclwire::envs::rivet::inspect_value HonorHeadRequests] \
        [catch {::tclwire::envs::rivet::inspect_key UnknownOption} \
            message] \
        $message
} -result [list \
    {server_init_script global_init_script child_init_script child_exit_script before_script after_script after_every_script abort_script error_script upload_max_size upload_directory upload_files_to_var separate_virtual_interps honor_head_requests import_rivet_ns} \
    false \
    true \
    1 \
    {bad inspect option "UnknownOption": must be ServerInitScript, GlobalInitScript, ChildInitScript, ChildExitScript, BeforeScript, AfterScript, AfterEveryScript, AbortScript, ErrorScript, UploadMaxSize, UploadDirectory, UploadFilesToVar, SeparateVirtualInterps, HonorHeadRequests, ImportRivetNS}]

test rivet-1.3a {rivet inspect -all returns supported configuration values} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    set docroot [makeDirectory rivet-inspect-all-docroot]
    set application {}
    try {
        ::tclwire::envs::rivet install
        set application [::tclwire::CApplication new \
            [dict create \
                docroot $docroot \
                encoding utf-8 \
                package tclwire::application \
                hosts localhost \
                configure [dict create \
                    before_script before.tcl \
                    upload_directory /tmp/rivet-upload \
                    honor_head_requests false]]]
        ::tclwire::app::begin_application \
            [dict create \
                application $application \
                application_class [info object class $application] \
                application_descriptor {} \
                configuration [$application configuration_object] \
                pool_key environment-test]

        set all [::rivet::inspect -all]
        list \
            [dict get $all BeforeScript] \
            [dict get $all UploadDirectory] \
            [dict get $all HonorHeadRequests] \
            [dict get $all ChildInitScript] \
            [dict get $all ImportRivetNS] \
            [lsort [dict keys $all]]
    } finally {
        catch {::tclwire::app::end_application}
        if {$application ne {}} {
            catch {$application destroy}
        }
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
        removeDirectory $docroot
    }
} -result [list \
    before.tcl \
    /tmp/rivet-upload \
    true \
    {} \
    false \
    [lsort {
        ServerInitScript
        GlobalInitScript
        ChildInitScript
        ChildExitScript
        BeforeScript
        AfterScript
        AfterEveryScript
        AbortScript
        ErrorScript
        UploadMaxSize
        UploadDirectory
        UploadFilesToVar
        SeparateVirtualInterps
        HonorHeadRequests
        ImportRivetNS
    }]]

test rivet-1.3b {rivet inspect without arguments returns scoped configuration} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    set docroot [makeDirectory rivet-inspect-scoped-docroot]
    set application {}
    try {
        ::tclwire::envs::rivet install
        set application [::tclwire::CApplication new \
            [dict create \
                docroot $docroot \
                encoding utf-8 \
                package tclwire::application \
                hosts localhost \
                configure [dict create \
                    after_script after.tcl \
                    upload_max_size 4096]]]
        ::tclwire::app::begin_application \
            [dict create \
                application $application \
                application_class [info object class $application] \
                application_descriptor {} \
                configuration [$application configuration_object] \
                pool_key environment-test]

        set scoped [::rivet::inspect]
        set server_config [dict get $scoped server]
        list \
            [lsort [dict keys $scoped]] \
            [dict get $scoped user] \
            [dict get $scoped dir] \
            [dict get $server_config AfterScript] \
            [dict get $server_config UploadMaxSize] \
            [dict exists $server_config BeforeScript]
    } finally {
        catch {::tclwire::app::end_application}
        if {$application ne {}} {
            catch {$application destroy}
        }
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
        removeDirectory $docroot
    }
} -result [list {dir server user} {} {} after.tcl 4096 0]

cleanupTests
