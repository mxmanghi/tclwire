test rivet-1.2d {rivet cookie reads and unsets request cookie jar entries} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    set request [::tclwire::HttpRequest new [dict create \
        method GET \
        target /profile \
        path /profile \
        query {} \
        version 1.1 \
        headers [dict create host example.test cookie {session=abc; theme=light}] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 31]]
    try {
        ::tclwire::envs::rivet install
        ::tclwire::app::begin_request \
            [dict create request $request request_descriptor [$request snapshot]]
        set before [list [::rivet::cookie get session] \
            [::rivet::cookie get missing]]
        ::rivet::cookie unset session
        set after [list [::rivet::cookie get session] \
            [[$request cookie_jar] serialize]]
        list $before $after
    } finally {
        catch {::tclwire::app::end_request}
        catch {$request destroy}
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
    }
} -result [list {abc {}} [list {} [list [list theme light]]]]

test rivet-1.2e {rivet cookie set and delete update jar and emit Set-Cookie headers} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    set ::tclwire::environment_test::events {}
    set receiver [::tclwire::environment_test::OutputReceiver new]
    set request [::tclwire::HttpRequest new [dict create \
        method GET \
        target /profile \
        path /profile \
        query {} \
        version 1.1 \
        headers [dict create host example.test cookie {session=abc}] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 32]]
    try {
        ::tclwire::envs::rivet install
        ::tclwire::app::begin_request \
            [dict create request $request request_descriptor [$request snapshot]]
        ::tclwire::io begin [::thread::id] $receiver 32
        set first [::rivet::cookie set session xyz \
            -expires {Tue, 01-Jan-30 00:00:00 GMT} \
            -path /account \
            -domain example.test \
            -secure 1 \
            -HttpOnly 1]
        set value_after_set [::rivet::cookie get session]
        set second [::rivet::cookie delete session]
        set value_after_delete [::rivet::cookie get session]
        set cookies [::tclwire::http::io header get Set-Cookie]
        ::tclwire::io end
        update

        list $first $value_after_set $second $value_after_delete $cookies
    } finally {
        catch {::tclwire::io end}
        catch {::tclwire::app::end_request}
        catch {$request destroy}
        catch {$receiver destroy}
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
    }
} -match glob -result [list \
    {session=xyz; expires=Tue, 01-Jan-30 00:00:00 GMT; path=/account; domain=example.test; secure; HttpOnly} \
    xyz \
    {session=; expires=* GMT} \
    {} \
    [list \
        {session=xyz; expires=Tue, 01-Jan-30 00:00:00 GMT; path=/account; domain=example.test; secure; HttpOnly} \
        {session=; expires=* GMT}]]

test rivet-1.2ea {rivet load arrays populate caller frame for explicit names} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    unset -nocomplain ::local_env ::local_headers ::local_cookies
    set docroot [makeDirectory rivet-load-frame-docroot]
    set application {}
    set request [::tclwire::HttpRequest new [dict create \
        method POST \
        target /load.tcl?ok=yes \
        path /load.tcl \
        query ok=yes \
        version 1.1 \
        scheme http \
        remote_host 192.0.2.10 \
        remote_port 54321 \
        headers [dict create \
            host example.test \
            x-test-header value \
            cookie {session=abc; theme=light}] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 33]]
    proc ::tclwire::environment_test::load_frame_probe {} {
        ::rivet::load_env local_env
        ::rivet::load_headers local_headers
        ::rivet::load_cookies local_cookies
        list \
            [array exists local_env] \
            $local_env(REQUEST_METHOD) \
            $local_env(HTTP_HOST) \
            [array exists local_headers] \
            $local_headers(X-Test-Header) \
            [array exists local_cookies] \
            $local_cookies(session) \
            [array exists ::local_env] \
            [array exists ::local_headers] \
            [array exists ::local_cookies]
    }
    try {
        ::tclwire::envs::rivet install
        set application [::tclwire::CApplication new \
            [dict create \
                docroot $docroot \
                encoding utf-8 \
                package tclwire::application \
                hosts localhost]]
        ::tclwire::app::begin_application \
            [dict create \
                application $application \
                application_class [info object class $application] \
                application_descriptor {} \
                configuration [$application configuration_object] \
                pool_key environment-test]
        ::tclwire::app::begin_request \
            [dict create request $request request_descriptor [$request snapshot]]
        ::tclwire::environment_test::load_frame_probe
    } finally {
        catch {::tclwire::app::end_request}
        catch {::tclwire::app::end_application}
        if {$application ne {}} {
            catch {$application destroy}
        }
        catch {$request destroy}
        catch {rename ::tclwire::environment_test::load_frame_probe {}}
        unset -nocomplain ::local_env ::local_headers ::local_cookies
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
        removeDirectory $docroot
    }
} -result {1 POST example.test 1 value 1 abc 0 0 0}

test rivet-1.2f {rivet parser compiles mixed template content to Tcl} -body {
    set template {<h1>$title</h1>
<? set title TclWire ?>
<p><?= $title ?></p>
<? puts "<footer>$title</footer>" ?>}
    set script [::tclwire::envs::rivet::parse_template $template]
    set output {}
    namespace eval ::tclwire::environment_test::parser {}
    proc ::tclwire::environment_test::parser::puts {args} {
        variable output
        set nonewline 0
        if {[llength $args] > 0 && [lindex $args 0] eq "-nonewline"} {
            set nonewline 1
            set args [lrange $args 1 end]
        }
        append output [lindex $args end]
        if {!$nonewline} {
            append output "\n"
        }
        return
    }
    try {
        namespace eval ::tclwire::environment_test::parser \
            [list variable output {}]
        namespace eval ::tclwire::environment_test::parser $script
        set ::tclwire::environment_test::parser::output
    } finally {
        catch {namespace delete ::tclwire::environment_test::parser}
    }
} -result "<h1>\$title</h1>\n\n<p>TclWire</p>\n<footer>TclWire</footer>\n"

