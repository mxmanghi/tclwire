test rivet-1.2gdg {rivet read_file reads files with optional channel options} -body {
    catch {::tclwire::envs::rivet uninstall}
    catch {namespace delete ::Rivet}
    catch {namespace delete ::rivet}
    set text_path [file join [temporaryDirectory] rivet-read-file-[pid].txt]
    set binary_path [file join [temporaryDirectory] rivet-read-file-[pid].bin]
    set channel [open $text_path w]
    fconfigure $channel -encoding utf-8
    puts -nonewline $channel "caf\u00e8"
    close $channel
    set channel [open $binary_path w]
    fconfigure $channel -translation binary
    puts -nonewline $channel "a\r\nb"
    close $channel
    try {
        ::tclwire::envs::rivet install
        set bad [catch {::rivet::read_file $text_path -bad value} bad_message]
        list \
            [::rivet::read_file $text_path -encoding utf-8] \
            [string equal [::rivet::read_file $binary_path -translation binary] "a\r\nb"] \
            [::tclwire::envs::rivet::read_file $text_path -encoding utf-8] \
            $bad \
            $bad_message
    } finally {
        catch {close $channel}
        file delete -force $text_path $binary_path
        catch {::tclwire::envs::rivet uninstall}
        catch {namespace delete ::Rivet}
        catch {namespace delete ::rivet}
    }
} -result [list "caf\u00e8" 1 "caf\u00e8" 1 \
    {Bad option "-bad", expected one of -encoding, -eofchar, or -translation}]

