package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::http::codes 0.1
package require tclwire::http::protocol 0.1

test http-codes-1.1 {HTTP code catalog supplies standard reason phrases} -body {
    list \
        [::tclwire::http::codes::reason 100] \
        [::tclwire::http::codes::reason 302] \
        [::tclwire::http::codes::reason 413] \
        [::tclwire::http::codes::reason 502] \
        [::tclwire::http::codes::reason 599]
} -result {Continue Found {Content Too Large} {Bad Gateway} {}}

test http-codes-1.2 {HTTP code catalog exposes its complete map} -body {
    set codes [::tclwire::http::codes::all]
    list \
        [dict get $codes 200] \
        [dict get $codes 407] \
        [dict get $codes 511]
} -result {OK {Proxy Authentication Required} {Network Authentication Required}}

test http-codes-1.3 {HTTP protocol supplies a missing standard reason phrase} -body {
    set session [::tclwire::HttpProtocolSession new]
    try {
        set buffered [$session build_response 201 {} {} utf-8]
        set chunked [$session build_chunked_response_head 204 {} utf-8 {} text]
        list \
            [string range $buffered 0 [expr {[string first "\r\n" $buffered] - 1}]] \
            [string range $chunked 0 [expr {[string first "\r\n" $chunked] - 1}]]
    } finally {
        $session destroy
    }
} -result {{HTTP/1.1 201 Created} {HTTP/1.1 204 No Content}}

cleanupTests
