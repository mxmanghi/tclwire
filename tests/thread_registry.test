package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::accounting 1.2
package require tclwire::tpba 0.1

test thread-registry-1.1 {loading accounting initializes shared references} -body {
    list \
        [::tclwire::accounting is_initialized] \
        [::tsv::get tclwire timestamp] \
        [::tsv::get tclwire accounting] \
        [::tsv::get tclwire tpba_thread_id] \
        [::tsv::get tclwire logger_thread_id]
} -result {1 {} {} {} {}}

test thread-registry-1.2 {TPBA conditionally recreates missing catalog entries} -body {
    catch {::tsv::unset tclwire logger_thread_id}

    set broker [::tclwire::TPBA new]
    try {
        list \
            [::tclwire::accounting is_initialized] \
            [::tsv::exists tclwire logger_thread_id] \
            [::tsv::get tclwire logger_thread_id]
    } finally {
        $broker destroy
    }
} -result {1 1 {}}

test thread-registry-1.3 {registration is owned by the accounting API} -body {
    set thread_id registry-test-thread
    catch {::tclwire::accounting remove_thread $thread_id}
    try {
        ::tclwire::accounting register_thread $thread_id allocated ftp
        set account [::tclwire::accounting get_thread_account $thread_id]
        list \
            [dict get $account status] \
            [dict get $account family] \
            [dict exists $account http_host] \
            [dict get $account nruns]
    } finally {
        ::tclwire::accounting remove_thread $thread_id
    }
} -result {allocated ftp 0 0}

test thread-registry-1.4 {TPBA-created workers are registered by ThreadMaster} -body {
    set worker_script [format {
        lappend auto_path %s
        package require Thread
        package require tclwire::accounting 1.2

        proc demand_thread_exit {} {
            ::thread::release [::thread::id]
        }

        ::thread::wait
        catch {::tclwire::accounting remove_thread [::thread::id]}
    } [list $project_root]]

    set broker [::tclwire::TPBA new]
    try {
        $broker create_pool registry:real $worker_script \
            [dict create maximum_workers 1] \
            [dict create kind protocol family http protocol http]
        set worker_id [$broker acquire_worker registry:real]
        set account [::tclwire::accounting get_thread_account $worker_id]
        list \
            [expr {$worker_id ne {}}] \
            [dict get $account status] \
            [dict get $account family] \
            [dict get $account http_host] \
            [dict get [$broker pool_status registry:real] stats live_threads_number]
    } finally {
        $broker destroy
    }
} -result {1 allocated http {} 1}

test thread-registry-1.5 {HTTP host context can be updated} -body {
    set thread_id registry-http-thread
    catch {::tclwire::accounting remove_thread $thread_id}
    try {
        ::tclwire::accounting register_thread $thread_id running http
        ::tclwire::accounting set_thread_http_host $thread_id www.example.test
        set account [::tclwire::accounting get_thread_account $thread_id]
        list [dict get $account family] [dict get $account http_host]
    } finally {
        ::tclwire::accounting remove_thread $thread_id
    }
} -result {http www.example.test}

test thread-registry-1.6 {non-HTTP workers reject HTTP host context} -body {
    set thread_id registry-ftp-thread
    catch {::tclwire::accounting remove_thread $thread_id}
    try {
        ::tclwire::accounting register_thread $thread_id running ftp
        catch {
            ::tclwire::accounting set_thread_http_host $thread_id invalid.example
        } message
        set message
    } finally {
        ::tclwire::accounting remove_thread $thread_id
    }
} -result {Thread registry-ftp-thread does not belong to the http family}

cleanupTests
