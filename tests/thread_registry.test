package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::shared_state 0.1
package require tclwire::accounting 1.2
package require tclwire::connection_agent 0.1
package require tclwire::tpba 0.1

namespace eval ::tclwire::thread_registry_test {}

test thread-registry-1.1 {accounting package initializes usable shared state} -body {
    set thread_id registry-init-thread
    set connection_key init:1
    catch {::tclwire::accounting remove_thread $thread_id}
    catch {::tclwire::accounting remove_connection $connection_key}
    try {
        ::tclwire::shared_state initialize
        ::tclwire::shared_state initialize
        ::tclwire::accounting register_thread $thread_id allocated http
        ::tclwire::accounting record_connection_opened $connection_key \
            [dict create connection_id 1 protocol init service_id init:1]
        set thread_record [::tclwire::accounting get_thread_account $thread_id]
        set connection_record \
            [::tclwire::accounting get_connection_record $connection_key]
        list \
            [dict get $thread_record status] \
            [dict get $thread_record family] \
            [dict get $connection_record status] \
            [dict get $connection_record protocol]
    } finally {
        ::tclwire::accounting remove_thread $thread_id
        ::tclwire::accounting remove_connection $connection_key
    }
} -result {allocated http opening init}

test thread-registry-1.2 {connection agents require connection keys} -body {
    catch {
        ::tclwire::ConnectionAgent new stdin 1 127.0.0.1 1234 {}
    } message
    set message
} -result {connection agent requires connection key}

test thread-registry-1.2a {connection agents require a pool key} -body {
    catch {
        ::tclwire::start_connection_agent \
            ::tclwire::ConnectionAgent stdin 1 test:1 \
            127.0.0.1 1234 {} {} {   } {} {}
    } message
    set message
} -result {connection agent pool key must not be empty}

test thread-registry-1.2b {stored connection registrations require structural fields} -body {
    oo::class create ::tclwire::thread_registry_test::RegistrationAgent {
        superclass ::tclwire::ConnectionAgent
    }
    lassign [chan pipe] read_channel write_channel
    set agent [::tclwire::thread_registry_test::RegistrationAgent new \
        $read_channel 1 127.0.0.1 1234 registration-test:1]
    try {
        catch {
            ::tclwire::store_connection_registration [dict create \
                channel_key $read_channel \
                agent $agent \
                connection_id 1 \
                connection_key registration-test:1 \
                finished_thread {} \
                finished_command {} \
                pool_key {}]
        } message
        set message
    } finally {
        catch {$agent destroy}
        catch {close $write_channel}
        catch {::tclwire::thread_registry_test::RegistrationAgent destroy}
    }
} -result {connection registration is missing pool_key}

test thread-registry-1.3 {registration is owned by the accounting API} -body {
    set thread_id registry-test-thread
    catch {::tclwire::accounting remove_thread $thread_id}
    try {
        ::tclwire::accounting register_thread $thread_id allocated ftp
        set account [::tclwire::accounting get_thread_account $thread_id]
        list \
            [dict get $account status] \
            [dict get $account family] \
            [dict get $account http_host] \
            [dict exists $account nruns]
    } finally {
        ::tclwire::accounting remove_thread $thread_id
    }
} -result {allocated ftp {} 0}

test thread-registry-1.3a {thread workload fields are mirrored in accounting} -body {
    set thread_id registry-workload-thread
    catch {::tclwire::accounting remove_thread $thread_id}
    try {
        ::tclwire::accounting register_thread $thread_id allocated ftp
        set initial [::tclwire::accounting get_thread_account $thread_id]
        ::tclwire::accounting update_thread_workload $thread_id \
            [dict create running_workload 2 cumulative_workload 5 combined_workload 15]
        set updated [::tclwire::accounting get_thread_account $thread_id]
        list \
            [dict get $initial running_workload] \
            [dict get $initial cumulative_workload] \
            [dict get $initial combined_workload] \
            [dict get $updated running_workload] \
            [dict get $updated cumulative_workload] \
            [dict get $updated combined_workload]
    } finally {
        ::tclwire::accounting remove_thread $thread_id
    }
} -result {0 0 0 2 5 15}

test thread-registry-1.4 {TPBA-created workers are registered by ThreadMaster} -body {
    set worker_script [format {
        lappend auto_path %s
        package require Thread
        package require tclwire::accounting 1.2

        proc demand_thread_exit {} {
            ::thread::release [::thread::id]
        }

        ::thread::wait
        catch {::tclwire::accounting remove_thread [::thread::id]}
    } [list $project_root]]

    set broker [::tclwire::TPBA new]
    try {
        $broker create_pool registry:real $worker_script \
            [dict create maximum_workers 1] \
            [dict create kind protocol family http protocol http]
        set worker_id [$broker acquire_worker registry:real]
        set account [::tclwire::accounting get_thread_account $worker_id]
        list \
            [expr {$worker_id ne {}}] \
            [dict get $account status] \
            [dict get $account family] \
            [dict get $account http_host] \
            [dict get [$broker pool_status registry:real] stats live_threads_number]
    } finally {
        $broker destroy
    }
} -result {1 allocated http {} 1}

test thread-registry-1.4.1 {ThreadMaster prunes owned workers with no account} -body {
    set worker_script [format {
        lappend auto_path %s
        package require Thread
        package require tclwire::accounting 1.2

        proc demand_thread_exit {} {
            ::thread::release [::thread::id]
        }

        ::thread::wait
        catch {::tclwire::accounting remove_thread [::thread::id]}
    } [list $project_root]]

    set master [::tclwire::ThreadMaster new $worker_script 1 http]
    set worker_id {}
    try {
        set worker_id [$master acquire_worker]
        ::tclwire::accounting remove_thread $worker_id
        list \
            [$master thread_ids all] \
            [$master live_threads_number]
    } finally {
        if {$worker_id ne {}} {
            catch {::thread::send -async $worker_id demand_thread_exit}
            catch {::tclwire::accounting remove_thread $worker_id}
        }
        $master destroy
    }
} -result {{} 0}

test thread-registry-1.4.2 {ThreadMaster removes an owned worker from the pool} -body {
    set worker_script [format {
        lappend auto_path %s
        package require Thread
        package require tclwire::accounting 1.2

        proc demand_thread_exit {} {
            ::thread::release [::thread::id]
        }

        ::thread::wait
        catch {::tclwire::accounting remove_thread [::thread::id]}
    } [list $project_root]]

    set master [::tclwire::ThreadMaster new $worker_script 1 http]
    set worker_id {}
    try {
        set worker_id [$master acquire_worker]
        set removed [$master remove_thread $worker_id]
        list \
            $removed \
            [$master owns_thread $worker_id] \
            [$master live_threads_number]
    } finally {
        if {$worker_id ne {}} {
            catch {::thread::send -async $worker_id demand_thread_exit}
            catch {::tclwire::accounting remove_thread $worker_id}
        }
        $master destroy
    }
} -result {true 0 0}

test thread-registry-1.4.3 {plain metric maintains a FIFO eligible queue} -body {
    set worker_script {
        package require Thread
        proc demand_thread_exit {} {::thread::release [::thread::id]}
        ::thread::wait
    }
    set master [::tclwire::ThreadMaster new $worker_script 2 app]
    set worker_ids {}
    try {
        $master configure_metric ::tclwire::PlainMetric [dict create]
        set first [$master acquire_worker]
        set second [$master acquire_worker]
        set worker_ids [list $first $second]
        $master thread_workload_changed $first request-processed
        $master thread_workload_changed $second request-processed
        set queued [dict get [$master stats] eligible_threads_list]
        set selected_first [$master acquire_worker]
        set selected_second [$master acquire_worker]
        list \
            [expr {$queued eq [list $first $second]}] \
            [expr {$selected_first eq $first}] \
            [expr {$selected_second eq $second}]
    } finally {
        foreach worker_id $worker_ids {
            catch {::thread::send -async $worker_id demand_thread_exit}
            catch {::tclwire::accounting remove_thread $worker_id}
        }
        $master destroy
    }
} -result {1 1 1}

test thread-registry-1.4.4 {connection metric reorders eligibility on workload transitions} -body {
    set worker_script {
        package require Thread
        proc demand_thread_exit {} {::thread::release [::thread::id]}
        ::thread::wait
    }
    set master [::tclwire::ThreadMaster new $worker_script 2 http]
    set worker_ids {}
    try {
        $master configure_metric ::tclwire::ConcurrentConnectionMetric \
            [dict create max_conn_per_thread 5]
        set first [$master acquire_worker]
        set second [$master acquire_worker]
        set worker_ids [list $first $second]
        $master return_thread $first
        $master return_thread $second
        $master thread_workload_changed $first new-connection-processing
        $master thread_workload_changed $first connection-open
        $master thread_workload_changed $second new-connection-processing
        $master thread_workload_changed $second connection-open
        $master thread_workload_changed $second new-connection-processing
        $master thread_workload_changed $second connection-open
        set queued [dict get [$master stats] eligible_threads_list]
        set selected [$master acquire_worker]
        list \
            [expr {$queued eq [list $first $second]}] \
            [expr {$selected eq $first}]
    } finally {
        foreach worker_id $worker_ids {
            catch {::thread::send -async $worker_id demand_thread_exit}
            catch {::tclwire::accounting remove_thread $worker_id}
        }
        $master destroy
    }
} -result {1 1}

test thread-registry-1.4.5 {connection reservations enforce transition order} -body {
    set worker_script {
        package require Thread
        proc demand_thread_exit {} {::thread::release [::thread::id]}
        ::thread::wait
    }
    set master [::tclwire::ThreadMaster new $worker_script 1 http]
    set worker_id {}
    try {
        $master configure_metric ::tclwire::ConcurrentConnectionMetric \
            [dict create max_conn_per_thread 3]
        set worker_id [$master acquire_worker]
        set missing_reservation [catch {
            $master thread_workload_changed $worker_id connection-open
        } message]

        $master thread_workload_changed $worker_id new-connection-processing
        $master thread_workload_changed $worker_id connection-open
        $master thread_workload_changed $worker_id new-connection-processing

        # Closing the established connection must not consume the other
        # connection's pending reservation.
        $master thread_workload_changed $worker_id connection-closed
        set record [$master thread_workload_changed \
            $worker_id connection-open]
        list \
            $missing_reservation \
            [string match "connection-open without a reservation*" $message] \
            [dict get $record running_workload] \
            [dict get $record cumulative_workload]
    } finally {
        if {$worker_id ne {}} {
            catch {::thread::send -async $worker_id demand_thread_exit}
            catch {::tclwire::accounting remove_thread $worker_id}
        }
        $master destroy
    }
} -result {1 1 1 2}

test thread-registry-1.5 {HTTP host context can be updated} -body {
    set thread_id registry-http-thread
    set https_thread_id registry-https-thread
    catch {::tclwire::accounting remove_thread $thread_id}
    catch {::tclwire::accounting remove_thread $https_thread_id}
    try {
        ::tclwire::accounting register_thread $thread_id running http
        ::tclwire::accounting register_thread $https_thread_id running https
        ::tclwire::accounting set_thread_http_host $thread_id www.example.test
        ::tclwire::accounting set_thread_http_host $https_thread_id secure.example.test
        set account [::tclwire::accounting get_thread_account $thread_id]
        set https_account [::tclwire::accounting get_thread_account $https_thread_id]
        list \
            [dict get $account family] \
            [dict get $account http_host] \
            [dict get $https_account family] \
            [dict get $https_account http_host]
    } finally {
        ::tclwire::accounting remove_thread $thread_id
        ::tclwire::accounting remove_thread $https_thread_id
    }
} -result {http www.example.test https secure.example.test}

test thread-registry-1.6 {non-HTTP workers reject HTTP host context} -body {
    set thread_id registry-ftp-thread
    catch {::tclwire::accounting remove_thread $thread_id}
    try {
        ::tclwire::accounting register_thread $thread_id running ftp
        catch {
            ::tclwire::accounting set_thread_http_host $thread_id invalid.example
        } message
        set message
    } finally {
        ::tclwire::accounting remove_thread $thread_id
    }
} -result {Thread registry-ftp-thread does not belong to the http family}

test thread-registry-1.7 {connection records are created and updated by accounting API} -body {
    set connection_key http:8990#1
    catch {::tclwire::accounting remove_connection $connection_key}
    try {
        ::tclwire::accounting record_connection_opened $connection_key \
            [dict create \
                connection_id 1 \
                protocol http \
                service_id http:8990 \
                listener_host 127.0.0.1 \
                listener_port 8990 \
                peer_host 127.0.0.1 \
                peer_port 54321 \
                pool_key connection:http:8990 \
                worker_thread_id registry-http-thread \
                agent_class ::tclwire::HttpConnectionAgent]
        ::tclwire::accounting update_connection $connection_key \
            [dict create status open current_transaction_id 7 \
                         current_command GET \
                         bytes_in 45 bytes_out 120]
        set count [::tclwire::accounting increment_connection_request_count \
            $connection_key [dict create current_command POST]]
        set record [::tclwire::accounting get_connection_record $connection_key]
        list \
            $count \
            [dict get $record connection_key] \
            [dict get $record status] \
            [dict get $record protocol] \
            [dict get $record service_id] \
            [dict get $record current_transaction_id] \
            [dict get $record current_command] \
            [dict get $record request_count] \
            [dict get $record bytes_in] \
            [dict get $record bytes_out] \
            [expr {[dict get $record opened_at] > 0}] \
            [expr {[dict get $record last_activity_at] > 0}]
    } finally {
        ::tclwire::accounting remove_connection $connection_key
    }
} -result {1 http:8990#1 open http http:8990 7 POST 1 45 120 1 1}

test thread-registry-1.8 {closing a connection removes it from shared accounting} -body {
    set connection_key ftp:2121#4
    catch {::tclwire::accounting remove_connection $connection_key}
    try {
        ::tclwire::accounting record_connection_opened $connection_key \
            [dict create connection_id 4 protocol ftp service_id ftp:2121]
        set closed [::tclwire::accounting record_connection_closed $connection_key \
            [dict create close_reason client_closed]]
        set exists [dict exists [::tclwire::accounting get_connections_database] \
            $connection_key]
        list \
            [dict get $closed status] \
            [dict get $closed close_reason] \
            [expr {[dict get $closed closed_at] > 0}] \
            $exists
    } finally {
        catch {::tclwire::accounting remove_connection $connection_key}
    }
} -result {closed client_closed 1 0}

test thread-registry-1.9 {connection accounting validates status and fields} -body {
    set connection_key bad:1
    catch {::tclwire::accounting remove_connection $connection_key}
    try {
        list \
            [catch {
                ::tclwire::accounting record_connection_opened $connection_key \
                    [dict create status invalid]
            } status_message] $status_message \
            [catch {
                ::tclwire::accounting record_connection_opened $connection_key \
                    [dict create unknown_field value]
            } field_message] $field_message
    } finally {
        catch {::tclwire::accounting remove_connection $connection_key}
    }
} -result [list \
    1 {Unknown connection status 'invalid'} \
    1 {unknown connection record field 'unknown_field'}]

test thread-registry-1.10 {failed connection close returns final snapshot and removes record} -body {
    set connection_key http:8990#failed
    catch {::tclwire::accounting remove_connection $connection_key}
    try {
        ::tclwire::accounting record_connection_opened $connection_key \
            [dict create connection_id 5 protocol http service_id http:8990]
        set closed [::tclwire::accounting record_connection_closed $connection_key \
            [dict create status failed close_reason write_failed \
                         transport_error write_failed]]
        set exists [dict exists [::tclwire::accounting get_connections_database] \
            $connection_key]
        list \
            [dict get $closed status] \
            [dict get $closed close_reason] \
            [dict get $closed transport_error] \
            [expr {[dict get $closed closed_at] > 0}] \
            $exists
    } finally {
        catch {::tclwire::accounting remove_connection $connection_key}
    }
} -result {failed write_failed write_failed 1 0}

test thread-registry-1.10a {debug connection accounting retains closed records} -body {
    set connection_key http:8990#debug-close
    catch {::tclwire::accounting remove_connection $connection_key}
    ::tclwire::accounting configure_debug_connection 1
    try {
        ::tclwire::accounting record_connection_opened $connection_key \
            [dict create connection_id 6 protocol http service_id http:8990]
        set closed [::tclwire::accounting record_connection_closed $connection_key \
            [dict create close_reason debug_closed]]
        set record [::tclwire::accounting get_connection_record $connection_key]
        list \
            [::tclwire::accounting debug_connection_enabled] \
            [dict get $closed status] \
            [dict get $record status] \
            [dict get $record close_reason] \
            [expr {[dict get $record closed_at] > 0}]
    } finally {
        catch {::tclwire::accounting remove_connection $connection_key}
        ::tclwire::accounting configure_debug_connection 0
    }
} -result {1 closed closed debug_closed 1}

test thread-registry-1.11 {accounting keyed access rejects missing records} -body {
    set thread_id registry-missing-thread
    set connection_key registry:missing
    catch {::tclwire::accounting remove_thread $thread_id}
    catch {::tclwire::accounting remove_connection $connection_key}

    list \
        [catch {::tclwire::accounting get_thread_account $thread_id} thread_get] \
        $thread_get \
        [catch {::tclwire::accounting remove_thread $thread_id} thread_remove] \
        $thread_remove \
        [catch {::tclwire::accounting get_connection_record $connection_key} connection_get] \
        $connection_get \
        [catch {::tclwire::accounting record_connection_closed $connection_key} connection_close] \
        $connection_close \
        [catch {::tclwire::accounting remove_connection $connection_key} connection_remove] \
        $connection_remove
} -result [list \
    1 {Thread registry-missing-thread account doesn't exist} \
    1 {Thread registry-missing-thread account doesn't exist} \
    1 {Connection registry:missing record doesn't exist} \
    1 {Connection registry:missing record doesn't exist} \
    1 {Connection registry:missing record doesn't exist}]

cleanupTests
