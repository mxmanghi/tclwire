package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::http::forwarded 0.1
package require tclwire::http::request 0.1

test http-forwarded-1.1 {trusted proxy matching supports IPv4 CIDRs} -body {
    set networks [::tclwire::http::forwarded compile_trusted_proxies \
        {127.0.0.1 10.20.0.0/16}]
    list \
        [::tclwire::http::forwarded address_is_trusted 127.0.0.1 $networks] \
        [::tclwire::http::forwarded address_is_trusted 10.20.99.4 $networks] \
        [::tclwire::http::forwarded address_is_trusted 10.21.0.1 $networks]
} -result {1 1 0}

test http-forwarded-1.2 {trusted proxy matching supports IPv6 CIDRs} -body {
    set networks [::tclwire::http::forwarded compile_trusted_proxies \
        {::1 2001:db8:abcd::/48}]
    list \
        [::tclwire::http::forwarded address_is_trusted ::1 $networks] \
        [::tclwire::http::forwarded address_is_trusted \
            2001:db8:abcd:1::20 $networks] \
        [::tclwire::http::forwarded address_is_trusted \
            2001:db8:abce::20 $networks]
} -result {1 1 0}

test http-forwarded-1.2a {forwarded addresses are normalized by Tcllib} -body {
    ::tclwire::http::forwarded parse_x_forwarded_for \
        {001.002.003.004, 2001:0db8:0:0::1}
} -result {1.2.3.4 2001:db8::1}

test http-forwarded-1.3 {untrusted peers cannot spoof the effective client} -body {
    set networks [::tclwire::http::forwarded compile_trusted_proxies \
        {127.0.0.1/32}]
    ::tclwire::http::forwarded resolve_client \
        198.51.100.20 192.0.2.99 $networks
} -result [dict create \
    client_host 198.51.100.20 forwarded_for 192.0.2.99]

test http-forwarded-1.4 {a trusted proxy contributes its observed client} -body {
    set networks [::tclwire::http::forwarded compile_trusted_proxies \
        {127.0.0.1/32}]
    ::tclwire::http::forwarded resolve_client \
        127.0.0.1 {192.0.2.99, 198.51.100.20} $networks
} -result [dict create \
    client_host 198.51.100.20 \
    forwarded_for {192.0.2.99 198.51.100.20}]

test http-forwarded-1.5 {resolution walks a chain of trusted proxies} -body {
    set networks [::tclwire::http::forwarded compile_trusted_proxies \
        {127.0.0.1/32 10.20.0.0/16}]
    ::tclwire::http::forwarded resolve_client \
        127.0.0.1 {203.0.113.9, 10.20.2.5} $networks
} -result [dict create \
    client_host 203.0.113.9 forwarded_for {203.0.113.9 10.20.2.5}]

test http-forwarded-1.6 {malformed forwarding data falls back to the peer} -body {
    set networks [::tclwire::http::forwarded compile_trusted_proxies \
        {127.0.0.1/32}]
    ::tclwire::http::forwarded resolve_client \
        127.0.0.1 {192.0.2.10, unknown} $networks
} -result [dict create client_host 127.0.0.1 forwarded_for {}]

test http-forwarded-1.7 {invalid trusted proxy prefixes are rejected} -body {
    list \
        [catch {
            ::tclwire::http::forwarded compile_trusted_proxies {10.0.0.0/33}
        } ipv4] $ipv4 \
        [catch {
            ::tclwire::http::forwarded compile_trusted_proxies {2001:db8::/129}
        } ipv6] $ipv6
} -result [list \
    1 {invalid trusted proxy prefix: 10.0.0.0/33} \
    1 {invalid trusted proxy prefix: 2001:db8::/129}]

test http-forwarded-1.8 {HttpRequest exposes peer and client separately} -body {
    set request [::tclwire::HttpRequest new [dict create \
        remote_host 127.0.0.1 \
        forwarded_for {192.0.2.99 198.51.100.20} \
        client_host 198.51.100.20]]
    try {
        list [$request remote_host] [$request forwarded_for] \
            [$request client_host]
    } finally {
        $request destroy
    }
} -result {127.0.0.1 {192.0.2.99 198.51.100.20} 198.51.100.20}

test http-forwarded-1.9 {older request descriptors use their peer as client} -body {
    set request [::tclwire::HttpRequest new \
        [dict create remote_host 198.51.100.20]]
    try {
        list [$request remote_host] [$request forwarded_for] \
            [$request client_host]
    } finally {
        $request destroy
    }
} -result {198.51.100.20 {} 198.51.100.20}

cleanupTests
