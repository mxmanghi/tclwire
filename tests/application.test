package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require Thread
package require tclwire::application::io 0.1
package require tclwire::http::application::io 0.1
package require tclwire::application 0.1
package require tclwire::application_dispatcher 0.1
package require tclwire::connection_agent 0.1
package require tclwire::http::errors 0.1

namespace eval ::tclwire::application_test {
    variable events {}
}

oo::class create ::tclwire::application_test::OutputReceiver {
    method application_output {transaction_id event} {
        lappend ::tclwire::application_test::events \
            [list $transaction_id $event]
    }
}

set application_config [dict create \
    docroot [file normalize /tmp/tclwire-default-docroot] \
    encoding utf-8 \
    default_application default \
    applications [dict create \
        default [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts {localhost 127.0.0.1}]]]

test application-dispatcher-1.1 {missing Host selects the default application} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        $dispatcher select_application [dict create headers [dict create]]
    } finally {
        $dispatcher destroy
    }
} -result default

test application-dispatcher-1.2 {configured hosts select the default application} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        list \
            [$dispatcher select_application [dict create \
                headers [dict create host localhost:8990]]] \
            [$dispatcher select_application [dict create \
                headers [dict create host 127.0.0.1]]]
    } finally {
        $dispatcher destroy
    }
} -result {default default}

test application-dispatcher-1.3 {unknown hosts are rejected} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        catch {
            $dispatcher select_application [dict create \
                headers [dict create host unknown.example]]
        } message
        set message
    } finally {
        $dispatcher destroy
    }
} -result {no application is configured for Host 'unknown.example'}

test application-dispatcher-1.4 {applications inherit the global document root} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        dict get [$dispatcher application default] docroot
    } finally {
        $dispatcher destroy
    }
} -result [file normalize /tmp/tclwire-default-docroot]

test application-dispatcher-1.5 {applications inherit the global encoding} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        dict get [$dispatcher application default] encoding
    } finally {
        $dispatcher destroy
    }
} -result utf-8

test application-dispatcher-1.6 {an application document root overrides the global default} -body {
    set config $application_config
    dict set config applications default docroot \
        [file normalize /tmp/tclwire-application-docroot]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        dict get [$dispatcher application default] docroot
    } finally {
        $dispatcher destroy
    }
} -result [file normalize /tmp/tclwire-application-docroot]

test application-dispatcher-1.7 {an explicit application root needs no global fallback} -body {
    set config [dict remove $application_config docroot]
    dict set config applications default docroot \
        [file normalize /tmp/tclwire-explicit-docroot]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        dict get [$dispatcher application default] docroot
    } finally {
        $dispatcher destroy
    }
} -result [file normalize /tmp/tclwire-explicit-docroot]

test application-dispatcher-1.8 {file-backed applications use source in workers} -setup {
    set application_file [makeFile {
oo::class create ::example::Application {
    constructor {descriptor} {}
    method handle_request {descriptor} {}
}
} file-backed-application.tcl]
} -body {
    set config $application_config
    dict set config applications default [dict create \
        class ::example::Application \
        file $application_file \
        hosts example.test \
        docroot /tmp \
        encoding utf-8]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set script [$dispatcher worker_script \
            [dict get $config applications default]]
        list \
            [expr {[string first [list source $application_file] $script] >= 0}] \
            [expr {[string first {package require tclwire::application 0.1} \
                $script] < 0}]
    } finally {
        $dispatcher destroy
    }
} -cleanup {
    removeFile $application_file
} -result {1 1}

test application-dispatcher-1.9 {package-backed applications remain supported} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set descriptor [dict get $application_config applications default]
        expr {[string first \
            {package require tclwire::application 0.1} \
            [$dispatcher worker_script $descriptor]] >= 0}
    } finally {
        $dispatcher destroy
    }
} -result 1

test application-1.1 {CApplication receives its effective document root} -body {
    set descriptor [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot ./application-root \
        encoding iso8859-1]
    set application [::tclwire::CApplication new $descriptor]
    try {
        list \
            [$application document_root] \
            [dict get [$application configuration] docroot] \
            [$application encoding]
    } finally {
        $application destroy
    }
} -result [list \
    [file normalize ./application-root] \
    ./application-root \
    iso8859-1]

test application-1.2 {CApplication reads content using its configured encoding} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-[pid]]
    set expected "Caff\u00e8"
    ::fileutil::writeFile -encoding iso8859-1 \
        [file join $docroot index.html] $expected
    set descriptor [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot $docroot \
        encoding iso8859-1]
    set application [::tclwire::CApplication new $descriptor]
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    try {
        ::tclwire::io begin [::thread::id] $receiver 8
        $application handle_request [dict create path /]
        ::tclwire::io end
        update
        set response_event \
            [lindex [lindex $::tclwire::application_test::events 0] 1]
        set output_event \
            [lindex [lindex $::tclwire::application_test::events 1] 1]
        list \
            [dict get $response_event type] \
            [dict get $response_event flags body_mode] \
            [encoding convertfrom iso8859-1 \
                [dict get $output_event data]]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
        $application destroy
        file delete -force $docroot
    }
} -result [list response binary "Caff\u00e8"]

test application-1.3 {CApplication maps URL paths beneath its document root} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-[pid]]
    file mkdir [file join $docroot assets]
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot assets hello.txt] hello
    set application [::tclwire::CApplication new [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot $docroot \
        encoding utf-8]]
    try {
        list \
            [$application local_path /assets/hello.txt] \
            [$application local_path /assets/../hello.txt] \
            [$application local_path /%2e%2e/secret.txt]
    } finally {
        $application destroy
        file delete -force $docroot
    }
} -result [list \
    [file join [temporaryDirectory] tclwire-application-[pid] assets hello.txt] \
    {} \
    {}]

test application-io-1.1 {output commands send ordered transaction events} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 7
        ::tclwire::io out alpha
        ::tclwire::io flush
        ::tclwire::io complete
        ::tclwire::io end
        update

        set summary {}
        foreach item $::tclwire::application_test::events {
            lassign $item transaction_id event
            lappend summary \
                $transaction_id \
                [dict get $event type] \
                [dict get $event output_sequence]
        }
        set summary
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {7 output 1 7 flush 2 7 complete 3}

test http-application-io-1.1 {HTTP header commands maintain and emit metadata} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 9
        ::tclwire::http::io header set Transfer-Encoding chunked
        ::tclwire::http::io header add Set-Cookie first=1
        ::tclwire::http::io header add Set-Cookie second=2
        set transfer_encoding \
            [::tclwire::http::io header get transfer-encoding]
        set cookies [::tclwire::http::io header get set-cookie]
        ::tclwire::http::io header remove Set-Cookie
        set removed [::tclwire::http::io header get Set-Cookie]
        ::tclwire::io end
        update

        set operations {}
        foreach item $::tclwire::application_test::events {
            set event [lindex $item 1]
            lappend operations \
                [dict get $event type] \
                [dict get $event flags action]
        }
        list $transfer_encoding $cookies $removed $operations
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    chunked \
    {first=1 second=2} \
    {} \
    {http_header set http_header add http_header add http_header remove}]

test http-application-io-1.2 {HTTP response headers reject line injection} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 10
        catch {
            ::tclwire::http::io header set X-Test "valid\r\nInjected: yes"
        } message
        set message
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {invalid HTTP response header value}

test http-application-io-1.3 {HTTP cookies support paths and expiration} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 11
        set first [::tclwire::http::io cookie session abc123 \
            -path /account -expires 1893456000]
        set second [::tclwire::http::io cookie preference compact]
        set cookies [::tclwire::http::io header get Set-Cookie]
        ::tclwire::io end
        update

        set emitted {}
        foreach item $::tclwire::application_test::events {
            set event [lindex $item 1]
            lappend emitted \
                [dict get $event flags action] \
                [dict get $event flags value]
        }
        list $first $second $cookies $emitted
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
    {preference=compact} \
    [list \
        {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
        {preference=compact}] \
    [list \
        add \
        {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
        add \
        {preference=compact}]]

test http-application-io-1.4 {HTTP cookie expiration accepts dates} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 12
        ::tclwire::http::io cookie session abc123 \
            -expires {2030-01-01 00:00:00 UTC}
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {session=abc123; Expires=Tue, 01 Jan 2030 00:00:00 GMT}

test http-application-io-1.5 {HTTP cookies reject invalid attributes} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 13
        set messages {}
        foreach command {
            {::tclwire::http::io cookie {bad name} value}
            {::tclwire::http::io cookie name {bad;value}}
            {::tclwire::http::io cookie name value -path relative}
            {::tclwire::http::io cookie name value -expires never-ever}
        } {
            catch $command message
            lappend messages $message
        }
        set messages
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    {invalid HTTP cookie name} \
    {invalid HTTP cookie value} \
    {invalid HTTP cookie path} \
    {invalid HTTP cookie expiration}]

test http-errors-1.1 {HTTP errors are loaded from the root JSON catalog} -body {
    set response [::tclwire::http::errors response 503]
    list \
        [dict get $response status] \
        [dict get $response reason] \
        [string match \
            {*The service is temporarily unavailable. Try again later.*} \
            [dict get $response body]]
} -result {503 {Service Unavailable} 1}

test http-errors-1.2 {error template values are HTML escaped} -body {
    set response [::tclwire::http::errors response 404 \
        [dict create path {/<missing>&}]]
    list \
        [dict get $response reason] \
        [string match {*<code>/&lt;missing&gt;&amp;</code>*} \
            [dict get $response body]]
} -result {{Not Found} 1}

test http-errors-1.3 {unknown statuses use the catalog fallback template} -body {
    set response [::tclwire::http::errors response 599]
    list \
        [dict get $response status] \
        [dict get $response reason] \
        [string match {*<h1>599 Error</h1>*} [dict get $response body]]
} -result {599 {Internal Server Error} 1}

cleanupTests
