test application-dispatcher-1.9a {
    worker auto_path includes application paths before package loading
} -body {
    set config $application_config
    set docroot [file normalize /tmp/tclwire-package-docroot]
    set libdir [file normalize /tmp/tclwire-package-libdir]
    dict set config applications default docroot $docroot
    dict set config applications default libdir $libdir
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set configuration [$dispatcher application_configuration default]
        set script [$dispatcher worker_script $configuration app:default]
        set project_root_index [string first $project_root $script]
        set docroot_index [string first $docroot $script]
        set libdir_index [string first $libdir $script]
        set package_index [string first \
            {package require tclwire::application 0.1} $script]
        list \
            [expr {$project_root_index >= 0}] \
            [expr {$docroot_index > $project_root_index}] \
            [expr {$libdir_index > $docroot_index}] \
            [expr {$package_index > $libdir_index}]
    } finally {
        $dispatcher destroy
    }
} -result {1 1 1 1}

test application-dispatcher-1.9b {
    worker scripts notify their pool before removing accounting
} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set configuration [$dispatcher application_configuration default]
        set script [$dispatcher worker_script $configuration app:default]
        list \
            [expr {[string first {operation remove_worker} $script] >= 0}] \
            [expr {[string first {pool_key app:default} $script] >= 0}] \
            [expr {[string first {operation remove_worker} $script] < \
                [string first {::tclwire::accounting remove_thread} $script]}]
    } finally {
        $dispatcher destroy
    }
} -result {1 1 1}

test application-dispatcher-1.9bb {
    worker scripts initialize applications before waiting and shutdown after
} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set configuration [$dispatcher application_configuration default]
        set script [$dispatcher worker_script $configuration app:default]
        set initialize_index [string first {::tclwire::cga::initialize} $script]
        set signal_index [string first {proc application_signal} $script]
        set wait_index [string first {::thread::wait} $script]
        set shutdown_index [string first {::tclwire::cga::shutdown} $script]
        list \
            [expr {$initialize_index >= 0}] \
            [expr {$initialize_index < $signal_index}] \
            [expr {$signal_index < $wait_index}] \
            [expr {$wait_index < $shutdown_index}]
    } finally {
        $dispatcher destroy
    }
} -result {1 1 1 1}

test application-dispatcher-1.9ba {
    application worker scripts require a pool key
} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set configuration [$dispatcher application_configuration default]
        catch {$dispatcher worker_script $configuration {   }} message
        set message
    } finally {
        $dispatcher destroy
    }
} -result {application worker pool key must not be empty}

test application-dispatcher-1.9c {
    application descriptors include worker application paths
} -body {
    set config $application_config
    set docroot [file normalize /tmp/tclwire-package-docroot]
    set libdir [file normalize /tmp/tclwire-package-libdir]
    dict set config applications default docroot $docroot
    dict set config applications default libdir $libdir
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set expected {}
        foreach directory [list \
                [file normalize [pwd]] \
                $docroot \
                $libdir \
                $project_root] {
            if {$directory ni $expected} {
                lappend expected $directory
            }
        }
        expr {[dict get [$dispatcher application default] application_paths] eq $expected}
    } finally {
        $dispatcher destroy
    }
} -result 1

test application-dispatcher-1.10 {relative application files prefer run directory} -setup {
    set root [file join [temporaryDirectory] tclwire-app-files-[pid]]
    set run_directory [file join $root run]
    set docroot [file join $root docroot]
    set libdir [file join $root lib]
    file mkdir $run_directory
    file mkdir $docroot
    file mkdir $libdir
    set run_file [file join $run_directory application.tcl]
    set docroot_file [file join $docroot application.tcl]
    set libdir_file [file join $libdir application.tcl]
    ::fileutil::writeFile $run_file {# run directory application}
    ::fileutil::writeFile $docroot_file {# docroot application}
    ::fileutil::writeFile $libdir_file {# libdir application}
} -body {
    set config $application_config
    dict set config libdir $libdir
    dict set config applications default [dict create \
        class ::example::Application \
        file application.tcl \
        hosts example.test \
        docroot $docroot \
        encoding utf-8]
    set previous_directory [pwd]
    cd $run_directory
    try {
        set dispatcher [::tclwire::ApplicationDispatcher new $config]
        try {
            dict get [$dispatcher application default] file
        } finally {
            $dispatcher destroy
        }
    } finally {
        cd $previous_directory
    }
} -cleanup {
    file delete -force $root
} -result [file normalize [file join \
    [temporaryDirectory] tclwire-app-files-[pid] run application.tcl]]

test application-dispatcher-1.10a {relative application files prefer docroot after run directory} -setup {
    set root [file join [temporaryDirectory] tclwire-docroot-app-files-[pid]]
    set run_directory [file join $root run]
    set docroot [file join $root docroot]
    set libdir [file join $root lib]
    file mkdir $run_directory
    file mkdir $docroot
    file mkdir $libdir
    set docroot_file [file join $docroot application.tcl]
    set libdir_file [file join $libdir application.tcl]
    ::fileutil::writeFile $docroot_file {# docroot application}
    ::fileutil::writeFile $libdir_file {# libdir application}
} -body {
    set config $application_config
    dict set config libdir $libdir
    dict set config applications default [dict create \
        class ::example::Application \
        file application.tcl \
        hosts example.test \
        docroot $docroot \
        encoding utf-8]
    set previous_directory [pwd]
    cd $run_directory
    try {
        set dispatcher [::tclwire::ApplicationDispatcher new $config]
        try {
            dict get [$dispatcher application default] file
        } finally {
            $dispatcher destroy
        }
    } finally {
        cd $previous_directory
    }
} -cleanup {
    file delete -force $root
} -result [file normalize [file join \
    [temporaryDirectory] tclwire-docroot-app-files-[pid] docroot application.tcl]]

test application-dispatcher-1.11 {application libdir overrides global libdir} -setup {
    set root [file join [temporaryDirectory] tclwire-app-libdir-[pid]]
    set global_libdir [file join $root global]
    set application_libdir [file join $root application]
    file mkdir $global_libdir
    file mkdir $application_libdir
    set application_file [file join $application_libdir application.tcl]
    ::fileutil::writeFile $application_file {# application libdir}
} -body {
    set config $application_config
    dict set config libdir $global_libdir
    dict set config applications default [dict create \
        class ::example::Application \
        file application.tcl \
        libdir $application_libdir \
        hosts example.test \
        docroot [file join $root docroot] \
        encoding utf-8]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        list \
            [dict get [$dispatcher application default] file] \
            [dict get [$dispatcher application default] libdir]
    } finally {
        $dispatcher destroy
    }
} -cleanup {
    file delete -force $root
} -result [list \
    [file normalize [file join \
        [temporaryDirectory] tclwire-app-libdir-[pid] application application.tcl]] \
    [file normalize [file join \
        [temporaryDirectory] tclwire-app-libdir-[pid] application]]]

test application-dispatcher-1.12 {relative files fall back to TclWire installation} -body {
    set config $application_config
    dict set config applications default [dict create \
        class ::tclwire::CApplication \
        file [file join tcl application.tcl] \
        hosts localhost \
        docroot [file join [temporaryDirectory] absent-docroot] \
        encoding utf-8]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        dict get [$dispatcher application default] file
    } finally {
        $dispatcher destroy
    }
} -result [file normalize [file join $project_root tcl application.tcl]]

test application-dispatcher-1.13 {host descriptors can reuse a default application class} -body {
    set config $application_config
    dict set config applications example.test [dict create \
        hosts example.test \
        docroot /tmp/example.test]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set descriptor [$dispatcher application example.test]
        list \
            [dict get $descriptor class] \
            [dict get $descriptor package] \
            [dict get $descriptor hosts] \
            [dict get $descriptor docroot]
    } finally {
        $dispatcher destroy
    }
} -result [list \
    ::tclwire::CApplication \
    tclwire::application \
    example.test \
    [file normalize /tmp/example.test]]

test application-1.1 {CApplication receives its effective document root} -body {
    set descriptor [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot ./application-root \
        encoding iso8859-1]
    set application [::tclwire::CApplication new $descriptor]
    try {
        list \
            [$application document_root] \
            [[$application configuration_object] docroot] \
            [$application encoding]
    } finally {
        $application destroy
    }
} -result [list \
    [file normalize ./application-root] \
    ./application-root \
    iso8859-1]

test application-1.1a {CApplication provides no-op lifecycle and signal hooks} -body {
    set descriptor [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot ./application-root \
        encoding utf-8]
    set application [::tclwire::CApplication new $descriptor]
    try {
        list [$application initialize] [$application shutdown] \
            [$application signal reload]
    } finally {
        $application destroy
    }
} -result {{} {} {}}

test application-1.2 {CApplication reads content using its configured encoding} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-[pid]]
    set expected "Caff\u00e8"
    ::fileutil::writeFile -encoding iso8859-1 \
        [file join $docroot index.html] $expected
    set descriptor [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot $docroot \
        encoding iso8859-1]
    set application [::tclwire::CApplication new $descriptor]
    set request [::tclwire::HttpRequest new [dict create \
        method GET path / transaction_id 8]]
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    try {
        ::tclwire::io begin [::thread::id] $receiver 8
        $application handle_request $request
        ::tclwire::io complete
        ::tclwire::io end
        update
        set response_event \
            [lindex [lindex $::tclwire::application_test::events 0] 1]
        set output_event \
            [lindex [lindex $::tclwire::application_test::events 1] 1]
        list \
            [dict get $response_event type] \
            [dict get $response_event flags body_mode] \
            [encoding convertfrom iso8859-1 \
                [dict get $output_event data]]
    } finally {
        catch {::tclwire::io end}
        $request destroy
        $receiver destroy
        $application destroy
        file delete -force $docroot
    }
} -result [list response binary "Caff\u00e8"]

test application-1.3 {CApplication maps URL paths beneath its document root} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-[pid]]
    file mkdir [file join $docroot assets]
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot assets hello.txt] hello
    set application [::tclwire::CApplication new [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot $docroot \
        encoding utf-8]]
    try {
        list \
            [$application local_path /assets/hello.txt] \
            [$application local_path /assets/../hello.txt] \
            [$application local_path /%2e%2e/secret.txt]
    } finally {
        $application destroy
        file delete -force $docroot
    }
} -result [list \
    [file join [temporaryDirectory] tclwire-application-[pid] assets hello.txt] \
    {} \
    {}]

test application-1.3a {CApplication defaults directory indexes to index.html} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-index-[pid]]
    file mkdir $docroot
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot index.html] default-index
    set application [::tclwire::CApplication new [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot $docroot \
        encoding utf-8]]
    try {
        list \
            [$application directory_index] \
            [$application local_path /]
    } finally {
        $application destroy
        file delete -force $docroot
    }
} -result [list \
    index.html \
    [file join [temporaryDirectory] tclwire-application-index-[pid] index.html]]

test application-1.3b {CApplication searches configured directory index names} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-index-[pid]]
    file mkdir [file join $docroot docs]
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot home.html] home
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot docs welcome.html] welcome
    set application [::tclwire::CApplication new [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot $docroot \
        encoding utf-8 \
        configure [dict create \
            ::tclwire::CApplication [dict create \
                directory_index {welcome.html home.html index.html}]]]]
    try {
        list \
            [$application directory_index] \
            [$application local_path /] \
            [$application local_path /docs/]
    } finally {
        $application destroy
        file delete -force $docroot
    }
} -result [list \
    {welcome.html home.html index.html} \
    [file join [temporaryDirectory] tclwire-application-index-[pid] home.html] \
    [file join [temporaryDirectory] tclwire-application-index-[pid] docs welcome.html]]

test application-1.3c {CApplication rejects unsafe directory index entries} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-index-[pid]]
    file mkdir $docroot
    catch {
        ::tclwire::CApplication new [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts localhost \
            docroot $docroot \
            encoding utf-8 \
            configure [dict create \
                ::tclwire::CApplication [dict create \
                    directory_index {index.html ../secret.html}]]]
    } message
    file delete -force $docroot
    set message
} -result {CApplication directory_index entries must be file names}

test application-io-1.1 {output commands send ordered transaction events} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 7
        ::tclwire::io out alpha
        ::tclwire::io flush
        ::tclwire::io complete
        ::tclwire::io end
        update

        set summary {}
        foreach item $::tclwire::application_test::events {
            lassign $item transaction_id event
            lappend summary \
                $transaction_id \
                [dict get $event type] \
                [dict get $event output_sequence]
        }
        set summary
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {7 output 1 7 flush 2 7 complete 3}

test application-io-1.2 {buffer exposes pending application output} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 15
        ::tclwire::io out alpha
        set first [::tclwire::io buffer]
        ::tclwire::io puts -nonewline beta
        set combined [::tclwire::io buffer]
        ::tclwire::io flush
        set drained [::tclwire::io buffer]
        ::tclwire::io complete
        ::tclwire::io end
        update

        set output_event \
            [lindex [lindex $::tclwire::application_test::events 0] 1]
        list \
            $first \
            $combined \
            $drained \
            [dict get $output_event type] \
            [dict get $output_event data] \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {alpha alphabeta {} output alphabeta {output flush complete}}

test application-io-1.3 {
    explicit completion closes response output while the transaction remains active
} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 19
        ::tclwire::io out alpha
        ::tclwire::io complete

        set state [dict get [::tclwire::io context] response_state]
        ::tclwire::io response 201 Created [list "X-Late: response"]
        ::tclwire::io out beta
        ::tclwire::io puts gamma
        ::tclwire::io flush
        ::tclwire::http::io header set X-Late header
        ::tclwire::http::io cookie late ignored
        ::tclwire::http::no_body
        ::tclwire::io fail "late failure"
        ::tclwire::io complete
        set buffered [::tclwire::io buffer]
        ::tclwire::io end
        update

        list \
            $state \
            $buffered \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }] \
            [dict get [lindex [lindex \
                $::tclwire::application_test::events 0] 1] data]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {completed {} {output complete} alpha}

test http-application-io-1.1 {HTTP header commands maintain and emit metadata} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 9
        ::tclwire::http::io header set Transfer-Encoding chunked
        ::tclwire::http::io header add Set-Cookie first=1
        ::tclwire::http::io header add Set-Cookie second=2
        set transfer_encoding \
            [::tclwire::http::io header get transfer-encoding]
        set cookies [::tclwire::http::io header get set-cookie]
        ::tclwire::http::io header remove Set-Cookie
        set removed [::tclwire::http::io header get Set-Cookie]
        ::tclwire::io end
        update

        set operations {}
        foreach item $::tclwire::application_test::events {
            set event [lindex $item 1]
            lappend operations \
                [dict get $event type] \
                [dict get $event flags action]
        }
        list $transfer_encoding $cookies $removed $operations
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    chunked \
    {first=1 second=2} \
    {} \
    {http_header set http_header add http_header add http_header remove}]

test http-application-io-1.2 {HTTP response headers reject line injection} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 10
        catch {
            ::tclwire::http::io header set X-Test "valid\r\nInjected: yes"
        } message
        set message
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {invalid HTTP response header value}

test http-application-io-1.3 {HTTP cookies support paths and expiration} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 11
        set first [::tclwire::http::io cookie session abc123 \
            -path /account -expires 1893456000]
        set second [::tclwire::http::io cookie preference compact]
        set cookies [::tclwire::http::io header get Set-Cookie]
        ::tclwire::io end
        update

        set emitted {}
        foreach item $::tclwire::application_test::events {
            set event [lindex $item 1]
            lappend emitted \
                [dict get $event flags action] \
                [dict get $event flags value]
        }
        list $first $second $cookies $emitted
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
    {preference=compact} \
    [list \
        {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
        {preference=compact}] \
    [list \
        add \
        {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
        add \
        {preference=compact}]]

test http-application-io-1.4 {HTTP cookie expiration accepts dates} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 12
        ::tclwire::http::io cookie session abc123 \
            -expires {2030-01-01 00:00:00 UTC}
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {session=abc123; Expires=Tue, 01 Jan 2030 00:00:00 GMT}

test http-application-io-1.5 {HTTP cookies reject invalid attributes} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 13
        set messages {}
        foreach command {
            {::tclwire::http::io cookie {bad name} value}
            {::tclwire::http::io cookie name {bad;value}}
            {::tclwire::http::io cookie name value -path relative}
            {::tclwire::http::io cookie name value -expires never-ever}
        } {
            catch $command message
            lappend messages $message
        }
        set messages
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    {invalid HTTP cookie name} \
    {invalid HTTP cookie value} \
    {invalid HTTP cookie path} \
    {invalid HTTP cookie expiration}]

test http-range-1.1 {byte ranges support closed open and suffix forms} -body {
    set results {}
    foreach value {bytes=2-5 bytes=7- bytes=-4 bytes=0-99} {
        set result [::tclwire::http::range classify $value 10]
        lappend results \
            [dict get $result status] \
            [dict get $result ranges]
    }
    set results
} -result [list \
    satisfiable {{2 5}} \
    satisfiable {{7 9}} \
    satisfiable {{6 9}} \
    satisfiable {{0 9}}]

test http-range-1.2 {mixed range sets retain satisfiable members} -body {
    set result [::tclwire::http::range classify bytes=20-30,2-4 10]
    list [dict get $result status] [dict get $result ranges]
} -result {satisfiable {{2 4}}}

test http-range-1.3 {range outcomes are classified without control-flow errors} -body {
    list \
        [dict get [::tclwire::http::range classify items=0-1 10] status] \
        [dict get [::tclwire::http::range classify bytes=bad 10] status] \
        [dict get [::tclwire::http::range classify bytes=20-30 10] status]
} -result {unsupported malformed unsatisfiable}

test http-redirect-1.1 {redirect responses default to 302 Found} -body {
    ::tclwire::http::redirect response /next
} -result [dict create \
    status 302 \
    reason Found \
    body {} \
    headers [list "Location: /next"] \
    body_mode text]

test http-redirect-1.2 {redirect status determines the reason phrase} -body {
    set results {}
    foreach status {301 302 303 307 308} {
        set response [::tclwire::http::redirect response /next \
            -status $status -body {}]
        lappend results \
            [dict get $response status] \
            [dict get $response reason]
    }
    set results
} -result [list \
    301 "Moved Permanently" \
    302 "Found" \
    303 "See Other" \
    307 "Temporary Redirect" \
    308 "Permanent Redirect"]

test http-redirect-1.3 {redirect responses accept body and extra headers} -body {
    ::tclwire::http::redirect response \
        https://example.test/new-location \
        -status 308 \
        -body "moved\n" \
        -headers [list "Cache-Control: max-age=3600" "X-Test: yes"]
} -result [dict create \
    status 308 \
    reason "Permanent Redirect" \
    body "moved\n" \
    headers [list \
        "Location: https://example.test/new-location" \
        "Cache-Control: max-age=3600" \
        "X-Test: yes"] \
    body_mode text]

test http-redirect-1.4 {redirect responses reject unsafe or conflicting input} -body {
    list \
        [catch {
            ::tclwire::http::redirect response {}
        } empty_location] $empty_location \
        [catch {
            ::tclwire::http::redirect response "/next\r\nX-Test: yes"
        } injected_location] $injected_location \
        [catch {
            ::tclwire::http::redirect response /next -status 305
        } unsupported_status] $unsupported_status \
        [catch {
            ::tclwire::http::redirect response /next \
                -headers [list "Location: /other"]
        } duplicate_location] $duplicate_location
} -result [list \
    1 {HTTP redirect location must not be empty} \
    1 {invalid HTTP redirect location} \
    1 {unsupported HTTP redirect status: 305} \
    1 {HTTP redirect response headers must not contain Location}]

test http-redirect-1.5 {redirect responses can be sent through application I/O} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 17
        set redirect_response [::tclwire::http::redirect send /target \
            -status 303 \
            -body "redirect=/target\n" \
            -headers [list "Content-Type: text/plain; charset=utf-8"]]
        ::tclwire::io complete
        ::tclwire::io end
        update

        set response_event \
            [lindex [lindex $::tclwire::application_test::events 0] 1]
        set output_event \
            [lindex [lindex $::tclwire::application_test::events 1] 1]
        list \
            [dict get $redirect_response status] \
            [dict get $response_event flags reason] \
            [dict get $response_event flags headers] \
            [dict get $output_event data] \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list 303 "See Other" \
                [list   "Location: /target" "Content-Type: text/plain; charset=utf-8"] \
                        "redirect=/target\n" \
                        {response output complete}]

test http-redirect-1.6 {redirect responses preserve an explicit content type} -body {
    set response [::tclwire::http::redirect response /target \
        -body {} \
        -headers [list "Content-Type: text/html; charset=utf-8"]]
    dict get $response headers
} -result [list \
    "Location: /target" \
    "Content-Type: text/html; charset=utf-8"]

test application-io-1.8 {HTTP no_body discards pending application output} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 18
        ::tclwire::io out "discarded body"
        ::tclwire::http::no_body
        set buffered [::tclwire::io buffer]
        ::tclwire::io complete
        ::tclwire::io end
        update

        list \
            $buffered \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list {} {no_body complete}]

test application-io-1.9 {application output can request connection close} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 20
        ::tclwire::io out "discarded body"
        ::tclwire::io close_connection
        set state [dict get [::tclwire::io context] response_state]
        set buffered [::tclwire::io buffer]
        ::tclwire::io out "ignored"
        ::tclwire::io complete
        ::tclwire::io end
        update

        list \
            $state \
            $buffered \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list completed {} close_connection]

test application-1.4 {HEAD obtains file metadata without reading the file} -setup {
    oo::class create ::tclwire::application_test::MetadataApplication {
        superclass ::tclwire::CApplication
        method read_file {path} {
            error "HEAD attempted a complete file read"
        }
        method read_file_range {path start end} {
            error "HEAD attempted a range read"
        }
    }
    set docroot [file join [temporaryDirectory] tclwire-head-[pid]]
    file mkdir $docroot
    ::fileutil::writeFile -translation binary \
        [file join $docroot data.bin] 0123456789
    set application [::tclwire::application_test::MetadataApplication new \
        [dict create docroot $docroot encoding utf-8]]
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method HEAD \
        path /data.bin \
        headers [dict create range bytes=2-5] \
        transaction_id 14]]
    ::tclwire::io begin [::thread::id] $receiver 14
    $application handle_request $request
    ::tclwire::io end
    update
    set event [lindex [lindex $::tclwire::application_test::events 0] 1]
    list \
        [dict get $event type] \
        [dict get $event flags status] \
        [dict get $event flags headers] \
        [llength $::tclwire::application_test::events]
} -cleanup {
    catch {::tclwire::io end}
    catch {$request destroy}
    $receiver destroy
    $application destroy
    ::tclwire::application_test::MetadataApplication destroy
    file delete -force $docroot
} -result [list \
    response \
    200 \
    [list \
        "Accept-Ranges: bytes" \
        "Content-Type: application/octet-stream" \
        "Content-Length: 10"] \
    1]

test application-1.5 {derived applications can serve abstract content ranges} -setup {
    oo::class create ::tclwire::application_test::RangeApplication {
        superclass ::tclwire::CApplication

        method serve_content_ranges {resource ranges} {
            ::tclwire::io response 206 "Partial Content" \
                [list "Content-Type: application/x-generated-ranges"]
            ::tclwire::io out [list content-ranges $ranges]
        }
    }
    set docroot [file join [temporaryDirectory] tclwire-range-hook-[pid]]
    file mkdir $docroot
    ::fileutil::writeFile -translation binary \
        [file join $docroot data.bin] 0123456789
    set application [::tclwire::application_test::RangeApplication new \
        [dict create docroot $docroot encoding utf-8]]
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method GET \
        path /data.bin \
        headers [dict create range bytes=0-1,8-9] \
        transaction_id 16]]
    ::tclwire::io begin [::thread::id] $receiver 16
    $application handle_request $request
    ::tclwire::io complete
    ::tclwire::io end
    update

    set response_event \
        [lindex [lindex $::tclwire::application_test::events 0] 1]
    set output_event \
        [lindex [lindex $::tclwire::application_test::events 1] 1]
    list \
        [dict get $response_event flags headers] \
        [dict get $output_event data]
} -cleanup {
    catch {::tclwire::io end}
    catch {$request destroy}
    $receiver destroy
    $application destroy
    ::tclwire::application_test::RangeApplication destroy
    file delete -force $docroot
} -result [list \
    [list "Content-Type: application/x-generated-ranges"] \
    [list content-ranges {{0 1} {8 9}}]]

test http-errors-1.1 {HTTP errors are loaded from the root JSON catalog} -body {
    set response [::tclwire::http::errors response 503]
    list \
        [dict get $response status] \
        [dict get $response reason] \
        [dict get $response headers] \
        [dict get $response encoding] \
        [string match \
            {*The service is temporarily unavailable. Try again later.*} \
            [dict get $response body]]
} -result [list \
    503 \
    "Service Unavailable" \
    [list "Content-Type: text/html; charset=utf-8"] \
    utf-8 \
    1]

test http-errors-1.2 {error template values are HTML escaped} -body {
    set response [::tclwire::http::errors response 404 \
        [dict create path {/<missing>&}]]
    list \
        [dict get $response reason] \
        [string match {*<code>/&lt;missing&gt;&amp;</code>*} \
            [dict get $response body]]
} -result {{Not Found} 1}

test http-errors-1.3 {unknown statuses use the catalog fallback template} -body {
    set response [::tclwire::http::errors response 599]
    list \
        [dict get $response status] \
        [dict get $response reason] \
        [string match {*<h1>599 Error</h1>*} [dict get $response body]]
} -result {599 {Internal Server Error} 1}

cleanupTests
