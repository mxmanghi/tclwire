package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require Thread
package require tclwire::application::io 0.1
package require tclwire::http::application::io 0.1
package require tclwire::application::tools 0.1
package require tclwire::http::range 0.1
package require tclwire::http::redirect 0.1
package require tclwire::http::request 0.1
package require tclwire::transaction_descriptor 0.1
package require tclwire::application 0.1
package require tclwire::application_dispatcher 0.1
package require tclwire::content_generator_agent 0.1
package require tclwire::connection_agent 0.1
package require tclwire::http::errors 0.1

namespace eval ::tclwire::application_test {
    variable events {}
}

test transaction-descriptor-1.1 {
    request fields are immutable while transaction state remains mutable
} -body {
    set transaction [::tclwire::TransactionDescriptor new \
        [dict create method GET path /resource] 7]
    try {
        set immutable_result [catch {
            $transaction set method POST
        } immutable_error]
        $transaction set response_status 201
        $transaction append response_body alpha
        $transaction append response_body beta
        list $immutable_result \
             $immutable_error \
             [$transaction get method] \
             [$transaction get response_status] \
             [$transaction get response_body]
    } finally {
        $transaction destroy
    }
} -result [list \
    1 {transaction field is immutable: method} GET 201 alphabeta]

test connection-agent-1.1 {finished transactions are ignored by id} -body {
    oo::class create ::tclwire::application_test::ConnectionAgentProbe {
        superclass ::tclwire::ConnectionAgent

        method begin {transaction_id descriptor} {
            my begin_transaction $transaction_id $descriptor
        }

        method transaction {transaction_id} {
            my transaction_for $transaction_id
        }

        method finish {transaction_id} {
            my finish_transaction $transaction_id
        }
    }

    lassign [chan pipe] read_channel write_channel
    set agent [::tclwire::application_test::ConnectionAgentProbe new \
        $read_channel 1 127.0.0.1 9000 application-test-connection]
    try {
        $agent begin 1 [dict create method GET path /]
        set before [expr {[$agent transaction 1] ne {}}]
        set descriptor [$agent finish 1]
        list $before \
             [dict get $descriptor transaction_id] \
             [$agent transaction 1]
    } finally {
        catch {$agent destroy}
        catch {close $write_channel}
        catch {::tclwire::application_test::ConnectionAgentProbe destroy}
    }
} -result {1 1 {}}

test http-request-1.1 {HTTP request exposes a read-only semantic interface} -body {
    set request [::tclwire::HttpRequest new [dict create    method GET \
                                                            target /search?q=Tcl \
                                                            path /search \
                                                            query q=Tcl \
                                                            query_dict [dict create q Tcl] \
                                                            version 1.1 \
                                                            headers [dict create host localhost x-test yes] \
                                                            trailers [dict create x-checksum accepted] \
                                                            body_media raw \
                                                            body_storage in_memory \
                                                            body payload \
                                                            body_size 7 \
                                                            transaction_id 3]]
    try {
        list [$request method] \
             [$request path] \
             [$request query_dict] \
             [$request query_parameter q] \
             [$request header X-Test] \
             [$request trailer X-Checksum] \
             [$request body] \
             [expr {"set" ni [info object methods $request -all]}]
    } finally {
        $request destroy
    }
} -result {GET /search {q Tcl} Tcl yes accepted payload 1}

test http-request-1.1a {HTTP request exposes origin and absolute URL helpers} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method GET \
        target /upload/form?mode=edit \
        path /upload/form \
        query mode=edit \
        version 1.1 \
        protocol https \
        headers [dict create host example.test:9443] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 3]]
    try {
        list \
            [$request scheme] \
            [$request authority] \
            [$request origin] \
            [$request absolute_url] \
            [$request absolute_url /submit] \
            [$request absolute_url next]
    } finally {
        $request destroy
    }
} -result {https example.test:9443 https://example.test:9443 https://example.test:9443/upload/form?mode=edit https://example.test:9443/submit https://example.test:9443/upload/next}

test http-request-1.1aa {HTTP request records URL path and resolved local path} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method GET \
        target /?page=1 \
        path / \
        query page=1 \
        version 1.1]]
    try {
        set before [$request local_path]
        set resolved [$request local_path /tmp/tclwire/index.rvt]
        set selected [$request path /index.rvt]
        set after [$request local_path]
        set snapshot [$request snapshot]
        $request local_path {}
        list \
            [$request url_path] \
            [$request path] \
            $before \
            $resolved \
            $selected \
            $after \
            [dict get $snapshot path] \
            [dict get $snapshot url_path] \
            [dict get $snapshot local_path] \
            [$request local_path]
    } finally {
        $request destroy
    }
} -result [list / /index.rvt {} /tmp/tclwire/index.rvt /index.rvt \
    /tmp/tclwire/index.rvt /index.rvt / /tmp/tclwire/index.rvt {}]

test http-request-1.1b {HTTP request exposes an associated cookie jar} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method GET \
        target /profile \
        path /profile \
        query {} \
        version 1.1 \
        headers [dict create host example.test cookie {session=abc; theme=light}] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 3]]
    try {
        set jar [$request cookie_jar]
        list \
            [info object isa typeof $jar ::tclwire::CookieJar] \
            [expr {$jar eq [$request cookie_jar]}] \
            [$jar get session] \
            [$jar get missing default] \
            [$jar serialize]
    } finally {
        $request destroy
    }
} -result [list 1 1 abc default [list [list session abc] [list theme light]]]

test http-request-1.1c {cookie jar set validates and serializes io cookie arguments} -body {
    set jar [::tclwire::CookieJar new]
    try {
        $jar set session abc -path / -expires 0
        $jar set theme light
        list \
            [$jar get session] \
            [$jar validate safe-value] \
            [$jar serialize]
    } finally {
        $jar destroy
    }
} -result [list abc safe-value [list \
    [list session abc -path / -expires 0] \
    [list theme light]]]

test http-request-1.1d {cookie jar rejects invalid cookie values} -body {
    set jar [::tclwire::CookieJar new]
    try {
        catch {$jar set session "bad;value"} message
        set message
    } finally {
        $jar destroy
    }
} -result {invalid HTTP cookie value}

test application-tools-1.1 {request-scoped URL helpers expose the current origin} -body {
    ::tclwire::tools::begin [dict create \
        method POST \
        target /tools/page \
        path /tools/page \
        protocol http \
        headers [dict create host localhost:8990]]
    try {
        list \
            [::tclwire::tools::origin_url] \
            [::tclwire::tools::script_url] \
            [::tclwire::tools::directory_url] \
            [::tclwire::tools::makeurl /upload] \
            [::tclwire::tools::makeurl result]
    } finally {
        ::tclwire::tools::end
    }
} -result {http://localhost:8990 http://localhost:8990/tools/page http://localhost:8990/tools/ http://localhost:8990/upload http://localhost:8990/tools/result}

test http-request-1.2 {HTTP request exposes Content-Type parameters} -body {
    set request [::tclwire::HttpRequest new \
        [dict create    method      POST \
                        target      /upload \
                        path        /upload \
                        query       {}    \
                        version     1.1 \
                        headers [dict create \
                            content-type {Multipart/Form-Data; boundary="AaB03x"; charset=utf-8}] \
                        body_media  raw \
                        body_storage in_memory \
                        body        {} \
                        body_size   0 \
                        transaction_id 3]]
    try {
        list [$request content_type] \
             [$request media_type] \
             [$request content_type_parameter boundary] \
             [$request content_type_parameter charset] \
             [$request is_multipart]
    } finally {
        $request destroy
    }
} -result [list \
    {Multipart/Form-Data; boundary="AaB03x"; charset=utf-8} \
    multipart/form-data \
    AaB03x \
    utf-8 \
    1]

test http-request-1.3 {HTTP request exposes multipart form fields and files} -body {
    set boundary AaB03x
    set body [binary format a* {}]
    append body "--$boundary\r\n"
    append body "Content-Disposition: form-data; name=\"field\"\r\n\r\n"
    append body "value1\r\n"
    append body "--$boundary\r\n"
    append body "Content-Disposition: form-data; name=\"field\"\r\n\r\n"
    append body "value2\r\n"
    append body "--$boundary\r\n"
    append body "Content-Disposition: form-data; name=\"upload\"; filename=\"hello.txt\"\r\n"
    append body "Content-Type: text/plain\r\n\r\n"
    append body "hello file\r\n"
    append body "--$boundary--\r\n"

    set request [::tclwire::HttpRequest new [dict create \
        method POST \
        target /upload \
        path /upload \
        query {} \
        version 1.1 \
        headers [dict create \
            content-type "multipart/form-data; boundary=$boundary"] \
        body_media raw \
        body_storage in_memory \
        body $body \
        body_size [string length $body] \
        transaction_id 3]]
    try {
        set file [$request uploaded_file upload]
        list \
            [llength [$request multipart_parts]] \
            [$request form_values field] \
            [$request form_value field] \
            [dict get [$request form_fields] field] \
            [dict get $file name] \
            [dict get $file filename] \
            [dict get $file content_type] \
            [dict get $file body]
    } finally {
        $request destroy
    }
} -result {3 {value1 value2} value2 value2 upload hello.txt text/plain {hello file}}

test http-request-1.4 {multipart requests require a boundary parameter} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method POST \
        target /upload \
        path /upload \
        query {} \
        version 1.1 \
        headers [dict create content-type multipart/form-data] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 3]]
    try {
        catch {$request multipart_parts} message
        set message
    } finally {
        $request destroy
    }
} -result {multipart Content-Type is missing boundary}

test http-request-1.4a {
    form and upload helpers are empty for non-multipart requests
} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method POST \
        target /submit \
        path /submit \
        query {} \
        version 1.1 \
        headers [dict create] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 3]]
    try {
        list \
            [$request is_multipart] \
            [$request form_fields] \
            [$request form_values field] \
            [$request form_value field default] \
            [$request uploaded_files] \
            [$request uploaded_file upload]
    } finally {
        $request destroy
    }
} -result {0 {} {} default {} {}}

test http-request-1.5 {multipart storage preserves multiple uploaded files} -setup {
    set upload_area [file join [temporaryDirectory] tclwire-uploads-[pid]]
    file delete -force $upload_area
} -body {
    set parts [list \
        [dict create name title body report] \
        [dict create name attachments filename one.bin body "one\0data"] \
        [dict create name attachments filename two.bin body "two\0data"]]
    set stored [::tclwire::http::multipart store_files $parts $upload_area]
    set files [::tclwire::http::multipart files $stored attachments]
    set contents {}
    foreach part $files {
        set channel [open [dict get $part path] rb]
        try {
            lappend contents [read $channel]
        } finally {
            close $channel
        }
    }
    list \
        [llength $files] \
        [dict get [lindex $stored 0] body] \
        [lmap part $files {dict get $part body_storage}] \
        [lmap part $files {dict get $part body_size}] \
        [expr {[lmap part $files {dict get $part path}] eq \
            [lmap part $files {dict get $part body_path}]}] \
        [expr {[dict get [lindex $files 0] path] ne \
               [dict get [lindex $files 1] path]}] \
        [lmap part $files {
            string match tclwire-upload_* \
                [file tail [dict get $part path]]
        }] \
        $contents
} -cleanup {
    file delete -force $upload_area
} -result [list 2 report {spooled_file spooled_file} {8 8} 1 1 {1 1} \
    [list "one\0data" "two\0data"]]

test http-request-1.6 {multipart storage rejects an empty upload area} -body {
    catch {
        ::tclwire::http::multipart store_files \
            [list [dict create filename upload.bin body data]] {}
    } message
    set message
} -result {multipart upload area must not be empty}

test application-tools-1.1 {makeurl builds URLs from the current request} -body {
    try {
        ::tclwire::tools::begin [dict create \
            protocol https \
            path /scripts/report.tcl \
            headers [dict create host example.test:9443]]
        list \
            [::tclwire::tools::makeurl] \
            [::tclwire::tools::makeurl chart.png] \
            [::tclwire::tools::makeurl /assets/site.css] \
            [::tclwire::tools::makeurl index.html]
    } finally {
        ::tclwire::tools::end
    }
} -result [list \
    https://example.test:9443/scripts/report.tcl \
    https://example.test:9443/scripts/chart.png \
    https://example.test:9443/assets/site.css \
    https://example.test:9443/scripts/index.html]

test application-tools-1.2 {makeurl preserves directory script URLs} -body {
    try {
        ::tclwire::tools::begin [dict create \
            protocol http \
            path /docs/ \
            headers [dict create host example.test]]
        list \
            [::tclwire::tools::makeurl] \
            [::tclwire::tools::makeurl intro.html]
    } finally {
        ::tclwire::tools::end
    }
} -result [list \
    http://example.test/docs/ \
    http://example.test/docs/intro.html]

test application-tools-1.3 {makeurl requires a current request context} -body {
    catch {::tclwire::tools::makeurl} message
    set message
} -result {no current application request is active}

test application-tools-1.4 {load_env copies environment into the default array} -body {
    set original_exists [info exists ::env(TCLWIRE_LOAD_ENV_TEST)]
    if {$original_exists} {
        set original_value $::env(TCLWIRE_LOAD_ENV_TEST)
    }
    set ::env(TCLWIRE_LOAD_ENV_TEST) default-value
    try {
        apply {{} {
            ::tclwire::tools::load_env
            return $env(TCLWIRE_LOAD_ENV_TEST)
        }}
    } finally {
        if {$original_exists} {
            set ::env(TCLWIRE_LOAD_ENV_TEST) $original_value
        } else {
            unset -nocomplain ::env(TCLWIRE_LOAD_ENV_TEST)
        }
    }
} -result default-value

test application-tools-1.5 {load_env copies environment into a named array} -body {
    set original_exists [info exists ::env(TCLWIRE_LOAD_ENV_TEST)]
    if {$original_exists} {
        set original_value $::env(TCLWIRE_LOAD_ENV_TEST)
    }
    set ::env(TCLWIRE_LOAD_ENV_TEST) named-value
    try {
        unset -nocomplain copied
        ::tclwire::tools::load_env copied
        set copied(TCLWIRE_LOAD_ENV_TEST)
    } finally {
        unset -nocomplain copied
        if {$original_exists} {
            set ::env(TCLWIRE_LOAD_ENV_TEST) $original_value
        } else {
            unset -nocomplain ::env(TCLWIRE_LOAD_ENV_TEST)
        }
    }
} -result named-value

test application-tools-1.6 {load_env replaces stale target array entries} -body {
    array set copied [list STALE value]
    try {
        ::tclwire::tools::load_env copied
        info exists copied(STALE)
    } finally {
        unset -nocomplain copied
    }
} -result 0

oo::class create ::tclwire::application_test::OutputReceiver {
    method application_output {transaction_id event} {
        lappend ::tclwire::application_test::events \
            [list $transaction_id $event]
    }
}

set application_config [dict create \
    docroot [file normalize /tmp/tclwire-default-docroot] \
    encoding utf-8 \
    default_application default \
    applications [dict create \
        default [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts {localhost 127.0.0.1}]]]

test application-configuration-1.1 {
    construction defines optional properties and snapshots are value copies
} -body {
    set configuration [::tclwire::ApplicationConfiguration new example \
        [dict create \
            class ::example::Application \
            package example::application \
            hosts example.test \
            docroot /tmp \
            encoding utf-8 \
            application_paths [list /tmp] \
            configure [dict create \
                ::example::Application [dict create message configured]]]]
    try {
        set snapshot [$configuration snapshot]
        dict set snapshot retain_uploaded_files 1
        list \
            [$configuration id] \
            [$configuration file] \
            [$configuration reload_on_request] \
            [$configuration retain_uploaded_files] \
            [dict get [$configuration pool_policy] maximum_workers] \
            [dict get [$configuration class_configuration ::example::Application] message]
    } finally {
        $configuration destroy
    }
} -result {example {} 0 0 20 configured}

test application-configuration-1.1e {
    construction preserves application environment list
} -body {
    set configuration [::tclwire::ApplicationConfiguration new example \
        [dict create \
            class ::example::Application \
            package example::application \
            hosts example.test \
            docroot /tmp \
            encoding utf-8 \
            application_paths [list /tmp] \
            environment {stdchans}]]
    try {
        list \
            [$configuration environment] \
            [dict get [$configuration snapshot] environment]
    } finally {
        $configuration destroy
    }
} -result {stdchans stdchans}

test application-configuration-1.1a {
    construction qualifies bare application class and configure names
} -body {
    set configuration [::tclwire::ApplicationConfiguration new example \
        [dict create \
            class Hello \
            package example::application \
            hosts example.test \
            docroot /tmp \
            encoding utf-8 \
            application_paths [list /tmp] \
            configure [dict create \
                Hello [dict create message configured]]]]
    try {
        list \
            [$configuration class] \
            [dict get \
                [$configuration class_configuration ::tclwire::app::Hello] \
                message]
    } finally {
        $configuration destroy
    }
} -result {::tclwire::app::Hello configured}

test application-configuration-1.1b {
    construction binds generic configure values to the application class
} -body {
    set configuration [::tclwire::ApplicationConfiguration new example \
        [dict create \
            class ::example::Application \
            package example::application \
            hosts example.test \
            docroot /tmp \
            encoding utf-8 \
            application_paths [list /tmp] \
            configure [dict create \
                message generic \
                aliases {one two} \
                ::example::Application [dict create \
                    message explicit \
                    style plain]]]]
    try {
        set options \
            [$configuration class_configuration ::example::Application]
        list \
            [dict get $options message] \
            [dict get $options aliases] \
            [dict get $options style] \
            [dict keys [$configuration configure]]
    } finally {
        $configuration destroy
    }
} -result [list explicit {one two} plain ::example::Application]

test application-configuration-1.2 {
    dispatcher exposes validated immutable application configurations
} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set configuration [$dispatcher application_configuration default]
        list \
            [info object isa typeof $configuration \
                ::tclwire::ApplicationConfiguration] \
            [$configuration class] \
            [$configuration encoding]
    } finally {
        $dispatcher destroy
    }
} -result {1 ::tclwire::CApplication utf-8}

test application-configuration-1.2b {
    dispatcher merges class-scoped configuration for virtual hosts
} -body {
    set config [dict create \
        docroot /tmp \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                hosts localhost \
                configure [dict create \
                    ::tclwire::CApplication [dict create directory_index index.html] \
                    ::example::Hello [dict create message default style plain]]] \
            hello [dict create \
                class ::example::Hello \
                package example::hello \
                hosts hello.example.test \
                configure [dict create \
                    ::example::Hello [dict create message host]]]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set configuration [$dispatcher application_configuration hello]
        list \
            [dict get [$configuration class_configuration ::tclwire::CApplication] directory_index] \
            [dict get [$configuration class_configuration ::example::Hello] message] \
            [dict get [$configuration class_configuration ::example::Hello] style]
    } finally {
        $dispatcher destroy
    }
} -result {index.html host plain}

test application-configuration-1.2c {
    dispatcher qualifies bare application classes and configure keys
} -body {
    set config [dict create \
        docroot /tmp \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class DefaultApplication \
                package example::default \
                hosts localhost \
                configure [dict create \
                    DefaultApplication [dict create directory_index index.html] \
                    Hello [dict create message default style plain]]] \
            hello [dict create \
                class Hello \
                package example::hello \
                hosts hello.example.test \
                configure [dict create \
                    Hello [dict create message host]]]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set configuration [$dispatcher application_configuration hello]
        list \
            [$configuration class] \
            [dict get [$configuration class_configuration ::tclwire::app::DefaultApplication] directory_index] \
            [dict get [$configuration class_configuration ::tclwire::app::Hello] message] \
            [dict get [$configuration class_configuration ::tclwire::app::Hello] style]
    } finally {
        $dispatcher destroy
    }
} -result {::tclwire::app::Hello index.html host plain}

test application-configuration-1.3 {
    serialized configurations reconstruct validated immutable objects
} -body {
    set original [::tclwire::ApplicationConfiguration new example \
        [dict create \
            class ::example::Application \
            package example::application \
            hosts example.test \
            docroot /tmp \
            encoding utf-8 \
            application_paths [list /tmp] \
            retain_uploaded_files 1]]
    try {
        set restored [::tclwire::ApplicationConfiguration deserialize \
            [$original serialize]]
        try {
            list \
                [$restored id] \
                [$restored class] \
                [$restored retain_uploaded_files] \
                [expr {[$restored snapshot] eq [$original snapshot]}]
        } finally {
            $restored destroy
        }
    } finally {
        $original destroy
    }
} -result {example ::example::Application 1 1}

test application-configuration-1.4 {
    deserialization rejects unsupported wire versions
} -body {
    catch {
        ::tclwire::ApplicationConfiguration deserialize [dict create \
            type tclwire.application_configuration \
            version 2 \
            application_id example \
            values {}]
    } message
    set message
} -result {unsupported application configuration version: 2}

test application-configuration-1.4a {
    CGA initialization loads environments into the application namespace path
} -body {
    set original_path [namespace eval ::tclwire::app {namespace path}]
    set configuration [::tclwire::ApplicationConfiguration new env-test \
        [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]] \
            environment {stdchans}]]
    try {
        ::tclwire::cga::initialize app:env-test [$configuration serialize]
        set installed [::tclwire::envs::stdchans enabled]
        set cga_environments [::tclwire::cga::envs::list]
        set has_environment [::tclwire::cga::envs::present stdchans]
        set has_qualified_environment [::tclwire::cga::envs::present \
            ::tclwire::envs::stdchans]
        set compatibility_list [::tclwire::cga::environments]
        set compatibility_present [::tclwire::cga::has_environment stdchans]
        set resolved [namespace eval ::tclwire::app {
            namespace which -command puts
        }]
        set global_puts [namespace which -command ::puts]
        ::tclwire::cga::shutdown
        list \
            $installed \
            $cga_environments \
            $has_environment \
            $has_qualified_environment \
            $compatibility_list \
            $compatibility_present \
            [::tclwire::cga::envs::present stdchans] \
            $resolved \
            $global_puts \
            [expr {[namespace eval ::tclwire::app {namespace path}] eq \
                $original_path}]
    } finally {
        catch {::tclwire::cga::shutdown}
        catch {::tclwire::envs::stdchans uninstall}
        namespace eval ::tclwire::app [list namespace path $original_path]
        $configuration destroy
    }
} -result [list 1 stdchans 1 1 stdchans 1 0 \
    ::tclwire::envs::stdchans::puts ::puts 1]

test application-configuration-1.4b {
    CGA applies environment namespace path to request-time application objects
} -setup {
    oo::class create ::tclwire::application_test::StdchansApplication {
        superclass ::tclwire::CApplication

        method handle_request {request} {
            puts stdout alpha
            puts -nonewline stdout beta
            flush stdout
        }
    }
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set configuration [::tclwire::ApplicationConfiguration new env-request-test \
        [dict create \
            class ::tclwire::application_test::StdchansApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]] \
            environment {stdchans}]]
} -body {
    ::tclwire::cga::initialize app:env-request-test [$configuration serialize]
    ::tclwire::cga::execute \
        [dict create \
            application_id env-request-test \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 92 \
            method GET \
            path /]
    update
    set output_event [lindex [lindex $::tclwire::application_test::events 0] 1]
    list \
        [dict get $output_event type] \
        [dict get $output_event data] \
        [lmap item $::tclwire::application_test::events {
            dict get [lindex $item 1] type
        }]
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$configuration destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::application_test::StdchansApplication destroy}
    catch {::tclwire::io end}
} -result [list output "alpha\nbeta" {output flush complete}]

test application-configuration-1.4ba {
    CGA splits stable application context from request context
} -setup {
    oo::class create ::tclwire::application_test::ContextApplication {
        superclass ::tclwire::CApplication

        method handle_request {request} {
            set application_context [::tclwire::app::application_snapshot]
            set request_context [::tclwire::app::request_snapshot]
            puts [list \
                [::tclwire::app::application_active] \
                [::tclwire::app::request_active] \
                [expr {[::tclwire::app::current] eq [self]}] \
                [expr {[::tclwire::app::request] eq $request}] \
                [dict get [::tclwire::app::request_descriptor] path] \
                [[::tclwire::app::configuration] id] \
                [dict get $application_context pool_key] \
                [expr {[dict get $request_context request] eq $request}]]
        }
    }
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set configuration [::tclwire::ApplicationConfiguration new context-test \
        [dict create \
            class ::tclwire::application_test::ContextApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]] \
            environment {stdchans}]]
} -body {
    ::tclwire::cga::initialize app:context-test [$configuration serialize]
    set application_after_initialize [expr {[::tclwire::app::current] ne {}}]
    set application_active_after_initialize \
        [::tclwire::app::application_active]
    ::tclwire::cga::execute \
        [dict create \
            application_id context-test \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 921 \
            method GET \
            path /context]
    update
    set output_event [lindex [lindex $::tclwire::application_test::events 0] 1]
    set request_after_error {}
    set request_after [catch {::tclwire::app::request} request_after_error]
    list \
        $application_active_after_initialize \
        $application_after_initialize \
        [dict get $output_event data] \
        [::tclwire::app::application_active] \
        [::tclwire::app::request_active] \
        $request_after \
        $request_after_error \
        [expr {[::tclwire::app::current] ne {}}]
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$configuration destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::application_test::ContextApplication destroy}
    catch {::tclwire::io end}
} -result [list \
    1 1 \
    "1 1 1 1 /context context-test app:context-test 1\n" \
    1 0 1 {no TclWire request context is active} 1]

test application-configuration-1.4bb {
    CGA loads full environment package when helper namespace already exists
} -body {
    source [file join $project_root environments rivet_app.tcl]
    set command ::tclwire::envs::rivet
    set had_partial_namespace [expr {
        [namespace exists $command] &&
        [info commands ${command}::install] eq {}
    }]
    set configuration [::tclwire::ApplicationConfiguration new rivet-partial-env-test \
        [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]] \
            environment {rivet}]]
    try {
        set initialize_result [catch {
            ::tclwire::cga::initialize app:rivet-partial-env-test \
                [$configuration serialize]
        } initialize_message]
        list \
            $had_partial_namespace \
            $initialize_result \
            $initialize_message \
            [::tclwire::cga::envs::present rivet] \
            [expr {[info commands ${command}::install] ne {}}]
    } finally {
        catch {::tclwire::cga::shutdown}
        catch {::tclwire::envs::rivet uninstall}
        catch {::tclwire::envs::stdchans uninstall}
        $configuration destroy
    }
} -result {1 0 {} 1 1}

test application-configuration-1.4c {
    CGA installs rivet environment dependencies
} -body {
    set configuration [::tclwire::ApplicationConfiguration new rivet-env-test \
        [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]] \
            environment {rivet}]]
    try {
        ::tclwire::cga::initialize app:rivet-env-test [$configuration serialize]
        set path [namespace eval ::tclwire::app {namespace path}]
        set result [list \
            [::tclwire::cga::envs::list] \
            [::tclwire::cga::envs::present stdchans] \
            [::tclwire::cga::envs::present rivet] \
            [namespace exists ::Rivet] \
            [namespace exists ::rivet] \
            [expr {"::tclwire::envs::stdchans" in $path}] \
            [expr {"::rivet" in $path}]]
        ::tclwire::cga::shutdown
        lappend result \
            [::tclwire::cga::envs::present rivet] \
            [namespace exists ::Rivet] \
            [namespace exists ::rivet]
        set result
    } finally {
        catch {::tclwire::cga::shutdown}
        catch {::tclwire::envs::rivet uninstall}
        catch {::tclwire::envs::stdchans uninstall}
        $configuration destroy
    }
} -result {{stdchans rivet} 1 1 1 1 1 1 0 0 0}

test application-configuration-1.4d {
    dispatcher uses environment-provided application class when class is omitted
} -body {
    set config [dict create \
        docroot [temporaryDirectory] \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                hosts localhost] \
            rivet-app [dict create \
                package tclwire::application \
                hosts rivet.example.test \
                environment {rivet}]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set configuration [$dispatcher application_configuration rivet-app]
        list \
            [$configuration class] \
            [$configuration environment]
    } finally {
        $dispatcher destroy
    }
} -result [list ::tclwire::envs::app::Rivet rivet]

test application-configuration-1.4da {
    environment-provided application class uses environment reload file
} -body {
    set config [dict create \
        docroot [temporaryDirectory] \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                file tcl/application.tcl \
                reload_on_request 1 \
                hosts localhost] \
            rivet-app [dict create \
                hosts rivet.example.test \
                environment {rivet}]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set configuration [$dispatcher application_configuration rivet-app]
        set script [$dispatcher worker_script $configuration app:rivet-app]
        source [$configuration file]
        set initialize_result [catch {
            ::tclwire::cga::initialize app:rivet-app [$configuration serialize]
        } initialize_message]
        list \
            [$configuration class] \
            [file tail [$configuration file]] \
            [$configuration package] \
            [$configuration reload_on_request] \
            [expr {[string first {environments/rivet_app.tcl} $script] >= 0}] \
            [expr {[string first \
                {package require tclwire::application 0.1} $script] >= 0}] \
            $initialize_result \
            $initialize_message
    } finally {
        catch {::tclwire::cga::shutdown}
        $dispatcher destroy
    }
} -result [list ::tclwire::envs::app::Rivet rivet_app.tcl {} 1 1 0 0 {}]

test application-configuration-1.4e {
    rivet default application sources requested Tcl scripts
} -setup {
    set docroot [makeDirectory rivet-docroot]
    set script_path [file join $docroot hello.tcl]
    ::fileutil::writeFile $script_path {
puts "from rivet script"
}
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set config [dict create \
        docroot $docroot \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                hosts localhost] \
            rivet-app [dict create \
                package tclwire::application \
                hosts rivet.example.test \
                environment {rivet}]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    set configuration [$dispatcher application_configuration rivet-app]
} -body {
    ::tclwire::cga::initialize app:rivet-app [$configuration serialize]
    ::tclwire::cga::execute \
        [dict create \
            application_id rivet-app \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 93 \
            method GET \
            path /hello.tcl]
    update
    set header_event {}
    set output_event {}
    foreach item $::tclwire::application_test::events {
        set event [lindex $item 1]
        switch -exact -- [dict get $event type] {
            http_header { set header_event $event }
            output { set output_event $event }
        }
    }
    set event_dump $::tclwire::application_test::events
    list \
        [$configuration class] \
        [dict get $header_event flags] \
        [dict get $output_event type] \
        [dict get $output_event data] \
        [lmap item $::tclwire::application_test::events {
            dict get [lindex $item 1] type
        }] \
        [expr {[string first {script: puts "from rivet script"} \
            $event_dump] < 0}]
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$dispatcher destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::io end}
    removeDirectory $docroot
} -result [list \
    ::tclwire::envs::app::Rivet \
    [dict create action set name Content-Type \
        value "text/html; charset=utf-8"] \
    output \
    "from rivet script\n" {http_header output complete} 1]

test application-configuration-1.4e0 {
    rivet default application evaluates scripts from their containing directory
} -setup {
    set docroot [makeDirectory rivet-cwd-docroot]
    file mkdir [file join $docroot docs]
    ::fileutil::writeFile [file join $docroot docs sibling.txt] "sibling"
    set script_path [file join $docroot docs cwd.tcl]
    ::fileutil::writeFile $script_path {
puts [file normalize [pwd]]
puts [::rivet::read_file sibling.txt -encoding utf-8]
}
    set expected_directory [file normalize [file join $docroot docs]]
    set starting_directory [file normalize [pwd]]
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set config [dict create \
        docroot $docroot \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                hosts localhost] \
            rivet-app [dict create \
                package tclwire::application \
                hosts rivet.example.test \
                environment {rivet}]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    set configuration [$dispatcher application_configuration rivet-app]
} -body {
    ::tclwire::cga::initialize app:rivet-app [$configuration serialize]
    ::tclwire::cga::execute \
        [dict create \
            application_id rivet-app \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 107 \
            method GET \
            path /docs/cwd.tcl]
    update

    set output {}
    foreach item $::tclwire::application_test::events {
        set event [lindex $item 1]
        if {[dict get $event type] eq "output"} {
            append output [dict get $event data]
        }
    }
    list \
        [expr {$output eq "$expected_directory\nsibling\n"}] \
        [expr {[file normalize [pwd]] eq $starting_directory}]
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$dispatcher destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::io end}
    removeDirectory $docroot
} -result {1 1}

test application-configuration-1.4e01 {
    rivet makeurl builds request-relative URLs with query arguments
} -setup {
    set docroot [makeDirectory rivet-makeurl-docroot]
    file mkdir [file join $docroot docs]
    ::fileutil::writeFile [file join $docroot docs links.tcl] {
puts [::rivet::makeurl]
puts [::rivet::makeurl sibling.tcl]
puts [::rivet::makeurl /assets/site.css]
puts [::rivet::makeurl search.tcl q {hello world} plus {a+b} unicode {caffè}]
puts [::rivet::makeurl /existing?x=1 y 2]
puts [::rivet::makeurl https://cdn.example.test/file.css v 1]
puts [catch {::rivet::makeurl broken only-name} message]
puts $message
}
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set config [dict create \
        docroot $docroot \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                hosts localhost] \
            rivet-app [dict create \
                package tclwire::application \
                hosts rivet.example.test \
                environment {rivet}]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    set configuration [$dispatcher application_configuration rivet-app]
} -body {
    ::tclwire::cga::initialize app:rivet-app [$configuration serialize]
    ::tclwire::cga::execute \
        [dict create \
            application_id rivet-app \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 107 \
            method GET \
            target /docs/links.tcl?current=yes \
            path /docs/links.tcl \
            query current=yes \
            protocol https \
            headers [dict create host rivet.example.test:9443]]
    update

    set output {}
    foreach item $::tclwire::application_test::events {
        set event [lindex $item 1]
        if {[dict get $event type] eq "output"} {
            append output [dict get $event data]
        }
    }
    set output
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$dispatcher destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::io end}
    removeDirectory $docroot
} -result "https://rivet.example.test:9443/docs/links.tcl?current=yes\nhttps://rivet.example.test:9443/docs/sibling.tcl\nhttps://rivet.example.test:9443/assets/site.css\nhttps://rivet.example.test:9443/docs/search.tcl?q=hello+world&plus=a%2bb&unicode=caff%c3%a8\nhttps://rivet.example.test:9443/existing?x=1&y=2\nhttps://cdn.example.test/file.css?v=1\n1\nwrong # args: should be \"::rivet::makeurl ?path? ?name value ...?\"\n"

