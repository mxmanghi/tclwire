test application-dispatcher-1.9t {
    request cleanup removes only files left in the spool area
} -setup {
    set removed_file [makeFile removed upload-cleanup-removed]
    set moved_file [makeFile moved upload-cleanup-moved]
    set moved_destination ${moved_file}.saved
    file rename $moved_file $moved_destination
} -body {
    set request_descriptor [dict create multipart_parts [list \
        [dict create name text body value] \
        [dict create filename removed.txt body_storage spooled_file \
            path $removed_file] \
        [dict create filename moved.txt body_storage spooled_file \
            path $moved_file]]]
    set configuration [::tclwire::ApplicationConfiguration new cleanup-test \
        [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]]]]
    try {
        ::tclwire::cga::cleanup_uploaded_files \
            $configuration $request_descriptor
    } finally {
        $configuration destroy
    }
    list \
        [file exists $removed_file] \
        [file exists $moved_file] \
        [file exists $moved_destination]
} -cleanup {
    catch {file delete $removed_file}
    catch {file delete $moved_file}
    catch {file delete $moved_destination}
} -result {0 0 1}

