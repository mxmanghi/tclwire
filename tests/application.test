            transaction_id 110 \
            method GET \
            path /redirect.tcl]
    update

    set response_event {}
    set location_event {}
    set output {}
    set event_types {}
    foreach item $::tclwire::application_test::events {
        set event [lindex $item 1]
        set type [dict get $event type]
        lappend event_types $type
        switch -exact -- $type {
            response { set response_event $event }
            http_header {
                if {[dict get $event flags name] eq "Location"} {
                    set location_event $event
                }
            }
            output { append output [dict get $event data] }
        }
    }

    list \
        [dict get $response_event flags status] \
        [dict get $response_event flags reason] \
        [dict get $location_event flags value] \
        $output \
        $::tclwire::application_test::rivet_redirect_events \
        $event_types
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$dispatcher destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::io end}
    unset -nocomplain ::tclwire::application_test::rivet_redirect_events
    removeDirectory $docroot
} -result [list \
    301 \
    "Moved Permanently" \
    /target \
    {} \
    [list [dict create error_code redirect location /target]] \
    {http_header response http_header complete}]

test application-configuration-1.4g {
    rivet abort_page runs AbortScript and resets state on the next request
} -setup {
    set docroot [makeDirectory rivet-abort-docroot]
    set abort_path [file join $docroot abort.tcl]
    set status_path [file join $docroot status.tcl]
    ::fileutil::writeFile $abort_path {
puts "before abort"
::rivet::abort_page STOP
puts "after abort"
}
    ::fileutil::writeFile $status_path {
puts [list [::rivet::abort_page -aborting] [::rivet::abort_code]]
puts [::rivet::abort_code -exiting]
}
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set ::tclwire::application_test::rivet_abort_events {}
    set config [dict create \
        docroot $docroot \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                hosts localhost] \
            rivet-app [dict create \
                package tclwire::application \
                hosts rivet.example.test \
                environment {rivet} \
                configure [dict create \
                    abort_script {
                        lappend ::tclwire::application_test::rivet_abort_events \
                            [list abort \
                                [::rivet::abort_page -aborting] \
                                [::rivet::abort_code] \
                                [::rivet::abort_code -exiting]]
                    } \
                    after_every_script {
                        lappend ::tclwire::application_test::rivet_abort_events \
                            [list afterevery \
                                [::rivet::abort_page -aborting] \
                                [::rivet::abort_code] \
                                [::rivet::abort_code -exiting]]
                    }]]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    set configuration [$dispatcher application_configuration rivet-app]
} -body {
    ::tclwire::cga::initialize app:rivet-app [$configuration serialize]
    ::tclwire::cga::execute \
        [dict create \
            application_id rivet-app \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 95 \
            method GET \
            path /abort.tcl]
    ::tclwire::cga::execute \
        [dict create \
            application_id rivet-app \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 96 \
            method GET \
            path /status.tcl]
    update

    set abort_output {}
    set status_output {}
    set abort_types {}
    set status_types {}
    foreach item $::tclwire::application_test::events {
        lassign $item transaction_id event
        set type [dict get $event type]
        if {$transaction_id == 95} {
            lappend abort_types $type
            if {$type eq "output"} {
                append abort_output [dict get $event data]
            }
        } elseif {$transaction_id == 96} {
            lappend status_types $type
            if {$type eq "output"} {
                append status_output [dict get $event data]
            }
        }
    }
    list \
        $abort_output \
        $status_output \
        $::tclwire::application_test::rivet_abort_events \
        $abort_types \
        $status_types
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$dispatcher destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::io end}
    unset -nocomplain ::tclwire::application_test::rivet_abort_events
    removeDirectory $docroot
} -result [list \
    "before abort\n" \
    "0 {}\n0\n" \
    {{abort 1 STOP 0} {afterevery 1 STOP 0} {afterevery 0 {} 0}} \
    {http_header output complete} \
    {http_header output complete}]

test application-configuration-1.4h {
    rivet exit stops the script and requests CGA thread retirement
} -setup {
    set docroot [makeDirectory rivet-exit-docroot]
    set script_path [file join $docroot exit.tcl]
    ::fileutil::writeFile $script_path {
puts "before exit"
exit 7
puts "after exit"
}
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set ::tclwire::application_test::rivet_exit_events {}
    set config [dict create \
        docroot $docroot \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                hosts localhost] \
            rivet-app [dict create \
                package tclwire::application \
                hosts rivet.example.test \
                environment {rivet} \
                configure [dict create \
                    before_script {
                        proc ::Rivet::exit_cleanup {{code 0}} {
                            lappend ::tclwire::application_test::rivet_exit_events \
                                [list cleanup $code]
                        }
                    } \
                    abort_script {
                        lappend ::tclwire::application_test::rivet_exit_events \
                            [list abort \
                                [::rivet::abort_page -aborting] \
                                [::rivet::abort_code] \
                                [::rivet::abort_code -exiting]]
                    } \
                    after_every_script {
                        lappend ::tclwire::application_test::rivet_exit_events \
                            [list afterevery \
                                [::tclwire::cga::thread_exit_requested] \
                                [::rivet::abort_code -exiting]]
                    }]]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    set configuration [$dispatcher application_configuration rivet-app]
} -body {
    ::tclwire::cga::initialize app:rivet-app [$configuration serialize]
    ::tclwire::cga::configure_thread_exit_command {
        lappend ::tclwire::application_test::rivet_exit_events \
            [list release [::thread::id]]
    }
    set exit_intercepted [list \
        [expr {
            [info commands ::tcl::exit_process] ne {} &&
            [string match {*::tclwire::cga::exit*} [info body ::exit]]
        }] \
        [expr {[string first ::rivet [info body ::tclwire::cga::exit]] < 0}]]
    ::tclwire::cga::execute \
        [dict create \
            application_id rivet-app \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 97 \
            method GET \
            path /exit.tcl]
    update

    set output {}
    set types {}
    foreach item $::tclwire::application_test::events {
        lassign $item transaction_id event
        set type [dict get $event type]
        lappend types $type
        if {$type eq "output"} {
            append output [dict get $event data]
        }
    }
    list \
        $exit_intercepted \
        $output \
        $::tclwire::application_test::rivet_exit_events \
        $types
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$dispatcher destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::io end}
    unset -nocomplain ::tclwire::application_test::rivet_exit_events
    removeDirectory $docroot
} -result [list \
    {1 1} \
    "before exit\n" \
    [list \
        [list cleanup 7] \
        [list release $worker_id] \
        [list abort 1 7 1] \
        [list afterevery 1 1]] \
    {http_header output complete}]

test application-configuration-1.5 {
    constructor failures abort content generator initialization
} -setup {
    oo::class create ::tclwire::application_test::FailingConstructor {
        constructor {descriptor} {
            error "constructor failed"
        }
    }
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set configuration [::tclwire::ApplicationConfiguration new failing \
        [dict create \
            class ::tclwire::application_test::FailingConstructor \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]]]]
} -body {
    catch {
        ::tclwire::cga::initialize app:failing [$configuration serialize]
    } message
    set message
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$configuration destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
