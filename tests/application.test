puts [::rivet::upload type upload]
puts [::rivet::upload size upload]
puts [expr {[::rivet::upload tempname upload] ne ""}]
puts [binary encode hex [::rivet::upload data upload]]
set channel [::rivet::upload channel upload]
try {
    puts [binary encode hex [read $channel]]
} finally {
    close $channel
}
set saved [file join [pwd] saved-upload.bin]
puts [file tail [::rivet::upload save upload $saved]]
set channel [open $saved rb]
try {
    puts [binary encode hex [read $channel]]
} finally {
    close $channel
}
puts [binary encode hex [::rivet::upload data mem]]
puts [catch {::rivet::upload data missing} message]
puts $message
