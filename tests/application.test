package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require Thread
package require tclwire::application::io 0.1
package require tclwire::http::application::io 0.1
package require tclwire::application::tools 0.1
package require tclwire::http::range 0.1
package require tclwire::http::redirect 0.1
package require tclwire::http::request 0.1
package require tclwire::transaction_descriptor 0.1
package require tclwire::application 0.1
package require tclwire::application_dispatcher 0.1
package require tclwire::content_generator_agent 0.1
package require tclwire::connection_agent 0.1
package require tclwire::http::errors 0.1

namespace eval ::tclwire::application_test {
    variable events {}
}

test transaction-descriptor-1.1 {
    request fields are immutable while transaction state remains mutable
} -body {
    set transaction [::tclwire::TransactionDescriptor new \
        [dict create method GET path /resource] 7]
    try {
        set immutable_result [catch {
            $transaction set method POST
        } immutable_error]
        $transaction set response_status 201
        $transaction append response_body alpha
        $transaction append response_body beta
        list $immutable_result \
             $immutable_error \
             [$transaction get method] \
             [$transaction get response_status] \
             [$transaction get response_body]
    } finally {
        $transaction destroy
    }
} -result [list \
    1 {transaction field is immutable: method} GET 201 alphabeta]

test connection-agent-1.1 {finished transactions are ignored by id} -body {
    oo::class create ::tclwire::application_test::ConnectionAgentProbe {
        superclass ::tclwire::ConnectionAgent

        method begin {transaction_id descriptor} {
            my begin_transaction $transaction_id $descriptor
        }

        method transaction {transaction_id} {
            my transaction_for $transaction_id
        }

        method finish {transaction_id} {
            my finish_transaction $transaction_id
        }
    }

    lassign [chan pipe] read_channel write_channel
    set agent [::tclwire::application_test::ConnectionAgentProbe new \
        $read_channel 1 127.0.0.1 9000 application-test-connection]
    try {
        $agent begin 1 [dict create method GET path /]
        set before [expr {[$agent transaction 1] ne {}}]
        set descriptor [$agent finish 1]
        list $before \
             [dict get $descriptor transaction_id] \
             [$agent transaction 1]
    } finally {
        catch {$agent destroy}
        catch {close $write_channel}
        catch {::tclwire::application_test::ConnectionAgentProbe destroy}
    }
} -result {1 1 {}}

test http-request-1.1 {HTTP request exposes a read-only semantic interface} -body {
    set request [::tclwire::HttpRequest new [dict create    method GET \
                                                            target /search?q=Tcl \
                                                            path /search \
                                                            query q=Tcl \
                                                            query_dict [dict create q Tcl] \
                                                            version 1.1 \
                                                            headers [dict create host localhost x-test yes] \
                                                            trailers [dict create x-checksum accepted] \
                                                            body_media raw \
                                                            body_storage in_memory \
                                                            body payload \
                                                            body_size 7 \
                                                            transaction_id 3]]
    try {
        list [$request method] \
             [$request path] \
             [$request query_dict] \
             [$request query_parameter q] \
             [$request header X-Test] \
             [$request trailer X-Checksum] \
             [$request body] \
             [expr {"set" ni [info object methods $request -all]}]
    } finally {
        $request destroy
    }
} -result {GET /search {q Tcl} Tcl yes accepted payload 1}

test http-request-1.2 {HTTP request exposes Content-Type parameters} -body {
    set request [::tclwire::HttpRequest new \
        [dict create    method      POST \
                        target      /upload \
                        path        /upload \
                        query       {}    \
                        version     1.1 \
                        headers [dict create \
                            content-type {Multipart/Form-Data; boundary="AaB03x"; charset=utf-8}] \
                        body_media  raw \
                        body_storage in_memory \
                        body        {} \
                        body_size   0 \
                        transaction_id 3]]
    try {
        list [$request content_type] \
             [$request media_type] \
             [$request content_type_parameter boundary] \
             [$request content_type_parameter charset] \
             [$request is_multipart]
    } finally {
        $request destroy
    }
} -result [list \
    {Multipart/Form-Data; boundary="AaB03x"; charset=utf-8} \
    multipart/form-data \
    AaB03x \
    utf-8 \
    1]

test http-request-1.3 {HTTP request exposes multipart form fields and files} -body {
    set boundary AaB03x
    set body [binary format a* {}]
    append body "--$boundary\r\n"
    append body "Content-Disposition: form-data; name=\"field\"\r\n\r\n"
    append body "value1\r\n"
    append body "--$boundary\r\n"
    append body "Content-Disposition: form-data; name=\"field\"\r\n\r\n"
    append body "value2\r\n"
    append body "--$boundary\r\n"
    append body "Content-Disposition: form-data; name=\"upload\"; filename=\"hello.txt\"\r\n"
    append body "Content-Type: text/plain\r\n\r\n"
    append body "hello file\r\n"
    append body "--$boundary--\r\n"

    set request [::tclwire::HttpRequest new [dict create \
        method POST \
        target /upload \
        path /upload \
        query {} \
        version 1.1 \
        headers [dict create \
            content-type "multipart/form-data; boundary=$boundary"] \
        body_media raw \
        body_storage in_memory \
        body $body \
        body_size [string length $body] \
        transaction_id 3]]
    try {
        set file [$request uploaded_file upload]
        list \
            [llength [$request multipart_parts]] \
            [$request form_values field] \
            [$request form_value field] \
            [dict get [$request form_fields] field] \
            [dict get $file name] \
            [dict get $file filename] \
            [dict get $file content_type] \
            [dict get $file body]
    } finally {
        $request destroy
    }
} -result {3 {value1 value2} value2 value2 upload hello.txt text/plain {hello file}}

test http-request-1.4 {multipart requests require a boundary parameter} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method POST \
        target /upload \
        path /upload \
        query {} \
        version 1.1 \
        headers [dict create content-type multipart/form-data] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 3]]
    try {
        catch {$request multipart_parts} message
        set message
    } finally {
        $request destroy
    }
} -result {multipart Content-Type is missing boundary}

test http-request-1.4a {
    form and upload helpers are empty for non-multipart requests
} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method POST \
        target /submit \
        path /submit \
        query {} \
        version 1.1 \
        headers [dict create] \
        body_media raw \
        body_storage in_memory \
        body {} \
        body_size 0 \
        transaction_id 3]]
    try {
        list \
            [$request is_multipart] \
            [$request form_fields] \
            [$request form_values field] \
            [$request form_value field default] \
            [$request uploaded_files] \
            [$request uploaded_file upload]
    } finally {
        $request destroy
    }
} -result {0 {} {} default {} {}}

test http-request-1.5 {multipart storage preserves multiple uploaded files} -setup {
    set upload_area [file join [temporaryDirectory] tclwire-uploads-[pid]]
    file delete -force $upload_area
} -body {
    set parts [list \
        [dict create name title body report] \
        [dict create name attachments filename one.bin body "one\0data"] \
        [dict create name attachments filename two.bin body "two\0data"]]
    set stored [::tclwire::http::multipart store_files $parts $upload_area]
    set files [::tclwire::http::multipart files $stored attachments]
    set contents {}
    foreach part $files {
        set channel [open [dict get $part path] rb]
        try {
            lappend contents [read $channel]
        } finally {
            close $channel
        }
    }
    list \
        [llength $files] \
        [dict get [lindex $stored 0] body] \
        [lmap part $files {dict get $part body_storage}] \
        [lmap part $files {dict get $part body_size}] \
        [expr {[lmap part $files {dict get $part path}] eq \
            [lmap part $files {dict get $part body_path}]}] \
        [expr {[dict get [lindex $files 0] path] ne \
               [dict get [lindex $files 1] path]}] \
        [lmap part $files {
            string match tclwire-upload_* \
                [file tail [dict get $part path]]
        }] \
        $contents
} -cleanup {
    file delete -force $upload_area
} -result [list 2 report {spooled_file spooled_file} {8 8} 1 1 {1 1} \
    [list "one\0data" "two\0data"]]

test http-request-1.6 {multipart storage rejects an empty upload area} -body {
    catch {
        ::tclwire::http::multipart store_files \
            [list [dict create filename upload.bin body data]] {}
    } message
    set message
} -result {multipart upload area must not be empty}

test application-tools-1.1 {makeurl builds URLs from the current request} -body {
    try {
        ::tclwire::tools::begin [dict create \
            protocol https \
            path /scripts/report.tcl \
            headers [dict create host example.test:9443]]
        list \
            [::tclwire::tools::makeurl] \
            [::tclwire::tools::makeurl chart.png] \
            [::tclwire::tools::makeurl /assets/site.css] \
            [::tclwire::tools::makeurl index.html]
    } finally {
        ::tclwire::tools::end
    }
} -result [list \
    https://example.test:9443/scripts/report.tcl \
    https://example.test:9443/scripts/chart.png \
    https://example.test:9443/assets/site.css \
    https://example.test:9443/scripts/index.html]

test application-tools-1.2 {makeurl preserves directory script URLs} -body {
    try {
        ::tclwire::tools::begin [dict create \
            protocol http \
            path /docs/ \
            headers [dict create host example.test]]
        list \
            [::tclwire::tools::makeurl] \
            [::tclwire::tools::makeurl intro.html]
    } finally {
        ::tclwire::tools::end
    }
} -result [list \
    http://example.test/docs/ \
    http://example.test/docs/intro.html]

test application-tools-1.3 {makeurl requires a current request context} -body {
    catch {::tclwire::tools::makeurl} message
    set message
} -result {no current application request is active}

test application-tools-1.4 {load_env copies environment into the default array} -body {
    set original_exists [info exists ::env(TCLWIRE_LOAD_ENV_TEST)]
    if {$original_exists} {
        set original_value $::env(TCLWIRE_LOAD_ENV_TEST)
    }
    set ::env(TCLWIRE_LOAD_ENV_TEST) default-value
    try {
        apply {{} {
            ::tclwire::tools::load_env
            return $env(TCLWIRE_LOAD_ENV_TEST)
        }}
    } finally {
        if {$original_exists} {
            set ::env(TCLWIRE_LOAD_ENV_TEST) $original_value
        } else {
            unset -nocomplain ::env(TCLWIRE_LOAD_ENV_TEST)
        }
    }
} -result default-value

test application-tools-1.5 {load_env copies environment into a named array} -body {
    set original_exists [info exists ::env(TCLWIRE_LOAD_ENV_TEST)]
    if {$original_exists} {
        set original_value $::env(TCLWIRE_LOAD_ENV_TEST)
    }
    set ::env(TCLWIRE_LOAD_ENV_TEST) named-value
    try {
        unset -nocomplain copied
        ::tclwire::tools::load_env copied
        set copied(TCLWIRE_LOAD_ENV_TEST)
    } finally {
        unset -nocomplain copied
        if {$original_exists} {
            set ::env(TCLWIRE_LOAD_ENV_TEST) $original_value
        } else {
            unset -nocomplain ::env(TCLWIRE_LOAD_ENV_TEST)
        }
    }
} -result named-value

test application-tools-1.6 {load_env replaces stale target array entries} -body {
    array set copied [list STALE value]
    try {
        ::tclwire::tools::load_env copied
        info exists copied(STALE)
    } finally {
        unset -nocomplain copied
    }
} -result 0

oo::class create ::tclwire::application_test::OutputReceiver {
    method application_output {transaction_id event} {
        lappend ::tclwire::application_test::events \
            [list $transaction_id $event]
    }
}

set application_config [dict create \
    docroot [file normalize /tmp/tclwire-default-docroot] \
    encoding utf-8 \
    default_application default \
    applications [dict create \
        default [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts {localhost 127.0.0.1}]]]

test application-configuration-1.1 {
    construction defines optional properties and snapshots are value copies
} -body {
    set configuration [::tclwire::ApplicationConfiguration new example \
        [dict create \
            class ::example::Application \
            package example::application \
            hosts example.test \
            docroot /tmp \
            encoding utf-8 \
            application_paths [list /tmp] \
            configure [dict create \
                ::example::Application [dict create message configured]]]]
    try {
        set snapshot [$configuration snapshot]
        dict set snapshot retain_uploaded_files 1
        list \
            [$configuration id] \
            [$configuration file] \
            [$configuration reload_on_request] \
            [$configuration retain_uploaded_files] \
            [dict get [$configuration pool_policy] maximum_workers] \
            [dict get [$configuration class_configuration ::example::Application] message]
    } finally {
        $configuration destroy
    }
} -result {example {} 0 0 20 configured}

test application-configuration-1.2 {
    dispatcher exposes validated immutable application configurations
} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set configuration [$dispatcher application_configuration default]
        list \
            [info object isa typeof $configuration \
                ::tclwire::ApplicationConfiguration] \
            [$configuration class] \
            [$configuration encoding]
    } finally {
        $dispatcher destroy
    }
} -result {1 ::tclwire::CApplication utf-8}

test application-configuration-1.2b {
    dispatcher merges class-scoped configuration for virtual hosts
} -body {
    set config [dict create \
        docroot /tmp \
        encoding utf-8 \
        default_application default \
        applications [dict create \
            default [dict create \
                class ::tclwire::CApplication \
                package tclwire::application \
                hosts localhost \
                configure [dict create \
                    ::tclwire::CApplication [dict create directory_index index.html] \
                    ::example::Hello [dict create message default style plain]]] \
            hello [dict create \
                class ::example::Hello \
                package example::hello \
                hosts hello.example.test \
                configure [dict create \
                    ::example::Hello [dict create message host]]]]]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set configuration [$dispatcher application_configuration hello]
        list \
            [dict get [$configuration class_configuration ::tclwire::CApplication] directory_index] \
            [dict get [$configuration class_configuration ::example::Hello] message] \
            [dict get [$configuration class_configuration ::example::Hello] style]
    } finally {
        $dispatcher destroy
    }
} -result {index.html host plain}

test application-configuration-1.3 {
    serialized configurations reconstruct validated immutable objects
} -body {
    set original [::tclwire::ApplicationConfiguration new example \
        [dict create \
            class ::example::Application \
            package example::application \
            hosts example.test \
            docroot /tmp \
            encoding utf-8 \
            application_paths [list /tmp] \
            retain_uploaded_files 1]]
    try {
        set restored [::tclwire::ApplicationConfiguration deserialize \
            [$original serialize]]
        try {
            list \
                [$restored id] \
                [$restored class] \
                [$restored retain_uploaded_files] \
                [expr {[$restored snapshot] eq [$original snapshot]}]
        } finally {
            $restored destroy
        }
    } finally {
        $original destroy
    }
} -result {example ::example::Application 1 1}

test application-configuration-1.4 {
    deserialization rejects unsupported wire versions
} -body {
    catch {
        ::tclwire::ApplicationConfiguration deserialize [dict create \
            type tclwire.application_configuration \
            version 2 \
            application_id example \
            values {}]
    } message
    set message
} -result {unsupported application configuration version: 2}

test application-configuration-1.5 {
    constructor failures reach the connection agent as error events
} -setup {
    oo::class create ::tclwire::application_test::FailingConstructor {
        constructor {descriptor} {
            error "constructor failed"
        }
    }
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set configuration [::tclwire::ApplicationConfiguration new failing \
        [dict create \
            class ::tclwire::application_test::FailingConstructor \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]]]]
} -body {
    ::tclwire::cga::initialize app:failing [$configuration serialize]
    ::tclwire::cga::execute \
        [dict create \
            application_id failing \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 91 \
            method GET \
            path /]
    update
    lassign [lindex $::tclwire::application_test::events 0] \
        transaction_id event
    list \
        $transaction_id \
        [dict get $event type] \
        [dict get $event data]
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$configuration destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::application_test::FailingConstructor destroy}
    catch {::tclwire::io end}
} -match glob -result {91 error {constructor failed}} -errorOutput \
{application level=error *constructor failed*}

test application-dispatcher-1.1 {missing Host selects the default application} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        $dispatcher select_application [dict create headers [dict create]]
    } finally {
        $dispatcher destroy
    }
} -result default

test application-dispatcher-1.2 {configured hosts select the default application} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        list \
            [$dispatcher select_application [dict create \
                headers [dict create host localhost:8990]]] \
            [$dispatcher select_application [dict create \
                headers [dict create host 127.0.0.1]]]
    } finally {
        $dispatcher destroy
    }
} -result {default default}

test application-dispatcher-1.3 {unknown hosts are rejected} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        catch {
            $dispatcher select_application [dict create \
                headers [dict create host unknown.example]]
        } message
        set message
    } finally {
        $dispatcher destroy
    }
} -result {no application is configured for Host 'unknown.example'}

test application-dispatcher-1.4 {applications inherit the global document root} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        dict get [$dispatcher application default] docroot
    } finally {
        $dispatcher destroy
    }
} -result [file normalize /tmp/tclwire-default-docroot]

test application-dispatcher-1.5 {applications inherit the global encoding} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        dict get [$dispatcher application default] encoding
    } finally {
        $dispatcher destroy
    }
} -result utf-8

test application-dispatcher-1.6 {an application document root overrides the global default} -body {
    set config $application_config
    dict set config applications default docroot \
        [file normalize /tmp/tclwire-application-docroot]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        dict get [$dispatcher application default] docroot
    } finally {
        $dispatcher destroy
    }
} -result [file normalize /tmp/tclwire-application-docroot]

test application-dispatcher-1.7 {an explicit application root needs no global fallback} -body {
    set config [dict remove $application_config docroot]
    dict set config applications default docroot \
        [file normalize /tmp/tclwire-explicit-docroot]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        dict get [$dispatcher application default] docroot
    } finally {
        $dispatcher destroy
    }
} -result [file normalize /tmp/tclwire-explicit-docroot]

test application-dispatcher-1.8 {file-backed applications use source in workers} -setup {
    set application_file [makeFile {
oo::class create ::example::Application {
    constructor {descriptor} {}
    method handle_request {descriptor} {}
}
} file-backed-application.tcl]
} -body {
    set config $application_config
    dict set config applications default [dict create \
        class ::example::Application \
        file $application_file \
        hosts example.test \
        docroot /tmp \
        encoding utf-8]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set script [$dispatcher worker_script \
            [$dispatcher application_configuration default] app:default]
        list \
            [expr {[string first [list source $application_file] $script] >= 0}] \
            [expr {[string first {package require tclwire::application 0.1} \
                $script] < 0}]
    } finally {
        $dispatcher destroy
    }
} -cleanup {
    removeFile $application_file
} -result {1 1}

test application-dispatcher-1.9 {package-backed applications remain supported} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set configuration [$dispatcher application_configuration default]
        expr {[string first \
            {package require tclwire::application 0.1} \
            [$dispatcher worker_script $configuration app:default]] >= 0}
    } finally {
        $dispatcher destroy
    }
} -result 1

test application-dispatcher-1.9r {
    file-backed application classes can be replaced during development
} -setup {
    set application_file [makeFile {
oo::class create ::example::ReloadableApplication {
    method version {} { return first }
}
} reloadable-application.tcl]
    source $application_file
} -body {
    set descriptor [dict create \
        class ::example::ReloadableApplication \
        hosts localhost \
        docroot [temporaryDirectory] \
        encoding utf-8 \
        application_paths [list [temporaryDirectory]] \
        file $application_file \
        reload_on_request 1]
    set configuration [::tclwire::ApplicationConfiguration new \
        reload-test $descriptor]
    ::fileutil::writeFile $application_file {
oo::class create ::example::ReloadableApplication {
    method version {} { return second }
}
}
    ::tclwire::cga::reload_application_class \
        ::example::ReloadableApplication $configuration
    set application [::example::ReloadableApplication new]
    try {
        $application version
    } finally {
        $application destroy
    }
} -cleanup {
    catch {$configuration destroy}
    catch {::example::ReloadableApplication destroy}
    removeFile $application_file
} -result second

test application-dispatcher-1.9s {
    package-backed applications reject per-request reloading
} -body {
    set config $application_config
    dict set config applications default reload_on_request 1
    catch {::tclwire::ApplicationDispatcher new $config} message
    set message
} -result {application 'default' reload_on_request requires file}

test application-dispatcher-1.9t {
    request cleanup removes only files left in the spool area
} -setup {
    set removed_file [makeFile removed upload-cleanup-removed]
    set moved_file [makeFile moved upload-cleanup-moved]
    set moved_destination ${moved_file}.saved
    file rename $moved_file $moved_destination
} -body {
    set request_descriptor [dict create multipart_parts [list \
        [dict create name text body value] \
        [dict create filename removed.txt body_storage spooled_file \
            path $removed_file] \
        [dict create filename moved.txt body_storage spooled_file \
            path $moved_file]]]
    set configuration [::tclwire::ApplicationConfiguration new cleanup-test \
        [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]]]]
    try {
        ::tclwire::cga::cleanup_uploaded_files \
            $configuration $request_descriptor
    } finally {
        $configuration destroy
    }
    list \
        [file exists $removed_file] \
        [file exists $moved_file] \
        [file exists $moved_destination]
} -cleanup {
    catch {file delete $removed_file}
    catch {file delete $moved_file}
    catch {file delete $moved_destination}
} -result {0 0 1}

test application-dispatcher-1.9ta {
    request cleanup removes a whole-body spool file
} -setup {
    set body_file [makeFile payload request-body-cleanup]
} -body {
    set configuration [::tclwire::ApplicationConfiguration new cleanup-test \
        [dict create class ::tclwire::CApplication \
            package tclwire::application hosts localhost \
            docroot [temporaryDirectory] encoding utf-8 \
            application_paths [list [temporaryDirectory]]]]
    try {
        ::tclwire::cga::cleanup_uploaded_files $configuration \
            [dict create body_storage spooled_file body_path $body_file]
        file exists $body_file
    } finally {
        $configuration destroy
    }
} -cleanup {
    catch {file delete $body_file}
} -result 0

test application-dispatcher-1.9u {
    application configuration can retain request spool files
} -setup {
    set retained_file [makeFile retained upload-cleanup-retained]
} -body {
    set configuration [::tclwire::ApplicationConfiguration new cleanup-test \
        [dict create \
            class ::tclwire::CApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]] \
            retain_uploaded_files 1]]
    try {
        ::tclwire::cga::cleanup_uploaded_files $configuration \
            [dict create multipart_parts [list \
                [dict create filename retained.txt body_storage spooled_file \
                    path $retained_file]]]
    } finally {
        $configuration destroy
    }
    file exists $retained_file
} -cleanup {
    catch {file delete $retained_file}
} -result 1

test application-dispatcher-1.9a {
    worker auto_path includes application paths before package loading
} -body {
    set config $application_config
    set docroot [file normalize /tmp/tclwire-package-docroot]
    set libdir [file normalize /tmp/tclwire-package-libdir]
    dict set config applications default docroot $docroot
    dict set config applications default libdir $libdir
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set configuration [$dispatcher application_configuration default]
        set script [$dispatcher worker_script $configuration app:default]
        set docroot_index [string first $docroot $script]
        set libdir_index [string first $libdir $script]
        set package_index [string first \
            {package require tclwire::application 0.1} $script]
        list \
            [expr {$docroot_index >= 0}] \
            [expr {$libdir_index > $docroot_index}] \
            [expr {$package_index > $libdir_index}]
    } finally {
        $dispatcher destroy
    }
} -result {1 1 1}

test application-dispatcher-1.9b {
    worker scripts notify their pool before removing accounting
} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set configuration [$dispatcher application_configuration default]
        set script [$dispatcher worker_script $configuration app:default]
        list \
            [expr {[string first {operation remove_worker} $script] >= 0}] \
            [expr {[string first {pool_key app:default} $script] >= 0}] \
            [expr {[string first {operation remove_worker} $script] < \
                [string first {::tclwire::accounting remove_thread} $script]}]
    } finally {
        $dispatcher destroy
    }
} -result {1 1 1}

test application-dispatcher-1.9ba {
    application worker scripts require a pool key
} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        set configuration [$dispatcher application_configuration default]
        catch {$dispatcher worker_script $configuration {   }} message
        set message
    } finally {
        $dispatcher destroy
    }
} -result {application worker pool key must not be empty}

test application-dispatcher-1.9c {
    application descriptors include worker application paths
} -body {
    set config $application_config
    set docroot [file normalize /tmp/tclwire-package-docroot]
    set libdir [file normalize /tmp/tclwire-package-libdir]
    dict set config applications default docroot $docroot
    dict set config applications default libdir $libdir
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set expected {}
        foreach directory [list \
                [file normalize [pwd]] \
                $docroot \
                $libdir \
                $project_root] {
            if {$directory ni $expected} {
                lappend expected $directory
            }
        }
        expr {[dict get [$dispatcher application default] application_paths] eq $expected}
    } finally {
        $dispatcher destroy
    }
} -result 1

test application-dispatcher-1.10 {relative application files prefer run directory} -setup {
    set root [file join [temporaryDirectory] tclwire-app-files-[pid]]
    set run_directory [file join $root run]
    set docroot [file join $root docroot]
    set libdir [file join $root lib]
    file mkdir $run_directory
    file mkdir $docroot
    file mkdir $libdir
    set run_file [file join $run_directory application.tcl]
    set docroot_file [file join $docroot application.tcl]
    set libdir_file [file join $libdir application.tcl]
    ::fileutil::writeFile $run_file {# run directory application}
    ::fileutil::writeFile $docroot_file {# docroot application}
    ::fileutil::writeFile $libdir_file {# libdir application}
} -body {
    set config $application_config
    dict set config libdir $libdir
    dict set config applications default [dict create \
        class ::example::Application \
        file application.tcl \
        hosts example.test \
        docroot $docroot \
        encoding utf-8]
    set previous_directory [pwd]
    cd $run_directory
    try {
        set dispatcher [::tclwire::ApplicationDispatcher new $config]
        try {
            dict get [$dispatcher application default] file
        } finally {
            $dispatcher destroy
        }
    } finally {
        cd $previous_directory
    }
} -cleanup {
    file delete -force $root
} -result [file normalize [file join \
    [temporaryDirectory] tclwire-app-files-[pid] run application.tcl]]

test application-dispatcher-1.10a {relative application files prefer docroot after run directory} -setup {
    set root [file join [temporaryDirectory] tclwire-docroot-app-files-[pid]]
    set run_directory [file join $root run]
    set docroot [file join $root docroot]
    set libdir [file join $root lib]
    file mkdir $run_directory
    file mkdir $docroot
    file mkdir $libdir
    set docroot_file [file join $docroot application.tcl]
    set libdir_file [file join $libdir application.tcl]
    ::fileutil::writeFile $docroot_file {# docroot application}
    ::fileutil::writeFile $libdir_file {# libdir application}
} -body {
    set config $application_config
    dict set config libdir $libdir
    dict set config applications default [dict create \
        class ::example::Application \
        file application.tcl \
        hosts example.test \
        docroot $docroot \
        encoding utf-8]
    set previous_directory [pwd]
    cd $run_directory
    try {
        set dispatcher [::tclwire::ApplicationDispatcher new $config]
        try {
            dict get [$dispatcher application default] file
        } finally {
            $dispatcher destroy
        }
    } finally {
        cd $previous_directory
    }
} -cleanup {
    file delete -force $root
} -result [file normalize [file join \
    [temporaryDirectory] tclwire-docroot-app-files-[pid] docroot application.tcl]]

test application-dispatcher-1.11 {application libdir overrides global libdir} -setup {
    set root [file join [temporaryDirectory] tclwire-app-libdir-[pid]]
    set global_libdir [file join $root global]
    set application_libdir [file join $root application]
    file mkdir $global_libdir
    file mkdir $application_libdir
    set application_file [file join $application_libdir application.tcl]
    ::fileutil::writeFile $application_file {# application libdir}
} -body {
    set config $application_config
    dict set config libdir $global_libdir
    dict set config applications default [dict create \
        class ::example::Application \
        file application.tcl \
        libdir $application_libdir \
        hosts example.test \
        docroot [file join $root docroot] \
        encoding utf-8]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        list \
            [dict get [$dispatcher application default] file] \
            [dict get [$dispatcher application default] libdir]
    } finally {
        $dispatcher destroy
    }
} -cleanup {
    file delete -force $root
} -result [list \
    [file normalize [file join \
        [temporaryDirectory] tclwire-app-libdir-[pid] application application.tcl]] \
    [file normalize [file join \
        [temporaryDirectory] tclwire-app-libdir-[pid] application]]]

test application-dispatcher-1.12 {relative files fall back to TclWire installation} -body {
    set config $application_config
    dict set config applications default [dict create \
        class ::tclwire::CApplication \
        file [file join tcl application.tcl] \
        hosts localhost \
        docroot [file join [temporaryDirectory] absent-docroot] \
        encoding utf-8]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        dict get [$dispatcher application default] file
    } finally {
        $dispatcher destroy
    }
} -result [file normalize [file join $project_root tcl application.tcl]]

test application-dispatcher-1.13 {host descriptors can reuse a default application class} -body {
    set config $application_config
    dict set config applications example.test [dict create \
        hosts example.test \
        docroot /tmp/example.test]
    set dispatcher [::tclwire::ApplicationDispatcher new $config]
    try {
        set descriptor [$dispatcher application example.test]
        list \
            [dict get $descriptor class] \
            [dict get $descriptor package] \
            [dict get $descriptor hosts] \
            [dict get $descriptor docroot]
    } finally {
        $dispatcher destroy
    }
} -result [list \
    ::tclwire::CApplication \
    tclwire::application \
    example.test \
    [file normalize /tmp/example.test]]

test application-1.1 {CApplication receives its effective document root} -body {
    set descriptor [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot ./application-root \
        encoding iso8859-1]
    set application [::tclwire::CApplication new $descriptor]
    try {
        list \
            [$application document_root] \
            [[$application configuration_object] docroot] \
            [$application encoding]
    } finally {
        $application destroy
    }
} -result [list \
    [file normalize ./application-root] \
    ./application-root \
    iso8859-1]

test application-1.2 {CApplication reads content using its configured encoding} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-[pid]]
    set expected "Caff\u00e8"
    ::fileutil::writeFile -encoding iso8859-1 \
        [file join $docroot index.html] $expected
    set descriptor [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot $docroot \
        encoding iso8859-1]
    set application [::tclwire::CApplication new $descriptor]
    set request [::tclwire::HttpRequest new [dict create \
        method GET path / transaction_id 8]]
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    try {
        ::tclwire::io begin [::thread::id] $receiver 8
        $application handle_request $request
        ::tclwire::io complete
        ::tclwire::io end
        update
        set response_event \
            [lindex [lindex $::tclwire::application_test::events 0] 1]
        set output_event \
            [lindex [lindex $::tclwire::application_test::events 1] 1]
        list \
            [dict get $response_event type] \
            [dict get $response_event flags body_mode] \
            [encoding convertfrom iso8859-1 \
                [dict get $output_event data]]
    } finally {
        catch {::tclwire::io end}
        $request destroy
        $receiver destroy
        $application destroy
        file delete -force $docroot
    }
} -result [list response binary "Caff\u00e8"]

test application-1.3 {CApplication maps URL paths beneath its document root} -body {
    set docroot [file join [temporaryDirectory] tclwire-application-[pid]]
    file mkdir [file join $docroot assets]
    ::fileutil::writeFile -encoding utf-8 \
        [file join $docroot assets hello.txt] hello
    set application [::tclwire::CApplication new [dict create \
        class ::tclwire::CApplication \
        package tclwire::application \
        hosts localhost \
        docroot $docroot \
        encoding utf-8]]
    try {
        list \
            [$application local_path /assets/hello.txt] \
            [$application local_path /assets/../hello.txt] \
            [$application local_path /%2e%2e/secret.txt]
    } finally {
        $application destroy
        file delete -force $docroot
    }
} -result [list \
    [file join [temporaryDirectory] tclwire-application-[pid] assets hello.txt] \
    {} \
    {}]

test application-io-1.1 {output commands send ordered transaction events} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 7
        ::tclwire::io out alpha
        ::tclwire::io flush
        ::tclwire::io complete
        ::tclwire::io end
        update

        set summary {}
        foreach item $::tclwire::application_test::events {
            lassign $item transaction_id event
            lappend summary \
                $transaction_id \
                [dict get $event type] \
                [dict get $event output_sequence]
        }
        set summary
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {7 output 1 7 flush 2 7 complete 3}

test application-io-1.2 {buffer exposes pending application output} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 15
        ::tclwire::io out alpha
        set first [::tclwire::io buffer]
        ::tclwire::io puts -nonewline beta
        set combined [::tclwire::io buffer]
        ::tclwire::io flush
        set drained [::tclwire::io buffer]
        ::tclwire::io complete
        ::tclwire::io end
        update

        set output_event \
            [lindex [lindex $::tclwire::application_test::events 0] 1]
        list \
            $first \
            $combined \
            $drained \
            [dict get $output_event type] \
            [dict get $output_event data] \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {alpha alphabeta {} output alphabeta {output flush complete}}

test application-io-1.3 {
    explicit completion closes response output while the transaction remains active
} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 19
        ::tclwire::io out alpha
        ::tclwire::io complete

        set state [dict get [::tclwire::io context] response_state]
        ::tclwire::io response 201 Created [list "X-Late: response"]
        ::tclwire::io out beta
        ::tclwire::io puts gamma
        ::tclwire::io flush
        ::tclwire::http::io header set X-Late header
        ::tclwire::http::io cookie late ignored
        ::tclwire::http::no_body
        ::tclwire::io fail "late failure"
        ::tclwire::io complete
        set buffered [::tclwire::io buffer]
        ::tclwire::io end
        update

        list \
            $state \
            $buffered \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }] \
            [dict get [lindex [lindex \
                $::tclwire::application_test::events 0] 1] data]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {completed {} {output complete} alpha}

test http-application-io-1.1 {HTTP header commands maintain and emit metadata} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 9
        ::tclwire::http::io header set Transfer-Encoding chunked
        ::tclwire::http::io header add Set-Cookie first=1
        ::tclwire::http::io header add Set-Cookie second=2
        set transfer_encoding \
            [::tclwire::http::io header get transfer-encoding]
        set cookies [::tclwire::http::io header get set-cookie]
        ::tclwire::http::io header remove Set-Cookie
        set removed [::tclwire::http::io header get Set-Cookie]
        ::tclwire::io end
        update

        set operations {}
        foreach item $::tclwire::application_test::events {
            set event [lindex $item 1]
            lappend operations \
                [dict get $event type] \
                [dict get $event flags action]
        }
        list $transfer_encoding $cookies $removed $operations
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    chunked \
    {first=1 second=2} \
    {} \
    {http_header set http_header add http_header add http_header remove}]

test http-application-io-1.2 {HTTP response headers reject line injection} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 10
        catch {
            ::tclwire::http::io header set X-Test "valid\r\nInjected: yes"
        } message
        set message
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {invalid HTTP response header value}

test http-application-io-1.3 {HTTP cookies support paths and expiration} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 11
        set first [::tclwire::http::io cookie session abc123 \
            -path /account -expires 1893456000]
        set second [::tclwire::http::io cookie preference compact]
        set cookies [::tclwire::http::io header get Set-Cookie]
        ::tclwire::io end
        update

        set emitted {}
        foreach item $::tclwire::application_test::events {
            set event [lindex $item 1]
            lappend emitted \
                [dict get $event flags action] \
                [dict get $event flags value]
        }
        list $first $second $cookies $emitted
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
    {preference=compact} \
    [list \
        {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
        {preference=compact}] \
    [list \
        add \
        {session=abc123; Path=/account; Expires=Tue, 01 Jan 2030 00:00:00 GMT} \
        add \
        {preference=compact}]]

test http-application-io-1.4 {HTTP cookie expiration accepts dates} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 12
        ::tclwire::http::io cookie session abc123 \
            -expires {2030-01-01 00:00:00 UTC}
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result {session=abc123; Expires=Tue, 01 Jan 2030 00:00:00 GMT}

test http-application-io-1.5 {HTTP cookies reject invalid attributes} -body {
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 13
        set messages {}
        foreach command {
            {::tclwire::http::io cookie {bad name} value}
            {::tclwire::http::io cookie name {bad;value}}
            {::tclwire::http::io cookie name value -path relative}
            {::tclwire::http::io cookie name value -expires never-ever}
        } {
            catch $command message
            lappend messages $message
        }
        set messages
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list \
    {invalid HTTP cookie name} \
    {invalid HTTP cookie value} \
    {invalid HTTP cookie path} \
    {invalid HTTP cookie expiration}]

test http-range-1.1 {byte ranges support closed open and suffix forms} -body {
    set results {}
    foreach value {bytes=2-5 bytes=7- bytes=-4 bytes=0-99} {
        set result [::tclwire::http::range classify $value 10]
        lappend results \
            [dict get $result status] \
            [dict get $result ranges]
    }
    set results
} -result [list \
    satisfiable {{2 5}} \
    satisfiable {{7 9}} \
    satisfiable {{6 9}} \
    satisfiable {{0 9}}]

test http-range-1.2 {mixed range sets retain satisfiable members} -body {
    set result [::tclwire::http::range classify bytes=20-30,2-4 10]
    list [dict get $result status] [dict get $result ranges]
} -result {satisfiable {{2 4}}}

test http-range-1.3 {range outcomes are classified without control-flow errors} -body {
    list \
        [dict get [::tclwire::http::range classify items=0-1 10] status] \
        [dict get [::tclwire::http::range classify bytes=bad 10] status] \
        [dict get [::tclwire::http::range classify bytes=20-30 10] status]
} -result {unsupported malformed unsatisfiable}

test http-redirect-1.1 {redirect responses default to 302 Found} -body {
    ::tclwire::http::redirect response /next
} -result [dict create \
    status 302 \
    reason Found \
    body {} \
    headers [list "Location: /next"] \
    body_mode text]

test http-redirect-1.2 {redirect status determines the reason phrase} -body {
    set results {}
    foreach status {301 302 303 307 308} {
        set response [::tclwire::http::redirect response /next \
            -status $status -body {}]
        lappend results \
            [dict get $response status] \
            [dict get $response reason]
    }
    set results
} -result [list \
    301 "Moved Permanently" \
    302 "Found" \
    303 "See Other" \
    307 "Temporary Redirect" \
    308 "Permanent Redirect"]

test http-redirect-1.3 {redirect responses accept body and extra headers} -body {
    ::tclwire::http::redirect response \
        https://example.test/new-location \
        -status 308 \
        -body "moved\n" \
        -headers [list "Cache-Control: max-age=3600" "X-Test: yes"]
} -result [dict create \
    status 308 \
    reason "Permanent Redirect" \
    body "moved\n" \
    headers [list \
        "Location: https://example.test/new-location" \
        "Cache-Control: max-age=3600" \
        "X-Test: yes"] \
    body_mode text]

test http-redirect-1.4 {redirect responses reject unsafe or conflicting input} -body {
    list \
        [catch {
            ::tclwire::http::redirect response {}
        } empty_location] $empty_location \
        [catch {
            ::tclwire::http::redirect response "/next\r\nX-Test: yes"
        } injected_location] $injected_location \
        [catch {
            ::tclwire::http::redirect response /next -status 305
        } unsupported_status] $unsupported_status \
        [catch {
            ::tclwire::http::redirect response /next \
                -headers [list "Location: /other"]
        } duplicate_location] $duplicate_location
} -result [list \
    1 {HTTP redirect location must not be empty} \
    1 {invalid HTTP redirect location} \
    1 {unsupported HTTP redirect status: 305} \
    1 {HTTP redirect response headers must not contain Location}]

test http-redirect-1.5 {redirect responses can be sent through application I/O} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 17
        set redirect_response [::tclwire::http::redirect send /target \
            -status 303 \
            -body "redirect=/target\n" \
            -headers [list "Content-Type: text/plain; charset=utf-8"]]
        ::tclwire::io complete
        ::tclwire::io end
        update

        set response_event \
            [lindex [lindex $::tclwire::application_test::events 0] 1]
        set output_event \
            [lindex [lindex $::tclwire::application_test::events 1] 1]
        list \
            [dict get $redirect_response status] \
            [dict get $response_event flags reason] \
            [dict get $response_event flags headers] \
            [dict get $output_event data] \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list 303 "See Other" \
                [list   "Location: /target" "Content-Type: text/plain; charset=utf-8"] \
                        "redirect=/target\n" \
                        {response output complete}]

test http-redirect-1.6 {redirect responses preserve an explicit content type} -body {
    set response [::tclwire::http::redirect response /target \
        -body {} \
        -headers [list "Content-Type: text/html; charset=utf-8"]]
    dict get $response headers
} -result [list \
    "Location: /target" \
    "Content-Type: text/html; charset=utf-8"]

test application-io-1.8 {HTTP no_body discards pending application output} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 18
        ::tclwire::io out "discarded body"
        ::tclwire::http::no_body
        set buffered [::tclwire::io buffer]
        ::tclwire::io complete
        ::tclwire::io end
        update

        list \
            $buffered \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list {} {no_body complete}]

test application-io-1.9 {application output can request connection close} -body {
    set ::tclwire::application_test::events {}
    set receiver [::tclwire::application_test::OutputReceiver new]
    try {
        ::tclwire::io begin [::thread::id] $receiver 20
        ::tclwire::io out "discarded body"
        ::tclwire::io close_connection
        set state [dict get [::tclwire::io context] response_state]
        set buffered [::tclwire::io buffer]
        ::tclwire::io out "ignored"
        ::tclwire::io complete
        ::tclwire::io end
        update

        list \
            $state \
            $buffered \
            [lmap item $::tclwire::application_test::events {
                dict get [lindex $item 1] type
            }]
    } finally {
        catch {::tclwire::io end}
        $receiver destroy
    }
} -result [list completed {} close_connection]

test application-1.4 {HEAD obtains file metadata without reading the file} -setup {
    oo::class create ::tclwire::application_test::MetadataApplication {
        superclass ::tclwire::CApplication
        method read_file {path} {
            error "HEAD attempted a complete file read"
        }
        method read_file_range {path start end} {
            error "HEAD attempted a range read"
        }
    }
    set docroot [file join [temporaryDirectory] tclwire-head-[pid]]
    file mkdir $docroot
    ::fileutil::writeFile -translation binary \
        [file join $docroot data.bin] 0123456789
    set application [::tclwire::application_test::MetadataApplication new \
        [dict create docroot $docroot encoding utf-8]]
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method HEAD \
        path /data.bin \
        headers [dict create range bytes=2-5] \
        transaction_id 14]]
    ::tclwire::io begin [::thread::id] $receiver 14
    $application handle_request $request
    ::tclwire::io end
    update
    set event [lindex [lindex $::tclwire::application_test::events 0] 1]
    list \
        [dict get $event type] \
        [dict get $event flags status] \
        [dict get $event flags headers] \
        [llength $::tclwire::application_test::events]
} -cleanup {
    catch {::tclwire::io end}
    catch {$request destroy}
    $receiver destroy
    $application destroy
    ::tclwire::application_test::MetadataApplication destroy
    file delete -force $docroot
} -result [list \
    response \
    200 \
    [list \
        "Accept-Ranges: bytes" \
        "Content-Type: application/octet-stream" \
        "Content-Length: 10"] \
    1]

test application-1.5 {derived applications can serve abstract content ranges} -setup {
    oo::class create ::tclwire::application_test::RangeApplication {
        superclass ::tclwire::CApplication

        method serve_content_ranges {resource ranges} {
            ::tclwire::io response 206 "Partial Content" \
                [list "Content-Type: application/x-generated-ranges"]
            ::tclwire::io out [list content-ranges $ranges]
        }
    }
    set docroot [file join [temporaryDirectory] tclwire-range-hook-[pid]]
    file mkdir $docroot
    ::fileutil::writeFile -translation binary \
        [file join $docroot data.bin] 0123456789
    set application [::tclwire::application_test::RangeApplication new \
        [dict create docroot $docroot encoding utf-8]]
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
} -body {
    set request [::tclwire::HttpRequest new [dict create \
        method GET \
        path /data.bin \
        headers [dict create range bytes=0-1,8-9] \
        transaction_id 16]]
    ::tclwire::io begin [::thread::id] $receiver 16
    $application handle_request $request
    ::tclwire::io complete
    ::tclwire::io end
    update

    set response_event \
        [lindex [lindex $::tclwire::application_test::events 0] 1]
    set output_event \
        [lindex [lindex $::tclwire::application_test::events 1] 1]
    list \
        [dict get $response_event flags headers] \
        [dict get $output_event data]
} -cleanup {
    catch {::tclwire::io end}
    catch {$request destroy}
    $receiver destroy
    $application destroy
    ::tclwire::application_test::RangeApplication destroy
    file delete -force $docroot
} -result [list \
    [list "Content-Type: application/x-generated-ranges"] \
    [list content-ranges {{0 1} {8 9}}]]

test http-errors-1.1 {HTTP errors are loaded from the root JSON catalog} -body {
    set response [::tclwire::http::errors response 503]
    list \
        [dict get $response status] \
        [dict get $response reason] \
        [dict get $response headers] \
        [dict get $response encoding] \
        [string match \
            {*The service is temporarily unavailable. Try again later.*} \
            [dict get $response body]]
} -result [list \
    503 \
    "Service Unavailable" \
    [list "Content-Type: text/html; charset=utf-8"] \
    utf-8 \
    1]

test http-errors-1.2 {error template values are HTML escaped} -body {
    set response [::tclwire::http::errors response 404 \
        [dict create path {/<missing>&}]]
    list \
        [dict get $response reason] \
        [string match {*<code>/&lt;missing&gt;&amp;</code>*} \
            [dict get $response body]]
} -result {{Not Found} 1}

test http-errors-1.3 {unknown statuses use the catalog fallback template} -body {
    set response [::tclwire::http::errors response 599]
    list \
        [dict get $response status] \
        [dict get $response reason] \
        [string match {*<h1>599 Error</h1>*} [dict get $response body]]
} -result {599 {Internal Server Error} 1}

cleanupTests
