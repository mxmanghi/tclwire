            docroot [temporaryDirectory] encoding utf-8 \
            application_paths [list [temporaryDirectory]]]]
    try {
        ::tclwire::cga::cleanup_uploaded_files $configuration \
            [dict create body_storage spooled_file body_path $body_file]
        file exists $body_file
