} -result {constructor failed}

test application-configuration-1.6 {
    application lifecycle hooks run for the worker lifetime
} -setup {
    oo::class create ::tclwire::application_test::LifecycleApplication {
        superclass ::tclwire::CApplication

        method initialize {} {
            lappend ::tclwire::application_test::events \
                [list initialize]
        }

        method handle_request {request} {
            lappend ::tclwire::application_test::events \
                [list handle_request [$request path] [::tclwire::tools::makeurl]]
            ::tclwire::io response 204 "No Content" {}
        }

        method shutdown {} {
            lappend ::tclwire::application_test::events \
                [list shutdown]
        }
    }
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set configuration [::tclwire::ApplicationConfiguration new lifecycle \
        [dict create \
            class ::tclwire::application_test::LifecycleApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]]]]
} -body {
    ::tclwire::cga::initialize app:lifecycle [$configuration serialize]
    ::tclwire::cga::execute \
        [dict create \
            application_id lifecycle \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 92 \
            method GET \
            protocol http \
            headers [dict create host localhost:8990] \
            path /lifecycle]
    ::tclwire::cga::shutdown
    update
    set lifecycle_events {}
    foreach event $::tclwire::application_test::events {
        if {[lindex $event 0] in {initialize handle_request shutdown}} {
            lappend lifecycle_events $event
        } elseif {[lindex $event 0] == 92 &&
                [dict get [lindex $event 1] type] eq "response"} {
            set response_event [lindex $event 1]
        }
    }
    list $lifecycle_events [dict get $response_event type]
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$configuration destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::application_test::LifecycleApplication destroy}
    catch {::tclwire::io end}
} -result [list \
    [list \
        [list initialize] \
        [list handle_request /lifecycle http://localhost:8990/lifecycle] \
        [list shutdown]] \
    response]

test application-configuration-1.6a {
    reload_on_request retires the CGA worker after completing the request
} -setup {
    oo::class create ::tclwire::application_test::ReloadRetireApplication {
        superclass ::tclwire::CApplication

        method handle_request {request} {
            lappend ::tclwire::application_test::events \
                [list handle_request [$request path]]
            ::tclwire::io response 204 "No Content" {}
        }
    }
    set application_file [makeFile {
oo::class create ::tclwire::application_test::ReloadRetireApplication {
    superclass ::tclwire::CApplication

    method handle_request {request} {
        ::tclwire::io response 204 "No Content" {}
    }
}
} reload-retire-application.tcl]
    set worker_id [::thread::id]
    catch {::tclwire::accounting remove_thread $worker_id}
    ::tclwire::accounting register_thread $worker_id idle application
    set receiver [::tclwire::application_test::OutputReceiver new]
    set ::tclwire::application_test::events {}
    set ::tclwire::application_test::tpba_commands {}
    set ::tclwire::application_test::thread_exit_events {}
    rename ::tclwire::tpba::request ::tclwire::tpba::request_reload_retire_saved
    proc ::tclwire::tpba::request {command} {
        lappend ::tclwire::application_test::tpba_commands $command
        return [dict create ok 1 result {}]
    }
    set configuration [::tclwire::ApplicationConfiguration new reload-retire \
        [dict create \
            class ::tclwire::application_test::ReloadRetireApplication \
            file $application_file \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]] \
            reload_on_request 1]]
} -body {
    ::tclwire::cga::initialize app:reload-retire [$configuration serialize]
    ::tclwire::cga::configure_thread_exit_command {
        lappend ::tclwire::application_test::thread_exit_events \
            [list release [::thread::id]]
    }
    ::tclwire::cga::execute \
        [dict create \
            application_id reload-retire \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 93 \
            method GET \
            protocol http \
            headers [dict create host localhost:8990] \
            path /reload-retire]
    update
    list \
        [::tclwire::cga::thread_exit_requested] \
        $::tclwire::application_test::thread_exit_events \
        [lmap command $::tclwire::application_test::tpba_commands {
            dict get $command operation
        }] \
        [lmap event $::tclwire::application_test::events {
            if {[llength $event] == 2 && [lindex $event 0] == 93} {
                dict get [lindex $event 1] type
            } else {
                lindex $event 0
            }
        }]
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$configuration destroy}
    catch {$receiver destroy}
    catch {::tclwire::accounting remove_thread $worker_id}
    catch {::tclwire::application_test::ReloadRetireApplication destroy}
    catch {::tclwire::io end}
    catch {rename ::tclwire::tpba::request {}}
    catch {rename ::tclwire::tpba::request_reload_retire_saved ::tclwire::tpba::request}
    unset -nocomplain ::tclwire::application_test::tpba_commands
    unset -nocomplain ::tclwire::application_test::thread_exit_events
    removeFile $application_file
} -result [list \
    1 \
    [list [list release [::thread::id]]] \
    [list thread_workload_changed remove_worker] \
    [list handle_request response complete]]

test application-configuration-1.7 {
    content generator signals are delegated to the application object
} -setup {
    oo::class create ::tclwire::application_test::SignalApplication {
        superclass ::tclwire::CApplication

        method signal {args} {
            lappend ::tclwire::application_test::events [list signal {*}$args]
            return [llength $args]
        }
    }
    set ::tclwire::application_test::events {}
    set configuration [::tclwire::ApplicationConfiguration new signal \
        [dict create \
            class ::tclwire::application_test::SignalApplication \
            package tclwire::application \
            hosts localhost \
            docroot [temporaryDirectory] \
            encoding utf-8 \
            application_paths [list [temporaryDirectory]]]]
} -body {
    ::tclwire::cga::initialize app:signal [$configuration serialize]
    list \
        [::tclwire::cga::signal reload because config-changed] \
        $::tclwire::application_test::events
} -cleanup {
    catch {::tclwire::cga::shutdown}
    catch {$configuration destroy}
    catch {::tclwire::application_test::SignalApplication destroy}
} -result [list 3 [list [list signal reload because config-changed]]]

test application-dispatcher-1.1 {missing Host selects the default application} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        $dispatcher select_application [dict create headers [dict create]]
    } finally {
        $dispatcher destroy
    }
} -result default

test application-dispatcher-1.2 {configured hosts select the default application} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        list \
            [$dispatcher select_application [dict create \
                headers [dict create host localhost:8990]]] \
            [$dispatcher select_application [dict create \
                headers [dict create host 127.0.0.1]]]
    } finally {
        $dispatcher destroy
    }
} -result {default default}

test application-dispatcher-1.3 {unknown hosts are rejected} -body {
    set dispatcher [::tclwire::ApplicationDispatcher new $application_config]
    try {
        catch {
            $dispatcher select_application [dict create \
                headers [dict create host unknown.example]]
        } message
        set message
    } finally {
        $dispatcher destroy
    }
} -result {no application is configured for Host 'unknown.example'}

