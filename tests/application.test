        [dict create \
            application_id rivet-app \
            connection_thread_id [::thread::id] \
            connection_agent_id $receiver \
            transaction_id 111 \
            method POST \
            target /upload.tcl \
            path /upload.tcl \
            query {} \
            version 1.1 \
            headers [dict create \
                host rivet.example.test \
                content-type {multipart/form-data; boundary=AaB03x}] \
            multipart_parts [list \
                [dict create \
                    name upload \
                    filename one.bin \
                    content_type application/octet-stream \
                    body_storage spooled_file \
