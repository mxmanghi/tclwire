package require tcltest
namespace import ::tcltest::*
package require fileutil

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::logger 0.1

namespace eval ::tclwire::logger_test {
    variable logfile [file join [temporaryDirectory] tclwire-logger-[pid].log]
    variable logerr [file join [temporaryDirectory] tclwire-logger-[pid].err]

    proc cleanup {} {
        variable logfile
        variable logerr
        catch {::tclwire::logger stop}
        catch {file delete -force $logfile}
        catch {file delete -force $logerr}
    }

    proc contents {} {
        variable logfile
        set chan [open $logfile r]
        try {
            return [read $chan]
        } finally {
            close $chan
        }
    }

    proc error_contents {} {
        variable logerr
        set chan [open $logerr r]
        try {
            return [read $chan]
        } finally {
            close $chan
        }
    }
}

::tclwire::logger_test::cleanup

test logger-1.1 {start publishes a live logger endpoint} -body {
    set tid [::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]]
    list \
        [expr {$tid eq [::tsv::get tclwire logger_thread_id]}] \
        [::thread::exists $tid] \
        [::tclwire::logger is_running]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 1 1}

test logger-1.2 {the logger thread owns and writes the configured logfile} -body {
    ::tclwire::logger start \
        [dict create \
            logfile $::tclwire::logger_test::logfile \
            logerr $::tclwire::logger_test::logerr]
    set default_client [::tclwire::logger::Client new default]
    set http_client [::tclwire::logger::Client new http]
    try {
        $default_client write "plain message"
        $http_client log "method=GET status=200"
        $default_client write_error "stderr message"
        $default_client log_error app "uncaught-error"
    } finally {
        $default_client destroy
        $http_client destroy
    }
    ::tclwire::logger stop

    set lines [split [string trim [::tclwire::logger_test::contents]] \n]
    set error_lines [split \
        [string trim [::tclwire::logger_test::error_contents]] \n]
    list \
        [llength $lines] \
        [regexp {^[0-9-]+ [0-9:]+ plain message$} [lindex $lines 0]] \
        [regexp {^[0-9-]+ [0-9:]+ http method=GET status=200$} [lindex $lines 1]] \
        [llength $error_lines] \
        [regexp {^[0-9-]+ [0-9:]+ stderr message$} [lindex $error_lines 0]] \
        [regexp {^[0-9-]+ [0-9:]+ app level=error uncaught-error$} [lindex $error_lines 1]]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {2 1 1 2 1 1}

test logger-1.3 {reset restarts the agent while retaining configuration} -body {
    set first [::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]]
    set client [::tclwire::logger::Client new default]
    $client write before-reset
    $client destroy
    set second [::tclwire::logger reset]
    set reset_is_live [expr {
        $second eq [::tsv::get tclwire logger_thread_id] &&
        [::thread::exists $second]
    }]
    set client [::tclwire::logger::Client new default]
    $client write after-reset
    $client destroy
    ::tclwire::logger stop

    set content [::tclwire::logger_test::contents]
    list \
        $reset_is_live \
        [string match {*before-reset*} $content] \
        [string match {*after-reset*} $content]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 1 1}

test logger-1.4 {starting a second logger is rejected} -body {
    ::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]
    catch {
        ::tclwire::logger start \
            [dict create logfile $::tclwire::logger_test::logfile]
    } message
    set message
} -cleanup {
    ::tclwire::logger_test::cleanup
} -match glob -result {logger thread is already running: *}

test logger-1.5 {stop is idempotent and clears shared discovery state} -body {
    ::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]
    set first [::tclwire::logger stop]
    set second [::tclwire::logger stop]
    list \
        [expr {$first ne {}}] \
        $second \
        [::tsv::exists tclwire logger_thread_id] \
        [::tsv::get tclwire logger_thread_id] \
        [::tclwire::logger is_running]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 {} 1 {} 0}

test logger-1.5a {rotate reopens configured log files} -body {
    ::tclwire::logger start \
        [dict create \
            logfile $::tclwire::logger_test::logfile \
            logerr $::tclwire::logger_test::logerr]
    set client [::tclwire::logger::Client new default]
    $client write before-rotate
    $client write_error error-before-rotate
    file rename -force $::tclwire::logger_test::logfile \
        "$::tclwire::logger_test::logfile.1"
    file rename -force $::tclwire::logger_test::logerr \
        "$::tclwire::logger_test::logerr.1"
    set rotated [::tclwire::logger rotate]
    $client write after-rotate
    $client write_error error-after-rotate
    $client destroy
    ::tclwire::logger stop

    set old_log [::fileutil::cat "$::tclwire::logger_test::logfile.1"]
    set new_log [::tclwire::logger_test::contents]
    set old_err [::fileutil::cat "$::tclwire::logger_test::logerr.1"]
    set new_err [::tclwire::logger_test::error_contents]
    list \
        [dict get $rotated logfile] \
        [dict get $rotated logerr] \
        [string match {*before-rotate*} $old_log] \
        [string match {*after-rotate*} $new_log] \
        [string match {*error-before-rotate*} $old_err] \
        [string match {*error-after-rotate*} $new_err]
} -cleanup {
    catch {file delete -force "$::tclwire::logger_test::logfile.1"}
    catch {file delete -force "$::tclwire::logger_test::logerr.1"}
    ::tclwire::logger_test::cleanup
} -result [list \
    [file normalize $::tclwire::logger_test::logfile] \
    [file normalize $::tclwire::logger_test::logerr] \
    1 1 1 1]

test logger-1.5b {client log mappings route access and error lines} -body {
    set app_log [file join [temporaryDirectory] tclwire-logger-app-[pid].log]
    set app_err [file join [temporaryDirectory] tclwire-logger-app-[pid].err]
    set ftp_log [file join [temporaryDirectory] tclwire-logger-ftp-[pid].log]
    set ftp_err [file join [temporaryDirectory] tclwire-logger-ftp-[pid].err]
    catch {file delete -force $app_log $app_err $ftp_log $ftp_err}
    ::tclwire::logger start \
        [dict create \
            logfile $::tclwire::logger_test::logfile \
            logerr $::tclwire::logger_test::logerr \
            logfiles [dict create \
                default [list $::tclwire::logger_test::logfile \
                              $::tclwire::logger_test::logerr] \
                app [list $app_log $app_err] \
                ftp:2121 [list $ftp_log $ftp_err]]]
    set app_client [::tclwire::logger::Client new app]
    try {
        $app_client log "method=GET status=200"
        $app_client log_error application "failed"
        set ftp_client [::tclwire::logger::Client new ftp:2121]
        set default_client [::tclwire::logger::Client new default]
        try {
            $ftp_client log "command=USER status=331"
            $default_client write global-message
        } finally {
            $ftp_client destroy
            $default_client destroy
        }
    } finally {
        $app_client destroy
        ::tclwire::logger stop
    }
    set result [list \
        [string match {*app method=GET status=200*} [::fileutil::cat $app_log]] \
        [string match {*application level=error failed*} [::fileutil::cat $app_err]] \
        [string match {*ftp:2121 command=USER status=331*} [::fileutil::cat $ftp_log]] \
        [string match {*global-message*} [::tclwire::logger_test::contents]]]
    catch {file delete -force $app_log $app_err $ftp_log $ftp_err}
    set result
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 1 1 1}

test logger-1.5c {host context routes error logs to application logerr} -body {
    set app_err [file join [temporaryDirectory] tclwire-logger-host-app-[pid].err]
    catch {file delete -force $app_err}
    ::tclwire::logger start \
        [dict create \
            logfile $::tclwire::logger_test::logfile \
            logerr $::tclwire::logger_test::logerr \
            logfiles [dict create \
                default [list $::tclwire::logger_test::logfile \
                              $::tclwire::logger_test::logerr] \
                app [list $::tclwire::logger_test::logfile $app_err]] \
            applications [dict create \
                app [dict create hosts app.example]]]
    set logger [::tclwire::logger::Client new \
        [::tclwire::logger::client_for_context [dict create host app.example]]]
    try {
        $logger log_error static_file "status=404" error \
            [dict create host app.example]
    } finally {
        $logger destroy
    }
    ::tclwire::logger stop
    set result [string match {*static_file level=error status=404*} \
        [::fileutil::cat $app_err]]
    catch {file delete -force $app_err}
    set result
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result 1

test logger-1.6 {the client package excludes lifecycle control} -body {
    set child [interp create]
    try {
        $child eval [list lappend auto_path $project_root]
        $child eval {package require tclwire::logger::client 0.1}
        list \
            [$child eval {expr {[info commands ::tclwire::logger::Client] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::write] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::write_error] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::log] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::log_error] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::start] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::stop] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::accounting] ne {}}}]
    } finally {
        interp delete $child
    }
} -result {1 0 0 0 1 0 0 0}

test logger-1.7 {the logger thread loads only agent runtime commands} -body {
    set tid [::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]]
    set commands [::thread::send $tid {
        lsort [lmap command [info commands ::tclwire::logger::*] {
            namespace tail $command
        }]
    }]
    set commands
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {agent_initialize agent_rotate agent_shutdown agent_write agent_write_error agent_write_message client_channel close_log_channels open_log_channels open_one_log_channel timestamp}

test logger-1.7a {admitted log levels match Apache HTTP Server LogLevel names} -body {
    set apache_levels {
        trace8 trace7 trace6 trace5 trace4 trace3 trace2 trace1
        debug info notice warn error crit alert emerg
    }
    set rejected [list]
    foreach level {fatal warning verbose trace trace0 trace9} {
        if {![catch {::tclwire::logger normalize_level $level}]} {
            lappend rejected $level
        }
    }
    list \
        [::tclwire::logger valid_levels] \
        [lmap level $apache_levels {
            ::tclwire::logger normalize_level [string toupper $level]
        }] \
        $rejected
} -result [list \
    {trace8 trace7 trace6 trace5 trace4 trace3 trace2 trace1 debug info notice warn error crit alert emerg} \
    {trace8 trace7 trace6 trace5 trace4 trace3 trace2 trace1 debug info notice warn error crit alert emerg} \
    {}]

test logger-1.8 {configured log levels filter by severity and context} -body {
    set config [dict create \
        logfile $::tclwire::logger_test::logfile \
        logerr $::tclwire::logger_test::logerr \
        log_level error \
        services [list \
            [dict create id http:8990 log_level debug] \
            [dict create id ftp:8991 log_level crit]] \
        applications [dict create \
            default [dict create hosts {localhost 127.0.0.1}] \
            quiet [dict create hosts quiet.example log_level alert]]]
    ::tclwire::logger start $config
    list \
        [::tclwire::logger should_log debug \
            [dict create service_id http:8990]] \
        [::tclwire::logger should_log info \
            [dict create service_id ftp:8991]] \
        [::tclwire::logger should_log error \
            [dict create service_id ftp:8991]] \
        [::tclwire::logger should_log crit \
            [dict create service_id ftp:8991]] \
        [::tclwire::logger should_log crit \
            [dict create service_id http:8990 host quiet.example]] \
        [::tclwire::logger should_log emerg \
            [dict create service_id http:8990 host quiet.example]]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 0 0 1 0 1}

test logger-1.9 {debug connection close logs only at debug threshold} -body {
    set record [::tclwire::accounting new_connection_record \
        connection_key http:8990#7 \
        protocol http \
        service_id http:8990 \
        peer_host 127.0.0.1 \
        status closed \
        close_reason finished \
        bytes_in 10 \
        bytes_out 20]
    ::tclwire::logger start \
        [dict create \
            logfile $::tclwire::logger_test::logfile \
            logerr $::tclwire::logger_test::logerr \
            log_level info]
    set logger [::tclwire::logger::Client new [dict get $record service_id]]
    $logger log_connection_closed $record
    $logger destroy
    ::tclwire::logger stop
    set suppressed [expr {[string trim [::tclwire::logger_test::error_contents]] eq {}}]

    ::tclwire::logger start \
        [dict create \
            logfile $::tclwire::logger_test::logfile \
            logerr $::tclwire::logger_test::logerr \
            log_level debug]
    set logger [::tclwire::logger::Client new [dict get $record service_id]]
    $logger log_connection_closed $record
    $logger destroy
    ::tclwire::logger stop
    set content [::tclwire::logger_test::error_contents]
    list \
        $suppressed \
        [string match {*connection level=debug connection=http:8990#7*} $content] \
        [string match {*reason=finished*} $content]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 1 1}

test logger-1.10 {connection close logs include transport errors} -body {
    set record [::tclwire::accounting new_connection_record \
        connection_key https:9443#10 \
        protocol https \
        service_id https:9443 \
        peer_host 127.0.0.1 \
        status failed \
        close_reason startup_failed \
        transport_error {wrong version number} \
        bytes_in 0 \
        bytes_out 0]
    ::tclwire::logger start \
        [dict create \
            logfile $::tclwire::logger_test::logfile \
            logerr $::tclwire::logger_test::logerr \
            log_level debug]
    set logger [::tclwire::logger::Client new [dict get $record service_id]]
    $logger log_connection_closed $record
    $logger destroy
    ::tclwire::logger stop
    set content [::tclwire::logger_test::error_contents]
    list \
        [string match {*connection=https:9443#10*} $content] \
        [string match {*reason=startup_failed*} $content] \
        [string match {*transport_error=wrong version number*} $content]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 1 1}

::tclwire::logger_test::cleanup
cleanupTests
