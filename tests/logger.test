package require tcltest
namespace import ::tcltest::*

set project_root [file dirname [file dirname [file normalize [info script]]]]
lappend auto_path $project_root

package require tclwire::logger 0.1

namespace eval ::tclwire::logger_test {
    variable logfile [file join [temporaryDirectory] tclwire-logger-[pid].log]

    proc cleanup {} {
        variable logfile
        catch {::tclwire::logger stop}
        catch {file delete -force $logfile}
    }

    proc contents {} {
        variable logfile
        set chan [open $logfile r]
        try {
            return [read $chan]
        } finally {
            close $chan
        }
    }
}

::tclwire::logger_test::cleanup

test logger-1.1 {start publishes a live logger endpoint} -body {
    set tid [::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]]
    list \
        [expr {$tid eq [::tsv::get tclwire logger_thread_id]}] \
        [::thread::exists $tid] \
        [::tclwire::logger is_running]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 1 1}

test logger-1.2 {the logger thread owns and writes the configured logfile} -body {
    ::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]
    ::tclwire::logger write "plain message"
    ::tclwire::logger log http "method=GET status=200"
    ::tclwire::logger stop

    set lines [split [string trim [::tclwire::logger_test::contents]] \n]
    list \
        [llength $lines] \
        [regexp {^[0-9-]+ [0-9:]+ plain message$} [lindex $lines 0]] \
        [regexp {^[0-9-]+ [0-9:]+ http method=GET status=200$} [lindex $lines 1]]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {2 1 1}

test logger-1.3 {reset restarts the agent while retaining configuration} -body {
    set first [::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]]
    ::tclwire::logger write before-reset
    set second [::tclwire::logger reset]
    set reset_is_live [expr {
        $second eq [::tsv::get tclwire logger_thread_id] &&
        [::thread::exists $second]
    }]
    ::tclwire::logger write after-reset
    ::tclwire::logger stop

    set content [::tclwire::logger_test::contents]
    list \
        $reset_is_live \
        [string match {*before-reset*} $content] \
        [string match {*after-reset*} $content]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 1 1}

test logger-1.4 {starting a second logger is rejected} -body {
    ::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]
    catch {
        ::tclwire::logger start \
            [dict create logfile $::tclwire::logger_test::logfile]
    } message
    set message
} -cleanup {
    ::tclwire::logger_test::cleanup
} -match glob -result {logger thread is already running: *}

test logger-1.5 {stop is idempotent and clears shared discovery state} -body {
    ::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]
    set first [::tclwire::logger stop]
    set second [::tclwire::logger stop]
    list \
        [expr {$first ne {}}] \
        $second \
        [::tsv::exists tclwire logger_thread_id] \
        [::tsv::get tclwire logger_thread_id] \
        [::tclwire::logger is_running]
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {1 {} 1 {} 0}

test logger-1.6 {the client package excludes lifecycle control} -body {
    set child [interp create]
    try {
        $child eval [list lappend auto_path $project_root]
        $child eval {package require tclwire::logger::client 0.1}
        list \
            [$child eval {expr {[info commands ::tclwire::logger::write] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::log] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::start] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::logger::stop] ne {}}}] \
            [$child eval {expr {[info commands ::tclwire::accounting] ne {}}}]
    } finally {
        interp delete $child
    }
} -result {1 1 0 0 0}

test logger-1.7 {the logger thread loads only agent runtime commands} -body {
    set tid [::tclwire::logger start \
        [dict create logfile $::tclwire::logger_test::logfile]]
    set commands [::thread::send $tid {
        lsort [lmap command [info commands ::tclwire::logger::*] {
            namespace tail $command
        }]
    }]
    set commands
} -cleanup {
    ::tclwire::logger_test::cleanup
} -result {agent_initialize agent_shutdown agent_write timestamp}

::tclwire::logger_test::cleanup
cleanupTests
